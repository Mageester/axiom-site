{
  "prefetch": [
    {
      "source": "document",
      "where": {
        "and": [
          {
            "or": [
              {
                "href_matches": "/"
              },
              {
                "href_matches": "/about/"
              },
              {
                "href_matches": "/approach/"
              },
              {
                "href_matches": "/contact/"
              },
              {
                "href_matches": "/start-a-project/"
              },
              {
                "href_matches": "/services/"
              },
              {
                "href_matches": "/services/*"
              },
              {
                "href_matches": "/industries/"
              },
              {
                "href_matches": "/industries/*"
              },
              {
                "href_matches": "/web-design/"
              },
              {
                "href_matches": "/web-design/*"
              },
              {
                "href_matches": "/pricing/"
              },
              {
                "href_matches": "/work/"
              }
            ]
          },
          {
            "not": {
              "selector_matches": "[download], [data-no-prefetch]"
            }
          }
        ]
      },
      "eagerness": "moderate"
    }
  ]
}
