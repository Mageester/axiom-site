# Cloudflare Pages _headers
# Applied to all routes. https://developers.cloudflare.com/pages/configuration/headers/

/
  Speculation-Rules: "/speculation-rules.json"
  Content-Type: text/html; charset=utf-8

/about/
  Speculation-Rules: "/speculation-rules.json"
  Content-Type: text/html; charset=utf-8

/pricing/
  Speculation-Rules: "/speculation-rules.json"
  Content-Type: text/html; charset=utf-8

/work/
  Speculation-Rules: "/speculation-rules.json"
  Content-Type: text/html; charset=utf-8

/services/
  Speculation-Rules: "/speculation-rules.json"
  Content-Type: text/html; charset=utf-8

/services/*
  Speculation-Rules: "/speculation-rules.json"
  Content-Type: text/html; charset=utf-8

/approach/
  Speculation-Rules: "/speculation-rules.json"
  Content-Type: text/html; charset=utf-8

/process
  X-Robots-Tag: noindex, follow

/start
  X-Robots-Tag: noindex, follow

/start-a-project/
  Speculation-Rules: "/speculation-rules.json"
  Content-Type: text/html; charset=utf-8

