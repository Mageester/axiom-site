  Content-Type: text/html; charset=utf-8

/admin/audit
  X-Robots-Tag: noindex, nofollow

/admin/*
  X-Robots-Tag: noindex, nofollow

/privacy/
  Content-Type: text/html; charset=utf-8

/terms/
  Speculation-Rules: "/speculation-rules.json"
  Content-Type: text/html; charset=utf-8

/404
  X-Robots-Tag: noindex, nofollow
  Content-Type: text/html; charset=utf-8

/account
  X-Robots-Tag: noindex, nofollow

/dashboard
  X-Robots-Tag: noindex, nofollow

/hunt
  X-Robots-Tag: noindex, nofollow

/vault
  X-Robots-Tag: noindex, nofollow

/triage
  X-Robots-Tag: noindex, nofollow

/settings
  X-Robots-Tag: noindex, nofollow

/lead/*
  X-Robots-Tag: noindex, nofollow

/jobs
  X-Robots-Tag: noindex, nofollow

/campaigns
  X-Robots-Tag: noindex, nofollow

/leads
  X-Robots-Tag: noindex, nofollow

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), browsing-topics=()
  # Allow the site's own inline scripts while keeping external scripts restricted to self.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' https://cloudflareinsights.com https://static.cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; script-src-attr 'none'; upgrade-insecure-requests

/api/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: no-store, no-cache, must-revalidate

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=2592000

/images/*
  Cache-Control: public, max-age=2592000

/photos/*
  Cache-Control: public, max-age=2592000

/film/*
  Cache-Control: public, max-age=2592000

/favicon.png
  Cache-Control: public, max-age=604800

/favicon-32x32.png
  Cache-Control: public, max-age=604800

/favicon-48x48.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/speculation-rules.json
  Content-Type: application/speculationrules+json
  Cache-Control: public, max-age=3600

/web-design/*
  Speculation-Rules: "/speculation-rules.json"

/admin-shell
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/admin-shell/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/404.html
  X-Robots-Tag: noindex, nofollow

/404/
  X-Robots-Tag: noindex, nofollow

/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400

/axiomtransparentlogo.webp
  Cache-Control: public, max-age=2592000

/og-image.png
  Cache-Control: public, max-age=604800

/social/*
  Cache-Control: public, max-age=604800
