---
import CtaBand from '../components/site/CtaBand.astro';
import FaqList from '../components/site/FaqList.astro';
import Icon from '../components/site/Icon.astro';
import PageHero from '../components/site/PageHero.astro';
import PricingCards from '../components/site/PricingCards.astro';
import { comparisonRows, packages, paymentTerms, pricingFaq, standardIncludes } from '../content/pricing';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SEO_ROUTES, SITE_URL, faqJsonLd, toCanonicalUrl, type Crumb } from '../lib/seo';

const crumbs: Crumb[] = [
  { name: 'Home', url: '/' },
  { name: 'Pricing', url: '/pricing/' },
];

const pricingSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${toCanonicalUrl('/pricing')}#service`,
  name: 'Website design and development packages',
  serviceType: 'Web design and development',
  provider: { '@id': `${SITE_URL}/#organization` },
  url: toCanonicalUrl('/pricing'),
  offers: packages.map((pkg) => ({
    '@type': 'Offer',
    name: pkg.name,
    description: `${pkg.scope}. ${pkg.summary}`,
    url: `${toCanonicalUrl('/pricing')}#${pkg.key}`,
    ...(pkg.priceValue
      ? { priceSpecification: { '@type': 'PriceSpecification', minPrice: pkg.priceValue, priceCurrency: 'CAD' } }
      : {}),
  })),
};
---

<BaseLayout {...SEO_ROUTES.pricing} crumbs={crumbs} schema={[pricingSchema, faqJsonLd(pricingFaq)]}>
  <main id="main-content" tabindex="-1">
    <PageHero
      eyebrow="Pricing"
      title="Simple, published website pricing"
      lead="Four packages, with prices on the page. Your exact price is confirmed in a written scope before any work begins, and it doesn’t change unless the scope does."
      crumbs={crumbs}
    />

    <section class="section pricing-cards" aria-labelledby="packages-title">
      <div class="container">
        <h2 id="packages-title" class="sr-only">Website packages</h2>
        <PricingCards packages={packages} />
        <p class="pricing-footnote">
          All prices are in Canadian dollars. The Local Launch Special is an introductory package with a restricted scope; projects needing more pages or custom functionality use another package.
        </p>
      </div>
    </section>

    <section class="section section-soft" aria-labelledby="included-title">
      <div class="container included-grid">
        <div class="section-head">
          <p class="eyebrow">Every standard package</p>
          <h2 id="included-title">What’s included</h2>
          <p>The package price covers the full delivery standard, from scope to launch. The Local Launch Special follows the same standard within its one-page scope.</p>
        </div>
        <div class="included-card">
          <ul role="list" class="check-list cols-2">
            {standardIncludes.map((item) => <li>{item}</li>)}
          </ul>
          <p class="included-note">
            Booksy and other booking platforms remain your account and expense. Your domain, accounts and supplied assets stay yours.
          </p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="compare-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Compare</p>
          <h2 id="compare-title">Compare packages side by side</h2>
          <p>The same quality standard applies throughout. The differences are page scope and whether the project needs custom systems.</p>
        </div>
        <div class="table-wrap" role="region" aria-label="Package comparison table, scrollable" tabindex="0">
          <table class="compare-table">
            <thead>
              <tr>
                <th scope="col"><span class="sr-only">Feature</span></th>
                {packages.map((pkg) => (
                  <th scope="col" class:list={{ featured: pkg.featured }}>
                    {pkg.featured && <span class="badge badge-brand">Recommended</span>}
                    <span class="th-name">{pkg.name}</span>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {comparisonRows.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  {packages.map((pkg) => <td class:list={{ featured: pkg.featured }}>{row.values[pkg.key]}</td>)}
                </tr>
              ))}
              <tr class="table-actions">
                <th scope="row"><span class="sr-only">Get started</span></th>
                {packages.map((pkg) => (
                  <td class:list={{ featured: pkg.featured }}>
                    <a href={pkg.href} class:list={['btn', 'btn-sm', pkg.featured ? '' : 'btn-secondary']}>
                      Choose <span class="sr-only">{pkg.name}</span>
                    </a>
                  </td>
                ))}
              </tr>
            </tbody>
          </table>
        </div>
        <p class="table-hint" aria-hidden="true"><Icon name="arrow-right" size={14} /> Scroll sideways to compare all packages</p>
      </div>
    </section>

    <section class="section section-soft" aria-labelledby="payment-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Payments</p>
          <h2 id="payment-title">How payment works</h2>
          <p>Two payments tied to clear milestones, then simple annual hosting. No hourly billing.</p>
        </div>
        <ol role="list" class="grid grid-3 terms">
          {paymentTerms.map((term, index) => (
            <li class="card term">
              <span class="term-num" aria-hidden="true">{index + 1}</span>
              <h3>{term.title}</h3>
              <p>{term.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section" aria-labelledby="faq-title">
      <div class="container faq-grid">
        <div class="section-head">
          <p class="eyebrow">FAQ</p>
          <h2 id="faq-title">Pricing questions</h2>
          <p>Can’t find your answer? Call or email us and we’ll explain how your project would be priced.</p>
        </div>
        <FaqList items={pricingFaq} />
      </div>
    </section>

    <CtaBand
      title="Not sure which package fits?"
      text="Send a few details about your business. We’ll recommend the right package and confirm the price within one business day."
    />
  </main>
</BaseLayout>

<style>
  .pricing-cards {
    padding-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .pricing-footnote {
    max-width: 60rem;
    margin-top: 1.5rem;
    color: var(--text-muted);
    font-size: var(--fs-xs);
  }

  .included-grid,
  .faq-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .included-grid,
    .faq-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
      gap: 5rem;
      align-items: start;
    }
  }

  .included-grid .section-head,
  .faq-grid .section-head {
    margin-bottom: 0;
  }

  .included-card {
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    box-shadow: var(--shadow-md);
  }

  .included-note {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .table-wrap {
    position: relative;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-xs);
  }

  .table-wrap:focus-visible {
    outline-offset: 2px;
  }

  .compare-table {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }

  .compare-table th,
  .compare-table td {
    padding: 1rem 1.15rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .compare-table thead th {
    vertical-align: bottom;
    background: var(--bg-soft);
    color: var(--ink);
    font-weight: 650;
  }

  .compare-table thead .badge {
    margin-bottom: 0.5rem;
  }

  .th-name {
    display: block;
  }

  .compare-table tbody th {
    position: sticky;
    left: 0;
    z-index: 1;
    width: 11rem;
    background: var(--surface);
    color: var(--ink);
    font-weight: 600;
  }

  .compare-table td {
    color: var(--text);
  }

  .compare-table .featured {
    background: rgb(64 108 255 / 0.07);
    box-shadow: inset 1px 0 0 var(--brand-line), inset -1px 0 0 var(--brand-line);
  }

  .compare-table thead .featured {
    background: rgb(64 108 255 / 0.16);
  }

  .compare-table tbody tr:last-child th,
  .compare-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .table-hint {
    display: none;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
    color: var(--text-muted);
    font-size: var(--fs-xs);
  }

  @media (max-width: 860px) {
    .table-hint {
      display: flex;
    }
  }

  .terms {
    margin: 0;
  }

  .term {
    gap: 0.6rem;
  }

  .term-num {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-bottom: 0.4rem;
    border-radius: 999px;
    background: var(--brand-soft);
    color: var(--accent);
    font-weight: 700;
  }

  .term p {
    color: var(--text);
    font-size: var(--fs-sm);
  }
</style>
