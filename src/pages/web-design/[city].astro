---
import CtaBand from '../../components/site/CtaBand.astro';
import FaqList from '../../components/site/FaqList.astro';
import Icon from '../../components/site/Icon.astro';
import LinkCard from '../../components/site/LinkCard.astro';
import PageHero from '../../components/site/PageHero.astro';
import PricingCards from '../../components/site/PricingCards.astro';
import { cities, type City } from '../../content/cities';
import { packages } from '../../content/pricing';
import { services } from '../../content/services';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CTA_PATHS } from '../../lib/cta';
import { SITE_URL, faqJsonLd, toCanonicalUrl, type Crumb } from '../../lib/seo';

export function getStaticPaths() {
  return cities.map((city) => ({ params: { city: city.slug }, props: { city } }));
}

const { city } = Astro.props as { city: City };
const path = `/web-design/${city.slug}/`;
const canonical = toCanonicalUrl(path);

const crumbs: Crumb[] = [
  { name: 'Home', url: '/' },
  { name: 'Service areas', url: '/web-design/' },
  { name: `Web design in ${city.name}`, url: path },
];

const faqs = [
  ...city.questions.map((item) => ({ question: item.q, answer: item.a })),
  {
    question: `How much does a website cost for a ${city.name} business?`,
    answer:
      'The Local Launch Special starts at CAD $900 for one page with up to six sections. The Local Business Website starts at CAD $1,200 for up to three pages, and the Expanded Website starts at CAD $1,500 for up to five. Custom functionality and substantial migrations are quoted separately.',
  },
  {
    question: 'How are launch dates and ownership handled?',
    answer:
      'The project scope confirms timing, content responsibilities, hosting and any handoff before work begins. Your domain and client-supplied content remain yours. Standard packages include two consolidated revision rounds and thirty days of post-launch defect support.',
  },
];

const localService = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonical}#service`,
  name: `Web design in ${city.name}`,
  serviceType: 'Web design',
  url: canonical,
  description: city.description,
  provider: { '@id': `${SITE_URL}/#organization` },
  areaServed: {
    '@type': 'City',
    name: city.name,
    containedInPlace: { '@type': 'AdministrativeArea', name: 'Ontario, Canada' },
  },
};

const otherCities = cities.filter((item) => item.slug !== city.slug);
const metaTitle = `Web Design ${city.name}, Ontario`;
---

<BaseLayout title={metaTitle} description={city.description} canonicalPath={path} crumbs={crumbs} schema={[localService, faqJsonLd(faqs)]}>
  <main id="main-content" tabindex="-1">
    <PageHero eyebrow={`Web design · ${city.region}`} title={`Web design in ${city.name}`} lead={city.intro} crumbs={crumbs}>
      <Fragment slot="actions">
        <a href={CTA_PATHS.startProject} class="btn btn-lg">Start a project <Icon name="arrow-right" /></a>
        <a href="/pricing/" class="btn btn-secondary btn-lg">See pricing</a>
      </Fragment>
      <aside slot="aside" class="card local-card" aria-label={`Working with ${city.name} businesses`}>
        <p class="local-focus">{city.focus}</p>
        <p class="local-context">{city.localContext}</p>
        <div>
          <p class="local-label">Areas we serve in and around {city.name}</p>
          <ul role="list" class="chips">
            {city.neighborhoods.map((area) => <li>{area}</li>)}
          </ul>
        </div>
      </aside>
    </PageHero>

    <section class="section" aria-labelledby="planning-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Planning guidance</p>
          <h2 id="planning-title">Planning a website for a {city.name} business</h2>
          <p>Practical decisions to make before design starts, so the site answers the questions your customers actually ask.</p>
        </div>
        <ol role="list" class="grid grid-3 planning">
          {city.planning.map((item, index) => (
            <li class="card plan">
              <span class="plan-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section section-soft" aria-labelledby="services-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Services</p>
          <h2 id="services-title">What we build for {city.name} businesses</h2>
        </div>
        <div class="grid grid-3 reveal-stagger">
          {services.map((service) => (
            <LinkCard href={`/services/${service.slug}/`} title={service.name} text={service.cardSummary} />
          ))}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="pricing-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Pricing</p>
          <h2 id="pricing-title">Published prices for {city.name} projects</h2>
          <p>The same packages apply wherever you are. The scope and price are confirmed in writing before work begins.</p>
        </div>
        <PricingCards packages={packages} compact />
      </div>
    </section>

    <section class="section section-soft" aria-labelledby="faq-title">
      <div class="container faq-grid">
        <div class="section-head">
          <p class="eyebrow">FAQ</p>
          <h2 id="faq-title">Questions from {city.name} businesses</h2>
        </div>
        <FaqList items={faqs} />
      </div>
    </section>

    <section class="section-sm" aria-labelledby="areas-title">
      <div class="container">
        <h2 id="areas-title" class="areas-title">Other areas we serve</h2>
        <ul role="list" class="area-links">
          {otherCities.map((item) => (
            <li><a href={`/web-design/${item.slug}/`}>Web design in {item.name} <Icon name="arrow-right" size={16} /></a></li>
          ))}
          <li><a href="/web-design/">All service areas <Icon name="arrow-right" size={16} /></a></li>
        </ul>
      </div>
    </section>

    <CtaBand title={`Planning a website in ${city.name}?`} />
  </main>
</BaseLayout>

<style>
  .local-card {
    gap: 1.1rem;
    box-shadow: var(--shadow-md);
  }

  .local-focus {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: var(--ink);
    font-weight: 650;
    line-height: 1.35;
  }

  .local-context {
    color: var(--text);
    font-size: var(--fs-sm);
  }

  .local-label {
    margin-bottom: 0.6rem;
    color: var(--text-muted);
    font-size: var(--fs-xs);
    font-weight: 600;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
  }

  .chips li {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-soft);
    color: var(--ink-2);
    font-size: var(--fs-xs);
    font-weight: 500;
  }

  .planning {
    margin: 0;
  }

  .plan {
    gap: 0.65rem;
  }

  .plan-num {
    color: var(--brand-ink);
    font-size: var(--fs-sm);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .plan p {
    color: var(--text);
    font-size: var(--fs-sm);
  }

  .faq-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .faq-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
      gap: 5rem;
      align-items: start;
    }
  }

  .faq-grid .section-head {
    margin-bottom: 0;
  }

  .areas-title {
    margin-bottom: 1.25rem;
    font-size: clamp(1.35rem, 1.2rem + 0.6vw, 1.6rem);
  }

  .area-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
  }

  .area-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink-2);
    font-size: var(--fs-sm);
    font-weight: 600;
    transition: border-color 160ms var(--ease), color 160ms var(--ease);
  }

  .area-links a:hover {
    border-color: var(--brand-line);
    color: var(--brand-ink);
  }

  .area-links :global(svg) {
    color: var(--brand-ink);
  }
</style>
