---
import CtaBand from '../../components/site/CtaBand.astro';
import Icon from '../../components/site/Icon.astro';
import LinkCard from '../../components/site/LinkCard.astro';
import PageHero from '../../components/site/PageHero.astro';
import { cities } from '../../content/cities';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CTA_PATHS } from '../../lib/cta';
import { SEO_ROUTES, type Crumb } from '../../lib/seo';

const crumbs: Crumb[] = [
  { name: 'Home', url: '/' },
  { name: 'Service areas', url: '/web-design/' },
];
---

<BaseLayout {...SEO_ROUTES.webDesign} pageType="CollectionPage" crumbs={crumbs}>
  <main id="main-content" tabindex="-1">
    <PageHero
      eyebrow="Service areas"
      title="Web design from Kitchener-Waterloo"
      lead="Axiom Web is a two-founder studio serving businesses in Waterloo Region, Guelph and Hamilton, and clients across Canada remotely. We work directly with owners to clarify the offer, organise the content and make the next inquiry easier."
      crumbs={crumbs}
    >
      <Fragment slot="actions">
        <a href={CTA_PATHS.startProject} class="btn btn-lg">Start a project <Icon name="arrow-right" /></a>
      </Fragment>
    </PageHero>

    <section class="section" aria-labelledby="areas-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Where we work</p>
          <h2 id="areas-title">Plan for the customers you serve</h2>
          <p>Each page covers practical website decisions for that area. They describe where we offer our services; our base is Kitchener-Waterloo and we do not present other offices.</p>
        </div>
        <div class="grid grid-3 reveal-stagger">
          {cities.map((city) => (
            <LinkCard
              href={`/web-design/${city.slug}/`}
              title={`Web design in ${city.name}`}
              meta={city.region}
              text={city.focus}
              linkLabel={`Plan a ${city.name} website`}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="section section-soft" aria-labelledby="scope-title">
      <div class="container-narrow prose scope">
        <h2 id="scope-title">Define the scope before the design</h2>
        <p>
          A focused <a href="/services/local-business-websites/">local business website</a> starts at CAD $1,200 for up to three pages.
          An <a href="/pricing/">expanded five-page site</a> starts at CAD $1,500, and a one-page Local Launch Special starts at CAD $900.
          Existing-site migrations and custom functionality are scoped separately.
        </p>
        <p>
          Review <a href="/work/">our work</a> to assess our design approach, then read
          <a href="/approach/">how a project moves from scope to launch</a>. Concept builds demonstrate design direction and are not client results.
        </p>
      </div>
    </section>

    <CtaBand />
  </main>
</BaseLayout>

<style>
  .scope h2 {
    margin-top: 0;
  }
</style>
