---
import CtaBand from '../../components/site/CtaBand.astro';
import FaqList from '../../components/site/FaqList.astro';
import Icon from '../../components/site/Icon.astro';
import LinkCard from '../../components/site/LinkCard.astro';
import PageHero from '../../components/site/PageHero.astro';
import ProcessSteps from '../../components/site/ProcessSteps.astro';
import WorkCard from '../../components/site/WorkCard.astro';
import { processSteps } from '../../content/process';
import { services, type Service, type ServiceSlug } from '../../content/services';
import { getProject } from '../../content/work';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createStartProjectHref } from '../../lib/cta';
import { faqJsonLd, serviceSchema, type Crumb } from '../../lib/seo';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props as { service: Service };

const relatedWork: Record<ServiceSlug, string[]> = {
  'local-business-websites': ['reids-home-and-yard', 'landscaping', 'salon-nails'],
  'conversion-sites': ['roofing', 'physio-clinic', 'restaurant-reservation'],
  rebuilds: ['dental-aurelia', 'law-harrow', 'barber-blackline'],
};
const work = relatedWork[service.slug].map((id) => getProject(id)!);
const others = services.filter((item) => item.slug !== service.slug);
const path = `/services/${service.slug}/`;

const crumbs: Crumb[] = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services/' },
  { name: service.name, url: path },
];
---

<BaseLayout
  title={service.metaTitle}
  description={service.metaDescription}
  canonicalPath={path}
  crumbs={crumbs}
  schema={[
    serviceSchema({ name: service.name, description: service.metaDescription, path, audience: 'Local businesses' }),
    faqJsonLd(service.faqs),
  ]}
>
  <main id="main-content" tabindex="-1">
    <PageHero eyebrow="Services" title={service.title} lead={service.intro} crumbs={crumbs}>
      <Fragment slot="actions">
        <a href={createStartProjectHref(service.pathIntent)} class="btn btn-lg">Start this project <Icon name="arrow-right" /></a>
        <a href="/pricing/" class="btn btn-secondary btn-lg">See pricing</a>
      </Fragment>
      <aside slot="aside" class="card glance" aria-label="At a glance">
        <p class="label glance-title">At a glance</p>
        <dl>
          <div>
            <dt>Packages from</dt>
            <dd>CAD $900</dd>
          </div>
          <div>
            <dt>Typical timeline</dt>
            <dd>2–4 weeks</dd>
          </div>
          <div>
            <dt>Hosting</dt>
            <dd>First year included</dd>
          </div>
          <div>
            <dt>Support</dt>
            <dd>30 days after launch</dd>
          </div>
        </dl>
        <p class="glance-note">{service.packageNote}</p>
      </aside>
    </PageHero>

    <section class="section" aria-labelledby="fit-title">
      <div class="container fit-grid">
        <div>
          <p class="eyebrow">Is this right for you?</p>
          <h2 id="fit-title">Signs you need this</h2>
          <ul role="list" class="check-list fit-list">
            {service.signs.map((sign) => <li>{sign}</li>)}
          </ul>
        </div>
        <div class="compare">
          <div class="compare-col compare-before">
            <p class="compare-label">Before</p>
            <p>{service.before}</p>
          </div>
          <div class="compare-col compare-after">
            <p class="compare-label">After</p>
            <p>{service.after}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-soft" aria-labelledby="includes-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">What’s included</p>
          <h2 id="includes-title">What we deliver</h2>
          <p>Every project also includes responsive design and development, first-year hosting, domain connection, launch testing, two revision rounds and thirty days of support.</p>
        </div>
        <ul role="list" class="grid grid-3 deliverables">
          {service.includes.map((item) => (
            <li class="card deliverable">
              <span class="deliverable-check" aria-hidden="true"><Icon name="check" size={18} strokeWidth={2.4} /></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="process-title">
      <div class="container">
        <div class="section-head-row">
          <div class="section-head">
            <p class="eyebrow">How it works</p>
            <h2 id="process-title">How the project runs</h2>
          </div>
          <a href="/approach/" class="arrow-link">See the full process <Icon name="arrow-right" /></a>
        </div>
        <ProcessSteps steps={processSteps} />
      </div>
    </section>

    <section class="section section-soft" aria-labelledby="work-title">
      <div class="container">
        <div class="section-head-row">
          <div class="section-head">
            <p class="eyebrow">Examples</p>
            <h2 id="work-title">Related work</h2>
          </div>
          <a href="/work/" class="arrow-link">View all work <Icon name="arrow-right" /></a>
        </div>
        <div class="grid grid-3 reveal-stagger">
          {work.map((project) => <WorkCard project={project} />)}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="faq-title">
      <div class="container faq-grid">
        <div class="section-head">
          <p class="eyebrow">FAQ</p>
          <h2 id="faq-title">Questions about {service.name.toLowerCase()}</h2>
        </div>
        <FaqList items={service.faqs} />
      </div>
    </section>

    <section class="section-sm section-soft" aria-labelledby="other-title">
      <div class="container">
        <h2 id="other-title" class="other-title">Other services</h2>
        <div class="grid grid-2 reveal-stagger">
          {others.map((item) => (
            <LinkCard href={`/services/${item.slug}/`} title={item.name} text={item.cardSummary} />
          ))}
        </div>
      </div>
    </section>

    <CtaBand
      title="Let’s talk about your website"
      text={`Tell us about your business and current site. We reply within one business day with a recommendation, a clear price and the next step.`}
      primaryHref={createStartProjectHref(service.pathIntent)}
      primaryLabel="Start this project"
    />
  </main>
</BaseLayout>

<style>
  .glance {
    gap: 1.25rem;
    box-shadow: var(--shadow-md);
  }

  .glance-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink);
    font-weight: 650;
  }

  .glance dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
  }

  .glance dl > div {
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    background: var(--bg-soft);
    border: 1px solid var(--line);
  }

  .glance dt {
    color: var(--text-muted);
    font-size: var(--fs-xs);
    font-weight: 500;
  }

  .glance dd {
    margin: 0.15rem 0 0;
    color: var(--ink);
    font-weight: 650;
  }

  .glance-note {
    color: var(--text);
    font-size: var(--fs-sm);
  }

  .fit-grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .fit-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 5rem;
      align-items: center;
    }
  }

  .fit-grid h2 {
    margin-top: 0.75rem;
  }

  .fit-list {
    margin-top: 1.75rem;
    font-size: 1.0625rem;
  }

  .compare {
    display: grid;
    gap: 1rem;
  }

  .compare-col {
    padding: 1.5rem 1.75rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
  }

  .compare-before {
    background: var(--bg-soft);
  }

  .compare-after {
    border-color: var(--brand-line);
    background: var(--brand-soft);
  }

  .compare-label {
    margin-bottom: 0.4rem;
    color: var(--text-muted);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .compare-after .compare-label {
    color: var(--brand-ink);
  }

  .compare-col p:last-child {
    color: var(--ink);
    font-size: 1.0625rem;
    font-weight: 500;
  }

  .deliverables {
    margin: 0;
  }

  .deliverable {
    flex-direction: row;
    align-items: center;
    gap: 0.9rem;
    padding: 1.25rem 1.4rem;
    color: var(--ink);
    font-weight: 500;
  }

  .deliverable-check {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    flex: none;
    border-radius: var(--radius);
    border: 1px solid var(--line-strong);
    color: var(--ink);
  }

  .faq-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .faq-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
      gap: 5rem;
      align-items: start;
    }
  }

  .faq-grid .section-head {
    margin-bottom: 0;
  }

  .other-title {
    margin-bottom: 1.5rem;
    font-size: clamp(1.35rem, 1.2rem + 0.6vw, 1.6rem);
  }
</style>
