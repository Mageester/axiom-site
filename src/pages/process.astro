---
import SiteLayout from '../layouts/SiteLayout.astro';
import { CTA_PATHS } from '../lib/cta';
import { FadeIn } from '../components/ui/FadeIn';
import { SEO_ROUTES, PROCESS_JSON_LD, breadcrumbSchema, SITE_URL } from '../lib/seo';
import { Card } from '../components/ui/card';
import { Eyebrow } from '../components/ui/Eyebrow';
import DrawIcon from '../components/ui/DrawIcon.astro';
import { MotionHeading } from '../components/motion/MotionHeading';
import { SectionDivider } from '../components/motion/SectionDivider';

const processSteps = [
  {
    dayLabel: 'Week 1',
    title: 'Review',
    timelineDescription:
      "We audit the current site, the offer, and the points where you're losing trust. Then we decide what has to change first.",
    bullets: [] as const,
    icon: 'search',
  },
  {
    dayLabel: 'Week 2',
    title: 'Scope',
    timelineDescription:
      'We confirm the pages, contact paths, and priorities before design starts. Decisions happen here, not mid-build.',
    bullets: [] as const,
    icon: 'document',
  },
  {
    dayLabel: 'Weeks 2-3',
    title: 'Build',
    timelineDescription:
      'We design, write, and test the full site. Layout and flow stay simple enough to ship clean.',
    bullets: [] as const,
    icon: 'code',
  },
  {
    dayLabel: 'Weeks 3-4',
    title: 'Launch',
    timelineDescription:
      'We run launch checks, connect the domain, and hand over a live site. Monthly clients keep support from here on.',
    bullets: [] as const,
    icon: 'arrow-up',
  },
] as const;

const timelineSteps = processSteps.map((step) => ({
  kicker: step.dayLabel,
  title: step.title,
  description: step.timelineDescription,
}));

const launchChecklist = [
  { title: 'Pages to build', detail: 'Which pages matter most right now.' },
  { title: 'Photos and reviews', detail: 'Past work, customer reviews, and anything worth showing early.' },
  { title: 'Quote and contact paths', detail: 'Where each button and form should go.' },
  { title: 'Domain and redirects', detail: 'Technical handoff so nothing breaks at launch.' },
] as const;
---

<SiteLayout
  title={SEO_ROUTES.process.title}
  description={SEO_ROUTES.process.description}
  canonicalPath="/process"
  schema={[PROCESS_JSON_LD, breadcrumbSchema([{ name: 'Home', url: SITE_URL }, { name: 'Process', url: `${SITE_URL}/process` }])]}
>
  <main id="main-content" tabindex="-1" class="pb-0">
    <section class="axiom-container pt-20 md:pt-28">
      <div class="max-w-3xl">
        <FadeIn motion="eyebrow">
          <Eyebrow>PROCESS</Eyebrow>
          <SectionDivider className="mt-6" />
        </FadeIn>
        <FadeIn motion="sceneOpen" delay={180}>
          <MotionHeading as="h1" text="A clear path from first review to launch." className="mt-4" />
        </FadeIn>
        <FadeIn motion="editorialMaskReveal" delay={500}>
          <p class="section-copy mt-5 md:text-[17px]">
            Most standard sites move from first review to launch in two to four weeks. Monthly clients keep support after the site goes live.
          </p>
        </FadeIn>
        <FadeIn motion="sceneOpen" delay={720}>
          <div class="mt-7 flex flex-col gap-4 sm:flex-row sm:items-center">
            <a href={CTA_PATHS.startProject} class="btn btn-primary btn-lg w-full justify-center sm:w-auto">Start a project</a>
            <a href="/work" class="btn-ghost-link">See concept builds</a>
          </div>
        </FadeIn>
      </div>
    </section>

    <div aria-hidden="true" class="section-glow section-glow-offset-top" />

    <section class="page-section section-shell">
      <div class="axiom-container">
        <h2 class="sr-only">Process timeline</h2>
        <ol class="process-timeline">
          {timelineSteps.map((step, index) => (
            <li class="process-step reveal" style={`--reveal-delay: ${index * 90}ms`}>
              <span class="process-step-num">{`0${index + 1}`}</span>
              <span class="process-step-kicker">{step.kicker}</span>
              <h3 class="process-step-title">{step.title}</h3>
              <p class="process-step-desc">{step.description}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <div aria-hidden="true" class="section-glow section-glow-offset-top" />

    <section class="page-section section-shell">
      <div class="axiom-container">
        <FadeIn motion="editorialMaskReveal" className="max-w-3xl">
          <Eyebrow>WHAT WE NEED FROM YOU</Eyebrow>
          <SectionDivider className="mt-6" />
          <MotionHeading as="h2" text="Four things from you. That's it." className="section-heading mt-4" />
        </FadeIn>

        <div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          {launchChecklist.map((item, index) => (
            <FadeIn motion="timelineSequence" delay={index * 150} distance={16} as="div">
              <div class="premium-card h-full rounded-[var(--radius-card)] border border-[color:var(--hairline)] bg-[var(--surface-1)] p-5 sm:p-6">
                <p class="flex items-center gap-2 text-[15px] font-semibold tracking-[-0.01em] text-[var(--text-primary)]">
                  <DrawIcon name="check" size={14} className="text-[var(--accent-solid)]" />
                  {item.title}
                </p>
                <p class="section-copy mt-3 text-[15px]">
                  {item.detail}
                </p>
              </div>
            </FadeIn>
          ))}
        </div>
      </div>
    </section>

    <div aria-hidden="true" class="section-glow section-glow-offset-top" />

    <section class="page-section-tight section-shell">
      <div class="axiom-container grid gap-6 lg:grid-cols-2">
        <FadeIn as="div" motion="finalFrameFooter" direction="left">
          <Card className="h-full p-0">
            <div class="h-full px-6 py-8 sm:px-8 sm:py-10 md:px-10 md:py-12">
              <Eyebrow>AFTER LAUNCH</Eyebrow>
              <SectionDivider className="mt-6" />
              <MotionHeading as="h2" text="Monthly clients stay supported." className="section-heading mt-4" />
              <p class="section-copy mt-4">
                Monthly clients keep edits, refinements, bug fixes, and priority support. Ownership clients get a clean
                handoff and can add ongoing support separately.
              </p>
            </div>
          </Card>
        </FadeIn>

        <FadeIn as="div" motion="finalFrameFooter" direction="right">
          <Card className="h-full p-0">
            <div class="h-full px-6 py-8 sm:px-8 sm:py-10 md:px-10 md:py-12">
              <Eyebrow>BEFORE WE SHIP</Eyebrow>
              <SectionDivider className="mt-6" />
              <MotionHeading as="h2" text="Your site should be winning you work, not losing it." className="section-heading mt-4" />
              <p class="section-copy mt-4">
                Every build is checked for speed, mobile quality, and clear calls to action before it goes live. That's the baseline, not a bonus.
              </p>
              <div class="mt-7 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                <a href={CTA_PATHS.startProject} class="btn btn-primary">Start a project</a>
                <p class="axiom-metric text-[var(--text-muted)]">Review &rarr; Scope &rarr; Build &rarr; Launch</p>
              </div>
            </div>
          </Card>
        </FadeIn>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .process-timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 860px) {
    .process-timeline {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .process-step {
    position: relative;
    padding-top: 2rem;
    padding-right: clamp(1rem, 2vw, 2rem);
    border-top: 1px solid var(--hairline-strong);
  }

  .process-step::before {
    content: '';
    position: absolute;
    top: -4px;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--text-primary);
  }

  @media (max-width: 859px) {
    .process-step {
      padding-top: 1.6rem;
      padding-bottom: 1.6rem;
    }
    .process-step + .process-step {
      border-top: 1px solid var(--hairline);
    }
  }

  .process-step-num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .process-step-kicker {
    display: block;
    margin-top: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--text-secondary);
  }

  .process-step-title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.9vw, 1.5rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--text-primary);
    margin: 0.5rem 0 0;
  }

  .process-step-desc {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.65;
    margin: 0.7rem 0 0;
    max-width: 34ch;
  }
</style>
