---
import Icon from '../components/site/Icon.astro';
import IntakeForm from '../components/site/IntakeForm.astro';
import PageHero from '../components/site/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CTA_PATHS } from '../lib/cta';
import { SEO_ROUTES, SITE_EMAIL, SITE_LOCATION, SITE_PHONE_DISPLAY, SITE_TELEPHONE, type Crumb } from '../lib/seo';

const crumbs: Crumb[] = [
  { name: 'Home', url: '/' },
  { name: 'Contact', url: '/contact/' },
];

const steps = [
  { title: 'You reach out', text: 'Call, email or send the form with a few details about your business.' },
  { title: 'We reply within one business day', text: 'You hear from Aidan or Riley directly, not a sales team.' },
  { title: 'You get a clear recommendation', text: 'If there is a fit, we explain the right package, the timeline and the price.' },
] as const;
---

<BaseLayout {...SEO_ROUTES.contact} pageType="ContactPage" crumbs={crumbs}>
  <main id="main-content" tabindex="-1">
    <PageHero
      eyebrow="Contact"
      title="Contact Axiom Web"
      lead="Questions about a website, pricing or timing? Call, email or send a message. We reply within one business day."
      crumbs={crumbs}
    />

    <section class="section" aria-labelledby="contact-options-title">
      <div class="container contact-grid">
        <div class="contact-side">
          <h2 id="contact-options-title" class="side-title">Talk to us directly</h2>
          <ul role="list" class="methods">
            <li class="card method">
              <span class="icon-tile"><Icon name="phone" /></span>
              <div>
                <h3>Phone</h3>
                <a class="method-link" href={`tel:${SITE_TELEPHONE}`}>{SITE_PHONE_DISPLAY}</a>
              </div>
            </li>
            <li class="card method">
              <span class="icon-tile"><Icon name="mail" /></span>
              <div>
                <h3>Email</h3>
                <a class="method-link" href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>
              </div>
            </li>
            <li class="card method">
              <span class="icon-tile"><Icon name="map-pin" /></span>
              <div>
                <h3>Location</h3>
                <p>{SITE_LOCATION}. Working with businesses across Waterloo Region, Guelph, Hamilton and Canada.</p>
              </div>
            </li>
            <li class="card method">
              <span class="icon-tile"><Icon name="clock" /></span>
              <div>
                <h3>Response time</h3>
                <p>Within one business day.</p>
              </div>
            </li>
          </ul>

          <div class="project-callout">
            <h3>Ready to start a project?</h3>
            <p>The project form asks a few more questions so we can recommend a package and price straight away.</p>
            <a href={CTA_PATHS.startProject} class="arrow-link">Go to the project form <Icon name="arrow-right" /></a>
          </div>
        </div>

        <IntakeForm kind="contact" title="Send a message" description="For quick questions, follow-ups or anything else." />
      </div>
    </section>

    <section class="section section-soft" aria-labelledby="next-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">What happens next</p>
          <h2 id="next-title">After you get in touch</h2>
        </div>
        <ol role="list" class="grid grid-3 next-steps">
          {steps.map((step, index) => (
            <li class="card next-step">
              <span class="next-num" aria-hidden="true">{index + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .contact-grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: 4rem;
      align-items: start;
    }
  }

  .side-title {
    margin-bottom: 1.5rem;
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.75rem);
  }

  .methods {
    display: grid;
    gap: 0.85rem;
    margin: 0;
  }

  .method {
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem 1.25rem;
  }

  .method h3 {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    font-weight: 600;
  }

  .method p {
    color: var(--ink);
    font-size: var(--fs-sm);
  }

  .method-link {
    color: var(--ink);
    font-size: 1.0625rem;
    font-weight: 650;
    word-break: break-word;
  }

  .method-link:hover {
    color: var(--brand);
  }

  .project-callout {
    display: grid;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding: 1.5rem;
    border: 1px solid var(--brand-line);
    border-radius: var(--radius-lg);
    background: var(--brand-soft);
  }

  .project-callout p {
    color: var(--text);
    font-size: var(--fs-sm);
  }

  .next-steps {
    margin: 0;
  }

  .next-step {
    gap: 0.6rem;
  }

  .next-num {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-bottom: 0.4rem;
    border-radius: 999px;
    background: var(--brand);
    color: #fff;
    font-weight: 700;
  }

  .next-step p {
    color: var(--text);
    font-size: var(--fs-sm);
  }
</style>
