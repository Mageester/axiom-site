---
import ResponsivePicture from '../components/site/ResponsivePicture.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { CTA_PATHS } from '../lib/cta';
import { HOME_JSON_LD, WEBSITE_SCHEMA, SEO_ROUTES } from '../lib/seo';
import { getWorkProofImage } from '../lib/workProofImages';

const work = [
  {
    id: 'dental-aurelia',
    title: 'Aurelia Dental Studio',
    niche: 'Healthcare',
    outcome: 'New patients can understand the practice, trust the offer, and book without digging through the site.',
    href: 'https://dental.getaxiom.ca',
    img: getWorkProofImage('concept-dental-demo'),
  },
  {
    id: 'salon-nails',
    title: 'Nails Studio',
    niche: 'Salon & Beauty',
    outcome: 'Services are easier to compare, booking appears early, and the brand reads calm and premium.',
    href: 'https://nails.getaxiom.ca',
    img: getWorkProofImage('concept-salon-demo'),
  },
  {
    id: 'barber-blackline',
    title: 'Blackline Barber Co.',
    niche: 'Personal Services',
    outcome: 'A sharper first impression with the booking path visible before a visitor starts hunting.',
    href: 'https://barber.getaxiom.ca',
    img: getWorkProofImage('concept-barber-demo'),
  },
] as const;

const services = [
  {
    label: 'Conversion Sites',
    description: 'For businesses whose offer is good, but the current site makes visitors work too hard before they reach out.',
    href: '/services#conversion-sites',
  },
  {
    label: 'Local Business Websites',
    description: 'For established local companies that need reputation, services, service area, and contact path clear on every device.',
    href: '/services#local-business-websites',
  },
  {
    label: 'Rebuilds',
    description: 'For existing sites that no longer match the quality of the business, without losing useful content or search value.',
    href: '/services#rebuilds',
  },
] as const;

const solution = [
  { title: 'Clear offer, fast', description: 'Visitors should understand what you do, who you help, and how to take the next step before the page asks them to think.' },
  { title: 'Proof beside action', description: 'Reviews, credentials, photos, and examples belong near the price, service, form, and call button - not buried later.' },
  { title: 'Friction removed', description: 'Mobile layout, page speed, navigation, and forms are shaped around the way a real buyer decides to contact you.' },
] as const;

const principles = [
  { title: 'No vague first impression', description: 'A serious business should not need paragraphs to explain itself. The offer, audience, and next action have to be obvious.' },
  { title: 'Only supportable proof', description: 'We use real assets, clearly labeled concept work, visible standards, and proof that can be backed up.' },
  { title: 'No mobile afterthought', description: 'Most buyers check you from a phone. Buttons, forms, copy, speed, and image crops are judged there first.' },
  { title: 'No account-manager fog', description: "You work directly with the people shaping the message and building the site, with a clear path after launch." },
] as const;

const figures = [
  { value: 'Two', label: 'Partners, zero middlemen' },
  { value: '14-30', label: 'Day delivery band' },
  { value: 'CAD $900', label: 'Introductory local start' },
] as const;

const process = [
  { title: 'Review', description: 'We look at the current site, offer, proof, and buyer path before deciding what needs to change.' },
  { title: 'Scope', description: 'We define pages, calls to action, copy direction, pricing path, and launch requirements before build starts.' },
  { title: 'Build', description: 'We design and develop the site around clarity, mobile quality, speed, and a cleaner inquiry path.' },
  { title: 'Launch', description: 'We check performance, mobile flow, forms, SEO basics, and domain setup before the site goes live.' },
] as const;

const team = [
  { name: 'Aidan', role: 'Strategy & scope', description: 'Shapes the message, page structure, and buyer path so the site reflects how customers actually decide.' },
  { name: 'Riley', role: 'Design & build', description: 'Builds the interface, performance foundation, and launch details so the site feels sharp on every screen.' },
] as const;
---

<SiteLayout
  title={SEO_ROUTES.home.title}
  description={SEO_ROUTES.home.description}
  canonicalPath="/"
  ogImageAlt="Axiom — web design studio in Kitchener-Waterloo."
  schema={[HOME_JSON_LD, WEBSITE_SCHEMA]}
>
  <main id="main-content" tabindex="-1" class="ax-root" data-homepage>
    <div class="ax-continuity-rail" aria-hidden="true">
      <span class="ax-continuity-rail-track"><span class="ax-continuity-rail-progress"></span></span>
    </div>

    <!-- HERO -->
    <section class="ax-hero ax-scene ax-scene--title-card" data-home-section="hero" data-cinematic-scene="hero" data-motion-role="title-card">
      <div class="ax-container">
        <h1 class="ax-mega ax-hero-title">
          <span class="ax-line"><span class="ax-line-inner ax-mask" style="--i: 0">A sharper digital</span></span>
          <span class="ax-line"><span class="ax-line-inner ax-mask" style="--i: 1">presence for serious</span></span>
          <span class="ax-line"><span class="ax-line-inner ax-mask" style="--i: 2"><em>local businesses.</em></span></span>
        </h1>

        <div class="ax-hero-foot">
          <div class="ax-hero-actions ax-load" style="--i: 1">
            <a href={CTA_PATHS.startProject} class="btn btn-primary">Start a project <span aria-hidden="true">→</span></a>
            <a href="/work" class="btn-ghost-link">See the work</a>
          </div>
          <p class="ax-lead ax-load" style="--i: 0">
            Axiom builds fast, high-trust sites that make the offer clear, place proof where buyers decide, and turn attention into qualified inquiries.
          </p>
        </div>
      </div>
    </section>

    <!-- PROBLEM -->
    <section class="ax-statement ax-scene ax-scene--statement" id="ax-statement" data-home-section="statement" data-cinematic-scene="statement" data-motion-role="statement">
      <div class="ax-container">
        <div class="ax-section-index reveal ax-reveal--rule" aria-hidden="true" style="--reveal-delay: 40ms">
          <span>01</span>
          <span class="ax-section-index-name">The first decision</span>
        </div>
        <p class="ax-big reveal ax-reveal--statement" style="--reveal-delay: 80ms">
          <span class="ax-statement-line ax-statement-line--quiet">Buyers judge the business before they ever call.</span>
          <span class="ax-statement-line ax-statement-line--resolve"><em>Your site should make that judgment easy.</em></span>
        </p>
      </div>
    </section>

    <!-- SOLUTION -->
    <section class="ax-section ax-scene ax-scene--cascade" data-home-section="solution" data-cinematic-scene="solution" data-motion-role="cascade">
      <div class="ax-container">
        <div class="ax-section-index reveal ax-reveal--rule" aria-hidden="true" style="--reveal-delay: 40ms">
          <span>02</span>
          <span class="ax-section-index-name">The standard</span>
        </div>
        <header class="ax-head">
          <h2 class="ax-h2 reveal ax-reveal--title" style="--reveal-delay: 60ms">Make the right action <em>feel obvious</em></h2>
          <p class="ax-head-note reveal ax-reveal--copy" style="--reveal-delay: 120ms">
            A professional site should not only look better. It should make the offer easier to understand, the business easier to trust, and the next step easier to take.
          </p>
        </header>

        <div class="ax-solution">
          {solution.map((s, i) => (
            <div class="ax-solution-item reveal ax-reveal--item" data-scene-index={i} style={`--reveal-delay: ${120 + i * 140}ms`}>
              <span class="ax-item-index" aria-hidden="true">{`0${i + 1}`}</span>
              <h3 class="ax-solution-title">{s.title}</h3>
              <p class="ax-solution-desc">{s.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- WORK -->
    <section class="ax-section ax-scene ax-scene--feature" data-home-section="work" data-cinematic-scene="work" data-motion-role="feature">
      <div class="ax-container">
        <div class="ax-section-index reveal ax-reveal--rule" aria-hidden="true" style="--reveal-delay: 40ms">
          <span>03</span>
          <span class="ax-section-index-name">Selected work</span>
        </div>
        <header class="ax-head">
          <h2 class="ax-h2 reveal ax-reveal--title" style="--reveal-delay: 120ms">Concept builds that show <em>the standard</em></h2>
          <p class="ax-head-note reveal ax-reveal--copy" style="--reveal-delay: 220ms">These are demonstration builds, not invented client case studies. They show how we structure local business sites for clarity, trust, and action.</p>
        </header>

        <div class="ax-work-explorer reveal ax-reveal--item" data-work-explorer style="--reveal-delay: 360ms">
          <div class="ax-work-feature-frame" data-work-feature-frame>
            {work.map((w, i) => (
              <figure
                class:list={['ax-work-feature', i === 0 && 'is-active']}
                data-work-feature={w.id}
                aria-hidden={i === 0 ? 'false' : 'true'}
              >
                <ResponsivePicture
                  source={w.img.source}
                  alt={w.img.alt || w.title}
                  sizes="(min-width: 900px) 52vw, 100vw"
                  class="ax-work-feature-img"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  objectPosition={w.img.position || 'center 40%'}
                />
                <figcaption class="ax-work-feature-caption" aria-hidden="true">
                  <span>{`0${i + 1}`} / 03</span>
                  <span>{w.niche}</span>
                </figcaption>
              </figure>
            ))}
          </div>

          <div class="ax-work-index" data-work-index>
            {work.map((w, i) => (
              <article class:list={['ax-work-item', i === 0 && 'is-open']} data-work-item>
                <button
                  id={`homepage-work-trigger-${w.id}`}
                  type="button"
                  class="ax-work-trigger"
                  aria-expanded={i === 0 ? 'true' : 'false'}
                  aria-controls={`homepage-work-panel-${w.id}`}
                  data-work-trigger={w.id}
                >
                  <span class="ax-work-num" aria-hidden="true">{`0${i + 1}`}</span>
                  <span class="ax-work-name">{w.title}</span>
                  <span class="ax-work-niche">{w.niche}</span>
                  <span class="ax-work-indicator" aria-hidden="true">+</span>
                </button>
                <div
                  id={`homepage-work-panel-${w.id}`}
                  class:list={['ax-work-panel', i === 0 && 'is-open']}
                  role="region"
                  aria-labelledby={`homepage-work-trigger-${w.id}`}
                  aria-hidden={i === 0 ? 'false' : 'true'}
                  data-work-panel={w.id}
                  hidden={i !== 0}
                >
                  <div class="ax-work-panel-inner">
                    <p class="ax-work-outcome">{w.outcome}</p>
                    <a
                      href={w.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="ax-work-link"
                      tabindex={i === 0 ? undefined : -1}
                      aria-label={`Open ${w.title} demo in a new tab`}
                    >
                      Open demo <span aria-hidden="true">↗</span>
                    </a>
                  </div>
                </div>
              </article>
            ))}

            <a href="/work" class="ax-more ax-work-all">All work <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="ax-section ax-scene ax-scene--index" data-home-section="services" data-cinematic-scene="services" data-motion-role="index">
      <div class="ax-container">
        <div class="ax-section-index reveal ax-reveal--rule" aria-hidden="true" style="--reveal-delay: 40ms">
          <span>04</span>
          <span class="ax-section-index-name">Where we help</span>
        </div>
        <header class="ax-head">
          <h2 class="ax-h2 reveal ax-reveal--title" style="--reveal-delay: 180ms">Three focused paths, <em>one standard</em></h2>
        </header>

        <ol class="ax-list">
          {services.map((s, i) => (
            <li class="reveal ax-reveal--row" data-scene-index={i} style={`--reveal-delay: ${160 + i * 120}ms`}>
              <a href={s.href} class="ax-row">
                <span class="ax-row-num" aria-hidden="true">{`0${i + 1}`}</span>
                <span class="ax-row-title">{s.label}</span>
                <span class="ax-row-desc">{s.description}</span>
                <span class="ax-row-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- WHY -->
    <section class="ax-section ax-scene ax-scene--proof" data-home-section="why" data-cinematic-scene="why" data-motion-role="proof">
      <div class="ax-container ax-split">
        <div class="ax-split-left">
          <div class="ax-section-index reveal ax-reveal--rule" aria-hidden="true" style="--reveal-delay: 40ms">
            <span>05</span>
            <span class="ax-section-index-name">The operating principle</span>
          </div>
          <h2 class="ax-h2 reveal ax-reveal--title" style="--reveal-delay: 120ms">Built for businesses that <em>cannot look unclear</em></h2>
          <p class="ax-lead reveal ax-reveal--copy" style="--reveal-delay: 220ms">
            If a new customer decides whether to trust you before they speak to you, the site has to do more than look acceptable.
          </p>
        </div>
        <div class="ax-split-right">
          {principles.map((p, i) => (
            <div class="ax-principle reveal ax-reveal--item" data-scene-index={i} style={`--reveal-delay: ${160 + i * 110}ms`}>
              <span class="ax-principle-num" aria-hidden="true">{`0${i + 1}`}</span>
              <div>
                <h3 class="ax-principle-title">{p.title}</h3>
                <p class="ax-principle-desc">{p.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FIGURES -->
    <section class="ax-section ax-section--tight ax-scene ax-scene--metrics" data-home-section="figures" data-cinematic-scene="figures" data-motion-role="metrics">
      <div class="ax-container">
        <div class="ax-section-index reveal ax-reveal--rule" aria-hidden="true" style="--reveal-delay: 40ms">
          <span>06</span>
          <span class="ax-section-index-name">The delivery signal</span>
        </div>
        <div class="ax-figures">
          {figures.map((f, i) => (
            <div class="ax-figure reveal ax-reveal--metric" data-scene-index={i} style={`--reveal-delay: ${120 + i * 140}ms; --scene-index: ${i}`}>
              <span class="ax-figure-num">{f.value}</span>
              <span class="ax-figure-label">{f.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section class="ax-section ax-scene ax-scene--process" data-home-section="process" data-cinematic-scene="process" data-motion-role="process">
      <div class="ax-container">
        <div class="ax-section-index reveal ax-reveal--rule" aria-hidden="true" style="--reveal-delay: 40ms">
          <span>07</span>
          <span class="ax-section-index-name">The sequence</span>
        </div>
        <header class="ax-head">
          <h2 class="ax-h2 reveal ax-reveal--title" style="--reveal-delay: 120ms">Review, scope, <em>build, launch</em></h2>
        </header>

        <div class="ax-process-track" data-process-track>
          <span class="ax-process-line" aria-hidden="true"><span class="ax-process-line-fill" data-process-line-fill></span></span>
          <ol class="ax-process">
            {process.map((p, i) => (
              <li class="ax-step reveal ax-reveal--step" data-process-step data-scene-index={i} style={`--reveal-delay: ${160 + i * 110}ms`}>
                <span class="ax-step-node" aria-hidden="true"></span>
                <h3 class="ax-step-title">{p.title}</h3>
                <p class="ax-step-desc">{p.description}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- STUDIO -->
    <section class="ax-section ax-scene ax-scene--partners" data-home-section="studio" data-cinematic-scene="studio" data-motion-role="partners">
      <div class="ax-container ax-split">
        <div class="ax-split-left">
          <div class="ax-section-index reveal ax-reveal--rule" aria-hidden="true" style="--reveal-delay: 40ms">
            <span>08</span>
            <span class="ax-section-index-name">The studio</span>
          </div>
          <h2 class="ax-h2 reveal ax-reveal--title" style="--reveal-delay: 120ms">Two partners. <em>Direct accountability.</em></h2>
          <p class="ax-lead reveal ax-reveal--copy" style="--reveal-delay: 220ms">
            You work with the people shaping the strategy and building the site. No account layers, no handoff fog, no guessing who owns the outcome.
          </p>
        </div>
        <div class="ax-split-right">
          {team.map((m, i) => (
            <div class="ax-person reveal ax-reveal--item" data-scene-index={i} style={`--reveal-delay: ${180 + i * 140}ms`}>
              <span class="ax-person-name">{m.name}</span>
              <span class="ax-person-role">{m.role}</span>
              <p class="ax-person-desc">{m.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="ax-final ax-scene ax-scene--resolution" data-home-section="final" data-cinematic-scene="final" data-motion-role="resolution">
      <div class="ax-container">
        <div class="ax-final-rule reveal ax-reveal--rule" aria-hidden="true" style="--reveal-delay: 120ms"></div>
        <h2 class="ax-mega ax-final-mega reveal ax-reveal--final" style="--reveal-delay: 240ms">
          Start a serious<br /><em>project conversation.</em>
        </h2>
        <div class="ax-hero-actions reveal ax-reveal--final" style="--reveal-delay: 360ms">
          <a href={CTA_PATHS.startProject} class="btn btn-primary">Start a project <span aria-hidden="true">→</span></a>
          <a href="/pricing" class="btn-ghost-link">See pricing</a>
        </div>
        <p class="ax-fineprint reveal ax-reveal--final" style="--reveal-delay: 480ms">
          Four packages. Pricing is public, the launch path is defined, and every build is checked for speed, mobile quality, and clear inquiry flow before it ships.
        </p>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .ax-root {
    --ax-gutter: clamp(1.5rem, 5vw, 4rem);
    color: var(--text-primary);
  }

  .ax-container {
    width: 100%;
    max-width: 75rem;
    margin-inline: auto;
    padding-inline: var(--ax-gutter);
  }

  /* ── Type ─────────────────────────────────────────── */
  .ax-mega {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.6rem, 8vw, 7.5rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin: 0;
  }
  .ax-mega em {
    font-style: italic;
    font-weight: 400;
  }

  .ax-h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.9rem, 4vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0;
    max-width: 18ch;
  }
  .ax-h2 em {
    font-style: italic;
    font-weight: 400;
  }

  .ax-lead {
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 44ch;
    margin: 0;
  }

  /* ── Hero ─────────────────────────────────────────── */
  .ax-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: clamp(560px, 84svh, 880px);
    padding-block: clamp(2.5rem, 7vh, 5rem) clamp(3.5rem, 9vh, 6rem);
  }

  .ax-hero-title { margin: 0; }
  .ax-line { display: block; overflow: hidden; padding-bottom: 0.04em; }
  .ax-line-inner { display: block; }

  .ax-hero-foot { margin-top: clamp(2.25rem, 5vw, 3.5rem); display: grid; gap: 2rem; }
  .ax-hero-actions { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }

  @media (min-width: 900px) {
    .ax-hero-foot { grid-template-columns: auto 1fr; align-items: end; gap: 3.5rem; }
    .ax-hero-foot .ax-lead { justify-self: end; }
  }

  /* ── Mobile hero ──────────────────────────────────── */
  @media (max-width: 767px) {
    .ax-hero { min-height: calc(100svh - 4rem); padding-top: 1.25rem; padding-bottom: 2.75rem; }
    .ax-hero-foot { margin-top: 1.75rem; gap: 1.5rem; }
    .ax-hero-actions { gap: 1rem; }
    .ax-hero-actions .btn-primary { flex: 1 1 auto; justify-content: center; }
  }

  /* ── Section frame ────────────────────────────────── */
  .ax-section { padding-block: clamp(4.5rem, 11vh, 8rem); border-top: 1px solid var(--hairline); scroll-margin-top: 5rem; }
  .ax-section--tight { padding-block: clamp(3rem, 7vh, 5rem); }

  .ax-section-index {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    line-height: 1;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ax-section-index::before {
    content: '';
    width: 5px;
    height: 5px;
    flex: 0 0 auto;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.6;
    transform: scale(0.65);
    transition: transform 700ms var(--ease-cinematic), opacity 500ms var(--ease-premium);
  }

  .ax-section-index::after {
    content: '';
    width: clamp(3rem, 9vw, 7rem);
    height: 1px;
    background: currentColor;
    opacity: 0.28;
    transform: scaleX(0.28);
    transform-origin: left center;
    transition: transform 900ms var(--ease-cinematic), opacity 500ms var(--ease-premium);
  }

  .ax-section-index.is-in::before { opacity: 1; transform: scale(1); }
  .ax-section-index.is-in::after { opacity: 0.72; transform: scaleX(1); }
  .ax-section-index-name { color: var(--text-muted); }

  .ax-head { display: grid; gap: 1.1rem; margin-bottom: clamp(2.5rem, 5vw, 3.75rem); max-width: 42rem; }
  .ax-head-note { color: var(--text-secondary); font-size: 1rem; line-height: 1.7; margin: 0; max-width: 48ch; }

  /* ── Problem statement ────────────────────────────── */
  .ax-statement {
    padding-block: clamp(4.5rem, 13vh, 9rem);
    border-top: 1px solid var(--hairline);
    background: #e6e3dc;
    color: var(--bg-base);
    scroll-margin-top: 5rem;
  }
  .ax-statement .ax-section-index,
  .ax-statement .ax-section-index-name { color: rgba(10, 10, 10, 0.62); }
  .ax-statement .ax-section-index::after { background: rgba(10, 10, 10, 0.62); }
  .ax-big {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(1.7rem, 4.4vw, 3.4rem); line-height: 1.18; letter-spacing: -0.02em;
    color: var(--text-muted); max-width: 22ch; margin: 0;
  }
  .ax-big em { font-style: normal; color: var(--bg-base); }

  /* ── Solution ─────────────────────────────────────── */
  .ax-scene--cascade { background: #0e0e0e; }
  .ax-solution { display: grid; grid-template-columns: 1fr; gap: clamp(1.5rem, 3vw, 2rem); border-top: 1px solid var(--hairline); padding-top: clamp(2rem, 4vw, 3rem); }
  @media (min-width: 760px) { .ax-solution { grid-template-columns: repeat(3, 1fr); gap: clamp(2rem, 3vw, 3rem); } }
  .ax-solution-item { display: grid; gap: 0.75rem; align-content: start; }
  .ax-item-index {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
  }
  .ax-solution-title { font-family: var(--font-display); font-size: clamp(1.25rem, 2vw, 1.6rem); font-weight: 500; letter-spacing: -0.015em; color: var(--text-primary); margin: 0; }
  .ax-solution-desc { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.65; margin: 0; max-width: 38ch; }

  /* ── Persistent page motif ────────────────────────── */
  .ax-continuity-rail {
    position: fixed;
    z-index: 4;
    top: 22vh;
    right: clamp(1rem, 2vw, 2rem);
    width: 7px;
    height: 56vh;
    pointer-events: none;
    opacity: 0.72;
  }
  .ax-continuity-rail-track {
    position: absolute;
    inset: 0 auto 0 3px;
    width: 1px;
    background: var(--hairline);
  }
  .ax-continuity-rail-progress {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--text-primary);
    transform: scaleY(var(--page-progress, 0));
    transform-origin: top center;
    transition: transform 180ms linear;
  }

  /* ── Work explorer ────────────────────────────────── */
  .ax-work-explorer {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
    gap: clamp(2rem, 6vw, 5.5rem);
    align-items: start;
  }

  .ax-work-feature-frame {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: 8px;
    background: var(--surface-1);
    box-shadow: 0 24px 72px rgba(0, 0, 0, 0.2);
  }

  .ax-work-feature {
    position: absolute;
    inset: 0;
    z-index: 0;
    margin: 0;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transform: scale(1.035);
    transition:
      opacity 600ms var(--ease-cinematic),
      transform 900ms var(--ease-cinematic),
      visibility 0s linear 600ms;
  }

  .ax-work-feature.is-active {
    z-index: 1;
    opacity: 1;
    visibility: visible;
    transform: scale(1);
    transition-delay: 0s;
  }

  :global(.ax-work-feature-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.04);
    filter: grayscale(0.14) brightness(0.92);
    transition: transform 1.3s var(--ease-cinematic), filter 700ms var(--ease-premium);
  }

  .ax-work-feature.is-active :global(.ax-work-feature-img) {
    transform: scale(1);
    filter: grayscale(0.04) brightness(1);
  }

  .ax-work-feature-caption {
    position: absolute;
    right: 1rem;
    bottom: 0.9rem;
    left: 1rem;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: rgba(242, 240, 234, 0.78);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.55);
  }

  .ax-work-index {
    min-width: 0;
    border-top: 1px solid var(--hairline-strong);
  }

  .ax-work-item {
    min-width: 0;
    border-bottom: 1px solid var(--hairline);
    transition: background-color 360ms var(--ease-premium), border-color 360ms var(--ease-premium);
  }

  .ax-work-item.is-open { background: rgba(255, 255, 255, 0.035); }

  .ax-work-trigger {
    display: grid;
    grid-template-columns: 2.1rem minmax(0, 1fr) auto 1.5rem;
    gap: 0.75rem;
    align-items: center;
    width: 100%;
    min-height: 4.3rem;
    padding: 0.85rem 0;
    border: 0;
    background: transparent;
    color: var(--text-primary);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: background-color 240ms var(--ease-premium), color 240ms var(--ease-premium);
  }

  .ax-work-trigger:hover,
  .ax-work-trigger:focus-visible,
  .ax-work-item.is-open .ax-work-trigger {
    color: var(--text-primary);
  }

  .ax-work-trigger:hover .ax-work-name,
  .ax-work-trigger:focus-visible .ax-work-name,
  .ax-work-item.is-open .ax-work-name {
    transform: translateX(0.25rem);
  }

  .ax-work-num,
  .ax-work-niche {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ax-work-name {
    min-width: 0;
    color: inherit;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.2vw, 1.65rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.1;
    transition: transform 360ms var(--ease-cinematic);
  }

  .ax-work-indicator {
    display: inline-grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    color: var(--text-muted);
    font-size: 1.3rem;
    font-weight: 300;
    line-height: 1;
    transition: transform 360ms var(--ease-cinematic), color 240ms var(--ease-premium);
  }

  .ax-work-item.is-open .ax-work-indicator {
    color: var(--text-primary);
    transform: rotate(45deg);
  }

  .ax-work-panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 420ms var(--ease-cinematic), opacity 300ms var(--ease-premium);
  }

  .ax-work-panel-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.25rem;
    min-height: 0;
    overflow: hidden;
    padding: 0;
  }

  .ax-work-panel.is-open {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .ax-work-panel.is-open .ax-work-panel-inner {
    padding-bottom: 1.35rem;
  }

  .ax-work-outcome {
    max-width: 38ch;
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0;
  }

  .ax-work-link {
    display: inline-flex;
    align-items: center;
    align-self: end;
    gap: 0.45rem;
    min-height: 2.75rem;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-color: var(--hairline-strong);
    text-underline-offset: 0.4em;
    transition: gap 240ms var(--ease-premium), text-decoration-color 240ms var(--ease-premium);
  }

  .ax-work-link:hover {
    gap: 0.75rem;
    text-decoration-color: var(--text-primary);
  }

  .ax-work-all {
    margin-top: 1.75rem;
  }

  @media (max-width: 1100px) {
    .ax-continuity-rail { display: none; }
  }

  @media (max-width: 759px) {
    .ax-work-explorer {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }

    .ax-work-feature-frame { aspect-ratio: 4 / 3; }

    .ax-work-trigger {
      grid-template-columns: 2rem minmax(0, 1fr) auto 1.35rem;
      gap: 0.55rem;
      min-height: 4rem;
    }

    .ax-work-niche {
      max-width: 6.5rem;
      text-align: right;
      line-height: 1.35;
    }

    .ax-work-panel-inner {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .ax-work-link { align-self: start; }
  }

  .ax-more {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-secondary);
    transition: color 0.2s ease, gap 0.2s ease;
  }

  .ax-more:hover { color: var(--text-primary); gap: 0.85rem; }

  /* ── Index list (services) ────────────────────────── */
  .ax-scene--index {
    background: #dedbd4;
    color: var(--bg-base);
  }
  .ax-scene--index::before { background: linear-gradient(90deg, rgba(10, 10, 10, 0.7), transparent 38%, transparent); }
  .ax-scene--index::after { background: rgba(10, 10, 10, 0.28); }
  .ax-scene--index .ax-section-index,
  .ax-scene--index .ax-section-index-name { color: rgba(10, 10, 10, 0.62); }
  .ax-scene--index .ax-section-index::after { background: rgba(10, 10, 10, 0.62); }
  .ax-scene--index .ax-h2 { color: var(--bg-base); }
  .ax-scene--index .ax-head-note { color: rgba(10, 10, 10, 0.62); }
  .ax-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--hairline); }
  .ax-row {
    display: grid; grid-template-columns: 2rem 1fr auto; grid-template-areas: 'num title arrow' 'num desc arrow';
    gap: 0.5rem; align-items: start;
    padding-block: clamp(1.6rem, 3vw, 2.4rem); border-bottom: 1px solid var(--hairline);
    transition: background-color 360ms var(--ease-premium), padding-left 420ms var(--ease-cinematic);
  }
  @media (min-width: 860px) {
    .ax-row { grid-template-columns: 2.5rem minmax(12rem, 18rem) 1fr auto; grid-template-areas: 'num title desc arrow'; align-items: center; gap: 2rem; }
  }
  .ax-row-num { grid-area: num; color: var(--text-muted); font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.14em; padding-top: 0.35rem; }
  .ax-row-title { grid-area: title; font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2.3rem); font-weight: 500; letter-spacing: -0.02em; color: var(--text-primary); line-height: 1.05; }
  .ax-row-desc { grid-area: desc; color: var(--text-secondary); font-size: 0.95rem; line-height: 1.6; max-width: 40ch; margin: 0; }
  .ax-row-arrow { grid-area: arrow; color: var(--text-muted); font-size: 1.3rem; transition: transform 0.25s ease, color 0.25s ease; justify-self: end; }
  .ax-scene--index .ax-list { border-color: rgba(10, 10, 10, 0.18); }
  .ax-scene--index .ax-row { border-color: rgba(10, 10, 10, 0.18); }
  .ax-scene--index .ax-row-title { color: var(--bg-base); }
  .ax-scene--index .ax-row-desc { color: rgba(10, 10, 10, 0.62); }
  .ax-scene--index .ax-row-num,
  .ax-scene--index .ax-row-arrow { color: rgba(10, 10, 10, 0.58); }
  .ax-scene--index .ax-list > li.is-in .ax-row-num,
  .ax-scene--index .ax-list > li.is-in .ax-row-arrow { color: var(--bg-base); }
  .ax-scene--index .ax-list > li::before { background: var(--bg-base); }
  .ax-scene--index a.ax-row:hover,
  .ax-scene--index a.ax-row:focus-visible { background: rgba(10, 10, 10, 0.06); padding-left: 0.75rem; }
  .ax-scene--index a.ax-row:hover .ax-row-arrow { color: var(--bg-base); transform: translateX(6px); }

  /* ── Split ────────────────────────────────────────── */
  .ax-split { display: grid; grid-template-columns: 1fr; gap: clamp(2.5rem, 5vw, 4rem); }
  @media (min-width: 980px) {
    .ax-split { grid-template-columns: 0.82fr 1.18fr; gap: clamp(3rem, 6vw, 6rem); }
    .ax-split-left { position: sticky; top: 7rem; align-self: start; }
  }
  .ax-split-left .ax-h2 { margin-block: 1rem 1.25rem; }

  .ax-principle { display: grid; grid-template-columns: 2rem 1fr; gap: 1.25rem; padding-block: clamp(1.5rem, 3vw, 2.1rem); border-top: 1px solid var(--hairline); }
  .ax-principle:first-child { border-top: 0; padding-top: 0; }
  .ax-principle-num { color: var(--text-muted); font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.14em; padding-top: 0.2rem; }
  .ax-principle-title { font-family: var(--font-display); font-size: 1.25rem; font-weight: 500; color: var(--text-primary); margin: 0; letter-spacing: -0.01em; }
  .ax-principle-desc { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.65; margin: 0.6rem 0 0; }

  /* ── Figures ──────────────────────────────────────── */
  .ax-scene--metrics { background: var(--text-primary); color: var(--bg-base); }
  .ax-scene--metrics .ax-section-index,
  .ax-scene--metrics .ax-section-index-name { color: rgba(10, 10, 10, 0.62); }
  .ax-scene--metrics .ax-section-index::after { background: rgba(10, 10, 10, 0.62); }
  .ax-figures { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(2rem, 4vw, 3rem); }
  @media (min-width: 760px) { .ax-figures { grid-template-columns: repeat(3, 1fr); } }
  .ax-figure { position: relative; display: grid; gap: 0.65rem; border-top: 1px solid rgba(10, 10, 10, 0.25); padding-top: 1.1rem; }
  .ax-figure::before { content: ''; position: absolute; inset: -1px 0 auto; height: 1px; background: var(--bg-base); transform: scaleX(0); transform-origin: left center; transition: transform 700ms var(--ease-cinematic); }
  .ax-figure.is-in::before { transform: scaleX(1); }
  .ax-figure-num { font-family: var(--font-display); font-size: clamp(2.2rem, 4.5vw, 3.6rem); font-weight: 500; letter-spacing: -0.03em; line-height: 1; color: var(--bg-base); }
  .ax-figure-label { font-family: var(--font-mono); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(10, 10, 10, 0.62); line-height: 1.5; }

  /* ── Process ──────────────────────────────────────── */
  .ax-scene--process { background: #0d0d0d; }
  .ax-process-track { position: relative; --process-progress: 0; }
  .ax-process-line { position: absolute; z-index: 0; inset: 0 0 auto; display: block; height: 1px; background: var(--hairline-strong); pointer-events: none; }
  .ax-process-line-fill { display: block; width: 100%; height: 100%; background: var(--text-primary); transform: scaleX(var(--process-progress)); transform-origin: left center; transition: transform 180ms linear; }
  .ax-process { position: relative; z-index: 1; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 0; }
  @media (min-width: 860px) { .ax-process { grid-template-columns: repeat(4, 1fr); } }
  .ax-step { position: relative; padding-top: 2rem; padding-right: clamp(1rem, 2vw, 2rem); border-top: 1px solid transparent; }
  @media (max-width: 859px) {
    .ax-process-track { padding-left: 1.15rem; }
    .ax-process-line { inset: 0 auto 0 0; width: 1px; height: auto; }
    .ax-process-line-fill { width: 100%; height: 100%; transform: scaleY(var(--process-progress)); transform-origin: top center; }
    .ax-step { padding-top: 1.6rem; padding-bottom: 1.6rem; }
    .ax-step + .ax-step { border-top: 1px solid var(--hairline); }
  }
  .ax-step-node { position: absolute; top: -4px; left: 0; width: 7px; height: 7px; border-radius: 999px; background: var(--text-muted); transform: scale(0.82); transition: background-color 240ms var(--ease-premium), transform 360ms var(--ease-cinematic); }
  .ax-step.is-current .ax-step-node { background: var(--text-primary); transform: scale(1.35); }
  .ax-step-title { font-family: var(--font-display); font-size: clamp(1.25rem, 2vw, 1.6rem); font-weight: 500; letter-spacing: -0.02em; color: var(--text-primary); margin: 0.5rem 0 0; }
  .ax-step-desc { color: var(--text-secondary); font-size: 0.92rem; line-height: 1.65; margin: 0.7rem 0 0; max-width: 34ch; }

  /* ── Studio ───────────────────────────────────────── */
  .ax-scene--partners { background: #0d0d0d; }
  .ax-person { padding-block: clamp(1.75rem, 3vw, 2.25rem); border-top: 1px solid var(--hairline); }
  .ax-person:first-child { border-top: 0; padding-top: 0; }
  .ax-person-name { display: block; font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); font-weight: 500; letter-spacing: -0.03em; color: var(--text-primary); }
  .ax-person-role { display: block; font-family: var(--font-mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.16em; color: var(--text-muted); margin-top: 0.4rem; }
  .ax-person-desc { color: var(--text-secondary); font-size: 1rem; line-height: 1.65; margin: 1rem 0 0; max-width: 46ch; }

  /* ── Final CTA ────────────────────────────────────── */
  .ax-final { position: relative; padding-block: clamp(5rem, 16vh, 10rem); border-top: 1px solid var(--hairline); overflow: hidden; scroll-margin-top: 5rem; }
  .ax-final::after { content: ''; position: absolute; top: 0; right: 0; width: min(48vw, 42rem); height: 1px; background: linear-gradient(90deg, transparent, var(--hairline-strong)); pointer-events: none; }
  .ax-final-rule { width: clamp(4rem, 10vw, 8rem); height: 1px; margin-bottom: clamp(2rem, 5vw, 3.5rem); background: var(--text-primary); transform-origin: left center; }
  .ax-final-mega { margin-block: 0 2.5rem; }
  .ax-fineprint { margin-top: 2.25rem; color: var(--text-muted); font-size: 0.9rem; line-height: 1.65; max-width: 48ch; }

  /* ── Choreographed reveals ────────────────────────── */
  .ax-root .ax-reveal--title { transition: opacity 800ms var(--ease-cinematic), transform 800ms var(--ease-cinematic), clip-path 800ms var(--ease-cinematic); }
  .ax-root .ax-reveal--item,
  .ax-root .ax-reveal--copy,
  .ax-root .ax-reveal--row,
  .ax-root .ax-reveal--metric,
  .ax-root .ax-reveal--step,
  .ax-root .ax-reveal--final { transition: opacity 640ms var(--ease-cinematic), transform 640ms var(--ease-cinematic); }
  .ax-root .ax-reveal--rule { transition: opacity 720ms var(--ease-cinematic), transform 720ms var(--ease-cinematic); }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .ax-root .ax-reveal--title:not(.is-in) { opacity: 0; transform: translateY(1.2rem); clip-path: inset(0 0 100% 0); }
    :global(html.js) .ax-root .ax-reveal--title.is-in { clip-path: inset(0); }
    :global(html.js) .ax-root .ax-reveal--statement:not(.is-in) { opacity: 0; transform: translateY(1.4rem); }
    :global(html.js) .ax-root .ax-reveal--copy:not(.is-in) { opacity: 0; transform: translateY(1rem); }
    :global(html.js) .ax-root .ax-reveal--item:not(.is-in) { opacity: 0; transform: translateY(1rem) scale(0.985); }
    :global(html.js) .ax-root .ax-reveal--row:not(.is-in) { opacity: 0; transform: translateX(-1.1rem); }
    :global(html.js) .ax-root .ax-reveal--metric:not(.is-in) { opacity: 0; transform: translateY(1rem); }
    :global(html.js) .ax-root .ax-reveal--step:not(.is-in) { opacity: 0; transform: translateY(1.25rem); }
    :global(html.js) .ax-root .ax-reveal--final:not(.is-in) { opacity: 0; transform: translateY(1.25rem) scale(0.985); }
    :global(html.js) .ax-root .ax-reveal--rule:not(.is-in) { opacity: 0; transform: scaleX(0); }
  }

  /* ── Hero title-card pacing ───────────────────────── */
  .ax-hero::before { content: ''; position: absolute; top: clamp(1.5rem, 8vh, 4rem); bottom: clamp(2rem, 8vh, 5rem); left: var(--ax-gutter); width: 1px; background: linear-gradient(var(--hairline-strong), transparent); opacity: 0.7; transform: scaleY(0); transform-origin: top center; }
  .ax-load { opacity: 1; }
  .ax-mask { transform: none; }
  :global(html.js) .ax-load { opacity: 0; animation: ax-rise 0.8s var(--ease-cinematic) forwards; animation-delay: calc(var(--i, 0) * 80ms); }
  :global(html.js) .ax-mask { transform: translateY(110%); animation: ax-unmask 0.9s var(--ease-cinematic) forwards; animation-delay: calc(var(--i, 0) * 90ms); }
  :global(html.js) .ax-hero::before { animation: ax-line-in 1.1s var(--ease-cinematic) 320ms forwards; }

  @keyframes ax-rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  @keyframes ax-unmask { from { transform: translateY(110%); } to { transform: translateY(0); } }
  @keyframes ax-line-in { from { transform: scaleY(0); } to { transform: scaleY(1); } }

  @media (prefers-reduced-motion: reduce) {
    .ax-load, .ax-mask, .ax-hero::before { animation: none !important; opacity: 1 !important; transform: none !important; }
    .ax-continuity-rail { display: none; }
    .ax-work-feature,
    .ax-work-panel,
    .ax-work-panel-inner,
    .ax-work-name,
    .ax-work-indicator,
    .ax-work-feature-img,
    .ax-process-line-fill,
    .ax-step-node,
    .ax-figure::before { transition: none !important; }
    .ax-work-feature { transform: none; }
    .ax-work-feature.is-active { opacity: 1; }
    .ax-root .ax-reveal--rule { opacity: 1 !important; transform: none !important; }
  }

  /* ── Full-page cinematic scene system ───────────────── */
  :global(html) { overflow-x: clip; }

  .ax-scene {
    --scene-progress: 1;
    --scene-inverse: 0;
    --scene-drift-left: 0px;
    --scene-drift-right: 0px;
    --scene-drift-up: 0px;
    --scene-drift-down: 0px;
    --scene-scale: 1;
    position: relative;
    isolation: isolate;
  }

  .ax-scene::after {
    content: '';
    position: absolute;
    z-index: 0;
    right: var(--ax-gutter);
    bottom: 0;
    left: var(--ax-gutter);
    height: 1px;
    background: var(--hairline-strong);
    opacity: 0.72;
    pointer-events: none;
    transform: scaleX(var(--scene-progress));
    transform-origin: left center;
    transition: transform 1.35s var(--ease-cinematic), opacity 900ms var(--ease-premium);
  }

  .ax-scene:not(.ax-scene--title-card)::before {
    content: '';
    position: absolute;
    z-index: 0;
    top: 0;
    right: var(--ax-gutter);
    left: var(--ax-gutter);
    height: 1px;
    background: linear-gradient(90deg, var(--text-primary), transparent 38%, transparent);
    opacity: 0.22;
    pointer-events: none;
    transform: scaleX(var(--scene-progress));
    transform-origin: left center;
    transition: transform 1.5s var(--ease-cinematic), opacity 1s var(--ease-premium);
  }

  .ax-scene--resolution::after {
    top: 0;
    right: 0;
    bottom: auto;
    left: auto;
    width: min(48vw, 42rem);
    background: linear-gradient(90deg, transparent, var(--hairline-strong));
    transform-origin: right center;
  }

  .ax-scene > .ax-container,
  .ax-scene > .ax-container > * {
    position: relative;
    z-index: 1;
  }

  /* The opening is a title card: held, masked, then released in three beats. */
  .ax-scene--title-card .ax-hero-title {
    transition: transform 1.45s var(--ease-cinematic);
  }

  .ax-scene--title-card .ax-hero-foot {
    transition: transform 1.25s var(--ease-cinematic);
  }

  :global(html.js) .ax-scene--title-card .ax-hero-title {
    transform: translate3d(0, var(--scene-drift-up), 0) scale(var(--scene-scale));
  }

  :global(html.js) .ax-scene--title-card .ax-hero-foot {
    transform: translate3d(var(--scene-drift-right), 0, 0);
  }

  :global(html.js) .ax-mask {
    animation: ax-title-card-reveal 1.6s var(--ease-cinematic) both;
    animation-delay: calc(260ms + (var(--i, 0) * 360ms));
  }

  :global(html.js) .ax-load {
    animation: ax-hero-support-reveal 1.2s var(--ease-cinematic) both;
    animation-delay: calc(1.85s + (var(--i, 0) * 360ms));
  }

  :global(html.js) .ax-hero::before {
    animation: ax-line-in 1.8s var(--ease-cinematic) 180ms both;
  }

  @keyframes ax-title-card-reveal {
    0% { opacity: 0; transform: translate3d(0, 120%, 0) scale(1.045); letter-spacing: 0.015em; }
    58% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); letter-spacing: -0.025em; }
    100% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); letter-spacing: -0.025em; }
  }

  @keyframes ax-hero-support-reveal {
    0% { opacity: 0; transform: translate3d(0, 1.25rem, 0); }
    62% { opacity: 1; transform: translate3d(0, 0, 0); }
    100% { opacity: 1; transform: translate3d(0, 0, 0); }
  }

  /* Editorial statement: two lines travel from opposite sides and settle. */
  .ax-statement-line {
    display: block;
    transition: transform 1.45s var(--ease-cinematic), letter-spacing 1.45s var(--ease-cinematic);
  }

  :global(html.js) .ax-scene--statement .ax-statement-line--quiet {
    transform: translate3d(var(--scene-drift-left), 0, 0);
    letter-spacing: 0.012em;
  }

  :global(html.js) .ax-scene--statement .ax-statement-line--resolve {
    transform: translate3d(var(--scene-drift-right), 0, 0);
    letter-spacing: -0.02em;
    transition-delay: 160ms;
  }

  /* Solution cascade: each proof beat has a different vector. */
  .ax-solution-item::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    background: var(--text-primary);
    opacity: 0.45;
    transform: scaleY(0);
    transform-origin: top center;
    transition: transform 1.2s var(--ease-cinematic);
  }

  .ax-solution-item { position: relative; padding-left: clamp(0.85rem, 2vw, 1.4rem); }
  .ax-solution-item.is-in::before { transform: scaleY(1); }
  .ax-solution-title,
  .ax-solution-desc { transition: transform 1.35s var(--ease-cinematic), opacity 1.1s var(--ease-premium); }

  :global(html.js) .ax-scene--cascade .ax-solution-item:nth-child(1) .ax-solution-title { transform: translate3d(var(--scene-drift-left), 0, 0); }
  :global(html.js) .ax-scene--cascade .ax-solution-item:nth-child(1) .ax-solution-desc { transform: translate3d(0, var(--scene-drift-down), 0); }
  :global(html.js) .ax-scene--cascade .ax-solution-item:nth-child(2) .ax-solution-title { transform: translate3d(0, var(--scene-drift-up), 0); }
  :global(html.js) .ax-scene--cascade .ax-solution-item:nth-child(2) .ax-solution-desc { transform: translate3d(var(--scene-drift-right), 0, 0); }
  :global(html.js) .ax-scene--cascade .ax-solution-item:nth-child(3) .ax-solution-title { transform: translate3d(var(--scene-drift-right), 0, 0); }
  :global(html.js) .ax-scene--cascade .ax-solution-item:nth-child(3) .ax-solution-desc { transform: translate3d(0, var(--scene-drift-down), 0); }

  /* Work: the frame and index arrive on separate tracks; the image breathes slowly. */
  .ax-work-feature-frame,
  .ax-work-index { transition: transform 1.5s var(--ease-cinematic); }
  :global(html.js) .ax-scene--feature .ax-work-feature-frame { transform: translate3d(0, var(--scene-drift-down), 0); }
  :global(html.js) .ax-scene--feature .ax-work-index { transform: translate3d(var(--scene-drift-right), 0, 0); }

  .ax-work-feature {
    clip-path: inset(0 16% 0 0);
    transition:
      opacity 1.2s var(--ease-cinematic),
      transform 1.8s var(--ease-cinematic),
      clip-path 1.25s var(--ease-cinematic),
      visibility 0s linear 1.2s;
  }

  .ax-work-feature.is-active {
    clip-path: inset(0);
    transition-delay: 0s;
  }

  :global(.ax-work-feature-img) {
    transform: scale(1.1);
    transition: transform 2.1s var(--ease-cinematic), filter 1.2s var(--ease-premium);
  }

  .ax-work-feature.is-active :global(.ax-work-feature-img) {
    transform: scale(1);
  }

  .ax-work-feature-frame::after {
    content: '';
    position: absolute;
    z-index: 3;
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    background: rgba(242, 240, 234, 0.75);
    pointer-events: none;
    transform: translateX(calc(var(--scene-progress) * 100%));
    opacity: 0.45;
    transition: transform 1.65s var(--ease-cinematic), opacity 900ms var(--ease-premium);
  }

  /* Services: a line indicator draws before each row settles into the index. */
  .ax-list > li { position: relative; overflow: hidden; }
  .ax-list > li::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    background: var(--text-primary);
    opacity: 0.7;
    transform: scaleY(0);
    transform-origin: top center;
    transition: transform 1.25s var(--ease-cinematic);
  }
  .ax-list > li.is-in::before { transform: scaleY(1); }
  .ax-row-title,
  .ax-row-desc { transition: transform 1.35s var(--ease-cinematic), opacity 1.15s var(--ease-premium); }
  :global(html.js) .ax-scene--index .ax-list > li:nth-child(1) .ax-row-title { transform: translate3d(var(--scene-drift-left), 0, 0); }
  :global(html.js) .ax-scene--index .ax-list > li:nth-child(1) .ax-row-desc { transform: translate3d(0, var(--scene-drift-down), 0); }
  :global(html.js) .ax-scene--index .ax-list > li:nth-child(2) .ax-row-title { transform: translate3d(0, var(--scene-drift-up), 0); }
  :global(html.js) .ax-scene--index .ax-list > li:nth-child(2) .ax-row-desc { transform: translate3d(var(--scene-drift-right), 0, 0); }
  :global(html.js) .ax-scene--index .ax-list > li:nth-child(3) .ax-row-title { transform: translate3d(var(--scene-drift-left), 0, 0); }
  :global(html.js) .ax-scene--index .ax-list > li:nth-child(3) .ax-row-desc { transform: translate3d(0, var(--scene-drift-down), 0); }

  /* Trust/proof: the left statement holds while proof lines disclose progressively. */
  .ax-scene--proof .ax-split-left { transition: transform 1.45s var(--ease-cinematic); }
  :global(html.js) .ax-scene--proof .ax-split-left { transform: translate3d(0, var(--scene-drift-up), 0); }
  .ax-principle { position: relative; }
  .ax-principle::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    background: var(--text-primary);
    opacity: 0.55;
    transform: scaleY(0);
    transform-origin: top center;
    transition: transform 1.3s var(--ease-cinematic);
  }
  .ax-principle.is-in::after { transform: scaleY(1); }
  .ax-principle-title,
  .ax-principle-desc { transition: transform 1.35s var(--ease-cinematic), opacity 1.15s var(--ease-premium); }
  :global(html.js) .ax-scene--proof .ax-principle-title { transform: translate3d(var(--scene-drift-right), 0, 0); }
  :global(html.js) .ax-scene--proof .ax-principle-desc { transform: translate3d(0, var(--scene-drift-down), 0); }

  /* Metrics are a separate beat: line, number, then label. */
  .ax-figure::before { transition: transform 1.25s var(--ease-cinematic); }
  .ax-figure-num,
  .ax-figure-label { display: block; }
  :global(html.js) .ax-scene--metrics .ax-figure-num { animation: none; }
  :global(html.js) .ax-scene--metrics .ax-figure.is-in .ax-figure-num {
    animation: ax-metric-beat 1.55s var(--ease-cinematic) both;
    animation-delay: calc(420ms + (var(--scene-index, 0) * 320ms));
  }
  :global(html.js) .ax-scene--metrics .ax-figure.is-in .ax-figure-label {
    animation: ax-metric-label 1s var(--ease-premium) both;
    animation-delay: calc(820ms + (var(--scene-index, 0) * 320ms));
  }
  @keyframes ax-metric-beat {
    0% { opacity: 0; transform: translate3d(0, 1.4rem, 0) scale(0.92); }
    58% { opacity: 1; transform: translate3d(0, 0, 0) scale(1.035); }
    100% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
  }
  @keyframes ax-metric-label {
    from { opacity: 0; transform: translate3d(0, 0.6rem, 0); letter-spacing: 0.22em; }
    to { opacity: 1; transform: none; letter-spacing: 0.1em; }
  }

  /* Process: the drawn line leads; each step settles as its local progress arrives. */
  .ax-process-line-fill { transition: transform 320ms linear; }
  .ax-step { --step-progress: 1; --step-drift: 0px; }
  .ax-step-node { transition: background-color 700ms var(--ease-premium), transform 800ms var(--ease-cinematic), box-shadow 800ms var(--ease-cinematic); }
  .ax-step.is-current .ax-step-node { box-shadow: 0 0 0 5px rgba(242, 240, 234, 0.08); }
  .ax-step-title,
  .ax-step-desc { transition: transform 1s var(--ease-cinematic), opacity 900ms var(--ease-premium), color 700ms var(--ease-premium); }
  :global(html.js) .ax-scene--process .ax-step-title { transform: translate3d(0, var(--step-drift), 0); }
  :global(html.js) .ax-scene--process .ax-step-desc { opacity: calc(0.42 + (var(--step-progress) * 0.58)); transform: translate3d(0, var(--step-drift), 0); }
  .ax-step.is-current .ax-step-title { color: var(--text-primary); }

  /* Partners use a quiet lateral entrance rather than another stacked fade. */
  .ax-scene--partners .ax-split-left { transition: transform 1.5s var(--ease-cinematic); }
  :global(html.js) .ax-scene--partners .ax-split-left { transform: translate3d(var(--scene-drift-left), 0, 0); }
  .ax-person { position: relative; overflow: hidden; }
  .ax-person::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3rem;
    height: 1px;
    background: var(--text-primary);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 1.2s var(--ease-cinematic);
  }
  .ax-person.is-in::after { transform: scaleX(1); }
  .ax-person-name { transition: transform 1.4s var(--ease-cinematic), opacity 1.1s var(--ease-premium); }
  .ax-person-role,
  .ax-person-desc { transition: transform 1.25s var(--ease-cinematic), opacity 1s var(--ease-premium); }
  :global(html.js) .ax-scene--partners .ax-person-name { transform: translate3d(var(--scene-drift-right), 0, 0); }
  :global(html.js) .ax-scene--partners .ax-person-role { transform: translate3d(var(--scene-drift-left), 0, 0); }
  :global(html.js) .ax-scene--partners .ax-person-desc { transform: translate3d(0, var(--scene-drift-down), 0); }

  /* Closing resolution: rule, message, action, then the quiet footnote. */
  .ax-final-rule { transition: opacity 1.3s var(--ease-premium), transform 1.45s var(--ease-cinematic); }
  .ax-final-mega { transition: transform 1.5s var(--ease-cinematic), opacity 1.25s var(--ease-premium); }
  :global(html.js) .ax-scene--resolution .ax-final-mega { transform: translate3d(0, var(--scene-drift-up), 0) scale(var(--scene-scale)); }
  :global(html.js) .ax-scene--resolution .ax-hero-actions { transform: translate3d(var(--scene-drift-right), 0, 0); transition: transform 1.2s var(--ease-cinematic); }
  :global(html.js) .ax-scene--resolution .ax-fineprint { transform: translate3d(0, var(--scene-drift-down), 0); transition: transform 1.1s var(--ease-cinematic), opacity 1s var(--ease-premium); }

  /* Homepage-only footer coda. The footer stays readable while its columns settle. */
  :global(.site-footer[data-home-footer='true']) { position: relative; overflow: hidden; }
  :global(.site-footer[data-home-footer='true']::before) {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: min(32vw, 22rem);
    height: 1px;
    background: var(--text-primary);
    opacity: 0.6;
    transform: scaleX(var(--footer-progress, 0));
    transform-origin: left center;
    transition: transform 1.4s var(--ease-cinematic);
  }
  :global(html.js .site-footer[data-home-footer='true'] .axiom-container > div) {
    transition: transform 1.25s var(--ease-cinematic), opacity 1s var(--ease-premium);
  }
  :global(html.js .site-footer[data-home-footer='true'] .axiom-container > div:nth-child(odd)) {
    transform: translate3d(0, var(--footer-drift, 0px), 0);
  }
  :global(html.js .site-footer[data-home-footer='true'] .axiom-container > div:nth-child(even)) {
    transform: translate3d(0, calc(var(--footer-drift, 0px) * -1), 0);
  }

  /* Long, deliberate scene holds. Every variant remains visible without JS. */
  .ax-root .ax-reveal--title { transition: opacity 1.35s var(--ease-cinematic), transform 1.35s var(--ease-cinematic), clip-path 1.35s var(--ease-cinematic); }
  .ax-root .ax-reveal--statement { transition: opacity 1.5s var(--ease-cinematic), transform 1.5s var(--ease-cinematic); }
  .ax-root .ax-reveal--copy { transition: opacity 1.15s var(--ease-cinematic), transform 1.15s var(--ease-cinematic); }
  .ax-root .ax-reveal--item { transition: opacity 1.25s var(--ease-cinematic), transform 1.25s var(--ease-cinematic); }
  .ax-root .ax-reveal--row { transition: opacity 1.35s var(--ease-cinematic), transform 1.35s var(--ease-cinematic); }
  .ax-root .ax-reveal--metric { transition: opacity 1.3s var(--ease-cinematic), transform 1.3s var(--ease-cinematic); }
  .ax-root .ax-reveal--step { transition: opacity 1.2s var(--ease-cinematic), transform 1.2s var(--ease-cinematic); }
  .ax-root .ax-reveal--final { transition: opacity 1.45s var(--ease-cinematic), transform 1.45s var(--ease-cinematic); }
  .ax-root .ax-reveal--rule { transition: opacity 1.4s var(--ease-cinematic), transform 1.4s var(--ease-cinematic); }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .ax-root .ax-reveal--title:not(.is-in) { opacity: 0; transform: translate3d(0, 2rem, 0) scale(0.985); clip-path: inset(0 0 100% 0); }
    :global(html.js) .ax-root .ax-reveal--title.is-in { clip-path: inset(0); }
    :global(html.js) .ax-root .ax-reveal--statement:not(.is-in) { opacity: 0; transform: translate3d(0, 2.2rem, 0); }
    :global(html.js) .ax-root .ax-reveal--copy:not(.is-in) { opacity: 0; transform: translate3d(var(--scene-drift-left), 1.4rem, 0); }
    :global(html.js) .ax-root .ax-reveal--item:not(.is-in) { opacity: 0; transform: translate3d(0, 1.8rem, 0) scale(0.98); }
    :global(html.js) .ax-root .ax-reveal--row:not(.is-in) { opacity: 0; transform: translate3d(-2.25rem, 0, 0); }
    :global(html.js) .ax-root .ax-reveal--metric:not(.is-in) { opacity: 0; transform: translate3d(0, 2rem, 0) scale(0.96); }
    :global(html.js) .ax-root .ax-reveal--step:not(.is-in) { opacity: 0; transform: translate3d(0, 1.8rem, 0); }
    :global(html.js) .ax-root .ax-reveal--final:not(.is-in) { opacity: 0; transform: translate3d(0, 2rem, 0) scale(0.965); }
    :global(html.js) .ax-root .ax-reveal--rule:not(.is-in) { opacity: 0; transform: scaleX(0); }
  }

  @media (max-width: 759px) {
    .ax-mega {
      font-size: clamp(2.3rem, 9.6vw, 4rem);
      letter-spacing: -0.04em;
    }
    .ax-scene::after,
    .ax-scene:not(.ax-scene--title-card)::before { right: var(--ax-gutter); left: var(--ax-gutter); }
    .ax-work-feature-frame::after { display: none; }
    .ax-solution-item { padding-left: 0.9rem; }
    :global(html.js .site-footer[data-home-footer='true'] .axiom-container > div:nth-child(even)) { transform: translate3d(0, var(--footer-drift, 0px), 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ax-scene::before,
    .ax-scene::after,
    .ax-scene--resolution::after,
    .ax-work-feature-frame::after,
    .ax-solution-item::before,
    .ax-list > li::before,
    .ax-principle::after,
    .ax-person::after,
    :global(.site-footer[data-home-footer='true']::before) { transition: none !important; transform: none !important; }
    .ax-scene--title-card .ax-hero-title,
    .ax-scene--title-card .ax-hero-foot,
    .ax-scene--proof .ax-split-left,
    .ax-scene--partners .ax-split-left,
    .ax-work-feature-frame,
    .ax-work-index,
    .ax-solution-title,
    .ax-solution-desc,
    .ax-row-title,
    .ax-row-desc,
    .ax-principle-title,
    .ax-principle-desc,
    .ax-person-name,
    .ax-person-role,
    .ax-person-desc,
    .ax-final-mega,
    :global(html.js .site-footer[data-home-footer='true'] .axiom-container > div) { opacity: 1 !important; transform: none !important; transition: none !important; }
    .ax-figure-num,
    .ax-figure-label { animation: none !important; opacity: 1 !important; transform: none !important; }
    .ax-step-desc { opacity: 1 !important; transform: none !important; }
  }

  /* ── Editorial motion system ─────────────────────────
     Every scene has one clear visual lead: type for the opening, an inverted
     statement, image for work, the line for process, and the CTA at the end.
     Content moves on one axis only; emphasis comes from timing and contrast. */
  .ax-root .ax-scene {
    --scene-drift-left: 0px;
    --scene-drift-right: 0px;
    --scene-drift-up: 0px;
    --scene-drift-down: 0px;
    --scene-scale: 1;
  }

  .ax-root .ax-scene--process .ax-step { --step-drift: 0px; }
  :global(.site-footer[data-home-footer='true']) { --footer-drift: 0px; }

  .ax-root .ax-reveal--title,
  .ax-root .ax-reveal--statement,
  .ax-root .ax-reveal--copy,
  .ax-root .ax-reveal--item,
  .ax-root .ax-reveal--row,
  .ax-root .ax-reveal--metric,
  .ax-root .ax-reveal--step,
  .ax-root .ax-reveal--final {
    transition-property: opacity, transform;
