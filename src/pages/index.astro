---
import LiquidLens from '../components/liquid/LiquidLens';
import CtaBand from '../components/site/CtaBand.astro';
import FaqList from '../components/site/FaqList.astro';
import Icon from '../components/site/Icon.astro';
import ResponsivePicture from '../components/site/ResponsivePicture.astro';
import { founders, homeFaq } from '../content/company';
import { processSteps } from '../content/process';
import { services } from '../content/services';
import { getProject } from '../content/work';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CTA_PATHS } from '../lib/cta';
import { SEO_ROUTES, faqJsonLd } from '../lib/seo';

// The lens carries the live client site and three concepts, in this order.
const reel = ['reids-home-and-yard', 'physio-clinic', 'dental-aurelia', 'landscaping'].map((id) => getProject(id)!);
const lensProjects = reel.map((project) => ({
  name: project.title,
  kind: project.kind === 'client' ? 'Client, live' : 'Concept',
  src: project.image.webpSrcSet.split(',').map((s) => s.trim().split(' ')[0]).find((src) => src.includes('960')) ?? project.image.fallbackSrc,
}));
const previewFor = (project: (typeof reel)[number]) =>
  project.image.webpSrcSet.split(',').map((s) => s.trim().split(' ')[0]).find((src) => src.includes('960')) ?? project.image.fallbackSrc;
const [lead, physio] = reel;
const chipSizes = '(min-width: 900px) 120px, 60px';
const rowSizes = '(min-width: 900px) 0px, 92vw';

const poster = {
  type: 'image/webp',
  href: '/images/lens-poster-900.webp',
  srcset: '/images/lens-poster-450.webp 450w, /images/lens-poster-720.webp 720w, /images/lens-poster-900.webp 900w',
  sizes: '(min-width: 861px) min(75vh, 50vw), 66vw',
};
---

<BaseLayout
  {...SEO_ROUTES.home}
  schema={[faqJsonLd(homeFaq)]}
  ogImageAlt="Axiom Web — a web design studio in Kitchener-Waterloo building websites for local businesses"
  preload={poster}
  heroTheme="dark"
>
  <main id="main-content" tabindex="-1">
    <!-- One persistent lens canvas travels with the scroll (see LiquidLens.tsx). -->
    <LiquidLens client:idle projects={lensProjects} reelId="hero-reel" posterId="lens-poster" />

    <!-- Stage: the liquid lens hero -->
    <section class="stage hero-stage" id="hero-stage" data-stage>
      <picture class="lens-poster" id="lens-poster" aria-hidden="true" data-lens-anchor="hero">
        <source type="image/avif" srcset="/images/lens-poster-450.avif 450w, /images/lens-poster-720.avif 720w, /images/lens-poster-900.avif 900w" sizes={poster.sizes} />
        <img
          src={poster.href}
          srcset={poster.srcset}
          sizes={poster.sizes}
          width="900"
          height="900"
          alt=""
          decoding="async"
          fetchpriority="high"
        />
      </picture>

      <div class="container hero-inner">
        <h1 class="hero-title">
          <span class="hero-kicker mono">Web design studio in Kitchener-Waterloo, Ontario<span class="sr-only">:</span></span>
          <span class="line"><span>Websites that</span></span>
          <span class="line"><span>feel <em>alive.</em></span></span>
        </h1>

        <div class="hero-foot">
          <div class="hero-copy">
            <p class="hero-sub">
              A two-person studio building websites for local businesses across Ontario. Fixed prices from CAD $900, live in two to four weeks.
            </p>
            <div class="btn-row">
              <a href={CTA_PATHS.startProject} class="btn btn-light" data-magnetic>Start a project <Icon name="arrow-right" /></a>
              <a href="#work" class="arrow-link hero-link">Selected work <Icon name="arrow-right" /></a>
            </div>
          </div>

          <div class="reel" id="hero-reel" aria-live="polite">
            <span class="mono reel-hint">Now showing — move the cursor, click to splash</span>
            <p class="reel-name">
              <span data-reel-index>01</span> <span data-reel-name>{lead.title}</span>
              <span class="reel-kind" data-reel-kind>· Client, live</span>
            </p>
            <div class="reel-bars" data-reel-bars aria-hidden="true">
              {reel.map(() => <i><b></b></i>)}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Statement -->
    <section class="section statement-section" aria-labelledby="statement-label">
      <div class="container statement-wrap">
        <div class="lens-anchor statement-anchor" data-lens-anchor="statement" aria-hidden="true"></div>
        <p id="statement-label" class="eyebrow">The studio</p>
        <p class="statement" data-reveal>
          We design
          <span class="chip"><ResponsivePicture source={lead.image} alt="" sizes={chipSizes} position={lead.position} /></span>
          websites for local businesses, and build
          <span class="chip"><ResponsivePicture source={physio.image} alt="" sizes={chipSizes} position={physio.position} /></span>
          quietly for agencies. Fast, clear, and <em>impossible to ignore.</em>
        </p>
      </div>
    </section>

    <!-- Selected work -->
    <section class="section work-section" id="work" aria-labelledby="work-title">
      <div class="container">
        <div class="work-head">
          <h2 id="work-title">Selected <em>work</em></h2>
          <div class="work-head-side">
            <div class="lens-anchor work-anchor" data-lens-anchor="work" aria-hidden="true"></div>
            <p class="mono">One client site, three concepts</p>
          </div>
        </div>
        <ul role="list" class="rows">
          {reel.map((project, index) => (
            <li class="row" data-cursor="View" data-preview={previewFor(project)} data-lens-hover={index}>
              <a class="row-in" href={project.href} target="_blank" rel="noopener">
                <span class="row-main">
                  <span class="row-name">{project.title}</span>
                  <span class="row-thumb">
                    <ResponsivePicture source={project.image} alt={project.alt} sizes={rowSizes} position={project.position} />
                  </span>
                </span>
                <span class="row-meta mono">
                  <span>{project.industryLabel}</span>
                  <span class:list={['tag', { live: project.kind === 'client' }]}>
                    {project.kind === 'client' ? 'Client · Live' : 'Concept'}
                  </span>
                  <span class="sr-only">({project.kind === 'client' ? 'live client website' : 'concept build'}, opens in a new tab)</span>
                </span>
                <span class="row-index mono" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="work-foot">
          <p class="small muted">Concept builds are demonstrations designed by Axiom Web and labelled as such. They are not client results.</p>
          <a href="/work/" class="arrow-link">All work <Icon name="arrow-right" /></a>
        </div>
      </div>
    </section>

    <!-- Offers -->
    <section class="section offers-section" id="offers" aria-label="What we offer">
      <div class="container offers">
        <div class="offer reveal">
          <p class="eyebrow">For local businesses</p>
          <h2 class="offer-title">A site that makes you the <em>obvious</em> choice.</h2>
          <dl class="facts">
            <div><dt>Fixed price</dt><dd>from CAD $900</dd></div>
            <div><dt>Brief to live</dt><dd>2–4 weeks</dd></div>
            <div><dt>Payments</dt><dd>two, tied to milestones</dd></div>
            <div><dt>Hosting</dt><dd>simple, annual</dd></div>
            <div><dt>Ownership</dt><dd>your domain, your accounts</dd></div>
          </dl>
          <div class="offer-actions">
            <a class="btn" href={CTA_PATHS.startProject} data-magnetic>Start a project <Icon name="arrow-right" /></a>
            <a class="arrow-link" href="/pricing/">See pricing</a>
          </div>
          <ul role="list" class="offer-links mono">
            {services.map((service) => (
              <li><a href={`/services/${service.slug}/`}>{service.name}</a></li>
            ))}
          </ul>
        </div>
        <div class="offer reveal">
          <p class="eyebrow">For agencies</p>
          <h2 class="offer-title">Your name on it. <em>Our hands</em> on it.</h2>
          <dl class="facts">
            <div><dt>Rate</dt><dd>CAD 50/hour</dd></div>
            <div><dt>Quote</dt><dd>fixed, within 24 hours</dd></div>
            <div><dt>Confidentiality</dt><dd>NDA by default</dd></div>
            <div><dt>After launch</dt><dd>30 days of free fixes</dd></div>
            <div><dt>Platforms</dt><dd>custom, Shopify, WordPress</dd></div>
          </dl>
          <div class="offer-actions">
            <a class="btn btn-secondary" href="/agencies/" data-magnetic>Send a first job <Icon name="arrow-right" /></a>
          </div>
          <div class="lens-anchor offers-anchor" data-lens-anchor="offers" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <!-- Process -->
    <section class="section section-soft" aria-labelledby="process-title">
      <div class="container split">
        <div class="section-head split-head">
          <p class="eyebrow">How it works</p>
          <h2 id="process-title">First call to launch in <em>four</em> steps</h2>
          <p>Scope and price are agreed in writing before design starts, so there are no surprises later.</p>
          <a href="/approach/" class="arrow-link">See the full process <Icon name="arrow-right" /></a>
          <div class="lens-anchor head-anchor" data-lens-anchor="section" aria-hidden="true"></div>
        </div>
        <ol role="list" class="steps reveal-stagger">
          {processSteps.map((step) => (
            <li class="step">
              <span class="step-num mono" aria-hidden="true">{step.number}</span>
              <div class="step-body">
                <p class="step-timing mono">{step.timing}</p>
                <h3>{step.title}</h3>
                <p>{step.summary}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Founders -->
    <section class="section section-soft" aria-labelledby="team-title">
      <div class="container split">
        <div class="section-head split-head">
          <p class="eyebrow">Who you’ll work with</p>
          <h2 id="team-title">Two founders. No account managers.</h2>
          <p>
            Aidan Magee and Riley Hinsperger are the co-founders of Axiom Web, the web-focused subsidiary of Axiom International.
            You work directly with the people who plan, design and build your website.
          </p>
          <a href="/about/" class="arrow-link">About the studio <Icon name="arrow-right" /></a>
          <div class="lens-anchor head-anchor" data-lens-anchor="section" aria-hidden="true"></div>
        </div>
        <ul role="list" class="founders reveal-stagger">
          {founders.map((founder) => (
            <li class="founder">
              <p class="founder-role mono">{founder.role}</p>
              <h3>{founder.name}</h3>
              <p>{founder.bio}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section section-soft" aria-labelledby="faq-title">
      <div class="container split">
        <div class="section-head split-head">
          <p class="eyebrow">FAQ</p>
          <h2 id="faq-title">Straight <em>answers</em></h2>
          <p>About cost, timing and what working with us looks like.</p>
          <a href="/contact/" class="arrow-link">Ask something else <Icon name="arrow-right" /></a>
          <div class="lens-anchor head-anchor" data-lens-anchor="section" aria-hidden="true"></div>
        </div>
        <FaqList items={homeFaq} openFirst />
      </div>
    </section>

    <CtaBand title="Let’s make yours." />
  </main>
</BaseLayout>

<style>
  /* ── Stage ─────────────────────────────────────────────── */
  .hero-stage {
    position: relative;
    display: flex;
    flex-direction: column;
    height: clamp(640px, 92svh, 920px);
    padding-top: var(--header-h);
    overflow: hidden;
    container-type: size;
  }

  .hero-stage::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(50% 60% at 70% 48%, var(--night-2) 0%, rgb(7 7 10 / 0) 70%);
  }

  /* The lens canvas is fixed over the whole page, above section backgrounds
     and below the text (every .container sits at z-index 2). While a work
     row is hovered it rises above the list like a floating preview. */
  main :global(.lens-canvas) {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 1;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    opacity: 0;
    filter: blur(28px);
  }

  main :global(.lens-canvas.is-ready) {
    filter: blur(0);
    transition: opacity 1600ms var(--ease), filter 2000ms var(--ease);
  }

  main :global(.lens-canvas.is-front) {
    z-index: 3;
  }

  .hero-stage .container,
  .lens-poster {
    position: relative;
    z-index: 2;
  }

  /* Invisible boxes the travelling lens docks to. */
  .lens-anchor {
    display: none;
    pointer-events: none;
  }

  @media (min-width: 861px) {
    .lens-anchor {
      display: block;
    }
    .statement-wrap {
      position: relative;
    }
    .statement-anchor {
      position: absolute;
      top: 50%;
      right: var(--gutter);
      width: clamp(150px, 15vw, 220px);
      aspect-ratio: 1;
      transform: translateY(-50%);
    }
    .work-anchor {
      width: clamp(120px, 11vw, 170px);
      aspect-ratio: 1;
      margin-left: auto;
    }
    .offers-anchor {
      width: clamp(130px, 12vw, 190px);
      aspect-ratio: 1;
      margin-top: 1rem;
    }
    .head-anchor {
      width: clamp(120px, 11vw, 170px);
      aspect-ratio: 1;
      margin-top: 2rem;
    }
  }

  /* The poster paints first and is the LCP image; it sits exactly where the
     lens renders (diameter × 1.3 for the displacement margin) and fades once
     WebGL is ready. It stays for no-WebGL and reduced motion. */
  .lens-poster {
    position: absolute !important;
    left: 76cqw;
    top: 44cqh;
    z-index: 1;
    width: calc(min(58cqh, 38cqw) * 1.3);
    aspect-ratio: 1 / 1;
    transform: translate(-50%, -50%);
    transition: opacity 1200ms var(--ease);
  }

  .lens-poster img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .lens-poster[data-hidden] {
    opacity: 0;
  }

  @media (max-width: 860px) {
    .lens-poster {
      left: 50cqw;
      top: 36cqh;
      width: calc(min(56cqw, 30cqh) * 1.3);
    }
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    padding-block: clamp(0.5rem, 2vw, 1.5rem) clamp(1.75rem, 1rem + 3vh, 3rem);
    pointer-events: none;
  }

  .hero-inner a,
  .hero-inner button {
    pointer-events: auto;
  }

  .hero-title {
    display: flex;
    flex: 1;
    flex-direction: column;
    color: var(--snow);
    font-size: clamp(3.1rem, 1rem + 7.6vw, 8rem);
    line-height: 0.92;
    letter-spacing: -0.05em;
  }

  .hero-kicker {
    display: block;
    margin-bottom: auto;
    color: var(--mute-night);
    font-size: 0.9375rem;
    line-height: 1.5;
    animation: fade-in 1200ms var(--ease) 200ms both;
  }

  .hero-title .line:nth-of-type(1) {
    margin-top: auto;
  }

  .hero-foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-top: clamp(1.25rem, 3vh, 2rem);
  }

  .hero-copy {
    display: grid;
    gap: 1.25rem;
    max-width: 34rem;
    animation: fade-in 1400ms var(--ease) 700ms both;
  }

  .hero-sub {
    max-width: 32ch;
    color: var(--mute-night);
    font-size: 15px;
    line-height: 1.6;
  }

  .hero-link {
    color: var(--snow);
    text-decoration-color: var(--line-night);
  }

  .reel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 260px;
    animation: fade-in 1400ms var(--ease) 900ms both;
  }

  .reel-hint {
    color: var(--mute-night);
  }

  .reel-name {
    min-height: 1.4em;
    color: var(--snow);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .reel-kind {
    color: var(--mute-night);
  }

  .reel-bars {
    display: flex;
    gap: 6px;
  }

  .reel-bars i {
    position: relative;
    flex: 1;
    height: 2px;
    background: var(--line-night);
    overflow: hidden;
  }

  .reel-bars i b {
    position: absolute;
    inset: 0;
    background: var(--snow);
    transform: scaleX(0);
    transform-origin: left;
  }

  .reel-bars i.is-done b {
    transform: scaleX(1);
  }

  .reel-bars i.is-on b {
    transform: scaleX(1);
    transition: transform var(--dwell, 5.5s) linear;
  }

  @media (max-width: 860px) {
    .hero-stage {
      height: clamp(700px, 100svh, 860px);
    }
    .hero-title {
      font-size: clamp(2.7rem, 1rem + 10.5vw, 5rem);
    }
    .hero-foot {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
    .reel-hint {
      display: none;
    }
    .reel {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    main :global(.lens-canvas) {
      display: none;
    }
  }

  /* ── Statement ─────────────────────────────────────────── */
  .statement-section .eyebrow {
    margin-bottom: 1.75rem;
  }

  /* ── Work rows ─────────────────────────────────────────── */
  .work-section {
    padding-top: 0;
  }

  .work-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }

  .work-head-side {
    display: grid;
    justify-items: end;
    gap: 1.25rem;
  }

  .work-head h2 {
    font-size: clamp(2.5rem, 1rem + 6vw, 6rem);
    letter-spacing: -0.05em;
    line-height: 0.95;
  }

  .work-head p {
    color: var(--mute);
  }

  .rows {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .row {
    border-bottom: 1px solid var(--line);
  }

  .row-in {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.5rem;
    padding-block: clamp(1.4rem, 3vw, 2.5rem);
    transition: transform 800ms var(--ease), opacity 600ms;
  }

  .row-in:focus-visible {
    outline-offset: -4px;
  }

  .row-name {
    display: block;
    color: var(--ink);
    font-weight: 500;
    font-size: clamp(1.9rem, 1rem + 5vw, 4.75rem);
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .row-meta {
    display: grid;
    justify-items: end;
    gap: 0.4rem;
    color: var(--mute);
    text-align: right;
  }

  .row-meta .tag {
    display: inline-block;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    color: var(--ink);
  }

  .row-meta .tag.live {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .row-index {
    display: none;
  }

  .row-thumb {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .rows:hover .row-in {
      opacity: 0.28;
    }
    .rows .row:hover .row-in {
      opacity: 1;
      transform: translateX(18px);
    }
  }

  @media (hover: none) {
    .row-thumb {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: var(--radius-lg);
      overflow: hidden;
      margin-top: 1rem;
      background: var(--snow);
    }
    .row-thumb :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  @media (max-width: 860px) {
    .row-in {
      grid-template-columns: minmax(0, 1fr);
    }
    .row-meta {
      justify-items: start;
      text-align: left;
    }
  }

  .work-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    padding-top: 1.5rem;
  }

  .work-foot p {
    max-width: 40rem;
  }

  /* ── Offers ────────────────────────────────────────────── */
  .offers-section {
    padding-top: 0;
  }

  .offers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(3rem, 7vw, 7.5rem);
  }

  .offer {
    display: grid;
    gap: 1.75rem;
    align-content: start;
  }

  .offer .eyebrow {
    margin-bottom: -0.5rem;
  }

  .offer-title {
    font-size: clamp(1.9rem, 1.2rem + 2.4vw, 3.1rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    max-width: 16ch;
  }

  .offer-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  .offer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    color: var(--mute);
  }

  .offer-links a {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 0.35em;
    transition: color 300ms var(--ease);
  }

  .offer-links a:hover {
    color: var(--ink);
  }

  @media (max-width: 860px) {
    .offers {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ── Split sections ────────────────────────────────────── */
  .split {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .split {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
      gap: clamp(3rem, 2rem + 4vw, 6rem);
      align-items: start;
    }
    .split-head {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  .split-head {
    margin-bottom: 0;
    justify-items: start;
  }

  /* ── Process rows ──────────────────────────────────────── */
  .steps {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .step {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
