---
import BrowserFrame from '../components/site/BrowserFrame.astro';
import CtaBand from '../components/site/CtaBand.astro';
import FaqList from '../components/site/FaqList.astro';
import Film from '../components/site/Film.astro';
import FounderCards from '../components/site/FounderCards.astro';
import Icon from '../components/site/Icon.astro';
import IndustryGrid from '../components/site/IndustryGrid.astro';
import LinkCard from '../components/site/LinkCard.astro';
import PricingCards from '../components/site/PricingCards.astro';
import ResponsivePicture from '../components/site/ResponsivePicture.astro';
import WorkCard from '../components/site/WorkCard.astro';
import { homeFaq, keyNumbers, valueProps } from '../content/company';
import { industries } from '../content/industries';
import { packages } from '../content/pricing';
import { processSteps } from '../content/process';
import { services } from '../content/services';
import { getProject } from '../content/work';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CTA_PATHS } from '../lib/cta';
import { FILM_JSON_LD, SEO_ROUTES, SITE_EMAIL, SITE_PHONE_DISPLAY, SITE_TELEPHONE, faqJsonLd } from '../lib/seo';

const [lead, ...concepts] = ['reids-home-and-yard', 'physio-clinic', 'dental-aurelia'].map((id) => getProject(id)!);
const physio = concepts[0];
const stageSizes = '(min-width: 1180px) 900px, 92vw';

const statement =
  'Most local websites look fine and say very little. We build sites that explain what you do, show why you can be trusted and make the next step obvious, on the phone your customer is already holding.';
---

<BaseLayout {...SEO_ROUTES.home} schema={[faqJsonLd(homeFaq), FILM_JSON_LD]} ogImageAlt="Axiom Web — clear, fast websites for local businesses in Kitchener-Waterloo">
  <main id="main-content" tabindex="-1">
    <!-- Hero -->
    <section class="home-hero">
      <div class="hero-atmosphere" aria-hidden="true">
        <div class="hero-beam"></div>
        <div class="hero-aurora"><span></span><span></span><span></span></div>
        <div class="hero-floor"></div>
      </div>

      <div class="container hero-copy">
        <p class="hero-kicker"><span class="kicker-dot" aria-hidden="true"></span>Web design studio in Kitchener-Waterloo</p>
        <h1 class="display hero-title">
          <span class="line"><span>Websites that make</span></span>
          <span class="line"><span>your business the</span></span>
          <span class="line"><span class="accent-text">obvious choice.</span></span>
        </h1>
        <p class="lead">
          Axiom Web designs and builds clear, fast websites for local businesses across Kitchener-Waterloo and Ontario,
          with published pricing from CAD $900 and launch in two to four weeks.
        </p>
        <div class="btn-row hero-actions">
          <a href={CTA_PATHS.startProject} class="btn btn-lg">Start a project <Icon name="arrow-right" /></a>
          <a href="/pricing/" class="btn btn-secondary btn-lg">See pricing</a>
        </div>
        <ul role="list" class="hero-assurances">
          <li><Icon name="check" size={16} strokeWidth={2.4} />Fixed price agreed before work starts</li>
          <li><Icon name="check" size={16} strokeWidth={2.4} />Work directly with the two founders</li>
          <li><Icon name="check" size={16} strokeWidth={2.4} />First year of hosting included</li>
        </ul>
      </div>

      <div class="container stage-wrap">
        <div class="stage">
          <div class="stage-tilt">
            <div class="stage-side">
              <BrowserFrame url="physio.getaxiom.ca">
                <ResponsivePicture source={physio.image} alt={physio.alt} sizes="(min-width: 1180px) 560px, 60vw" position="left top" />
              </BrowserFrame>
              <span class="badge stage-side-badge">Concept build</span>
            </div>
            <div class="stage-main">
              <BrowserFrame url="reidshomeandyard.getaxiom.ca">
                <ResponsivePicture source={lead.image} alt={lead.alt} sizes={stageSizes} loading="eager" position="center top" />
              </BrowserFrame>
              <a class="stage-chip stage-chip-live" href={lead.href} target="_blank" rel="noopener">
                <span class="chip-icon chip-icon-live" aria-hidden="true"><Icon name="rocket" size={18} /></span>
                <span>
                  <span class="chip-label">Client site · Live</span>
                  <span class="chip-title">Reid’s Home &amp; Yard <span class="sr-only">(opens in a new tab)</span></span>
                </span>
              </a>
              <div class="stage-chip stage-chip-time" aria-hidden="true">
                <span class="chip-icon"><Icon name="calendar" size={18} /></span>
                <span>
                  <span class="chip-label">Typical launch</span>
                  <span class="chip-title">2–4 weeks</span>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Who it's for: moves with the page scroll, never on its own -->
    <div class="ribbon" aria-label="Industries we build for">
      <p class="ribbon-label">Built for</p>
      <div class="ribbon-window">
        <div class="ribbon-track">
          {[0, 1].map((copy) => (
            <ul role="list" class="ribbon-list" aria-hidden={copy === 1 ? 'true' : undefined}>
              {industries.map((industry) => (
                <li><Icon name={industry.icon} size={18} />{industry.name}</li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </div>

    <!-- Statement -->
    <section class="section statement-section">
      <div class="container">
        <p class="statement">
          {statement.split(' ').map((word, index) => (
            <>
              <span class="word" style={`--i:${index}`}>{word}</span>{' '}
            </>
          ))}
        </p>
      </div>
    </section>

    <!-- Services -->
    <section class="section section-soft" aria-labelledby="services-title">
      <div class="container">
        <div class="section-head-row reveal">
          <div class="section-head">
            <p class="eyebrow">Services</p>
            <h2 id="services-title">A website built around how your customers decide</h2>
            <p>Whether you need your first proper website or a rebuild of one that no longer fits, the goal is the same: make your business easy to understand, easy to trust and easy to contact.</p>
          </div>
          <a href="/services/" class="arrow-link">All services <Icon name="arrow-right" /></a>
        </div>
        <div class="grid grid-3 reveal-stagger">
          {services.map((service) => (
            <LinkCard href={`/services/${service.slug}/`} icon={service.icon} title={service.name} text={service.cardSummary} />
          ))}
        </div>
      </div>
    </section>

    <!-- Work -->
    <section class="section" aria-labelledby="work-title">
      <div class="container">
        <div class="section-head-row reveal">
          <div class="section-head">
            <p class="eyebrow">Work</p>
            <h2 id="work-title">Recent work</h2>
            <p>A live client website and concept builds that show how we structure sites for different kinds of local businesses.</p>
          </div>
          <a href="/work/" class="arrow-link">View all work <Icon name="arrow-right" /></a>
        </div>
        <div class="work-showcase reveal-stagger">
          <WorkCard project={lead} featured sizes="(min-width: 900px) 60vw, 92vw" />
          <div class="grid grid-2">
            {concepts.map((project) => <WorkCard project={project} sizes="(min-width: 720px) 45vw, 92vw" />)}
          </div>
        </div>
        <p class="work-note">Concept builds are demonstrations designed by Axiom Web and are labelled clearly. They are not client results.</p>
      </div>
    </section>

    <!-- Film -->
    <section class="section film-section" aria-labelledby="film-title">
      <div class="film-light" aria-hidden="true"></div>
      <div class="container">
        <div class="section-head center reveal">
          <p class="eyebrow">Studio film</p>
          <h2 id="film-title">Built to the pixel.</h2>
          <p>Thirty-two seconds on how we approach every website: structure first, then the details most people never notice but every visitor feels.</p>
        </div>
        <div class="film-stage reveal">
          <Film />
        </div>
      </div>
    </section>

    <!-- Why Axiom -->
    <section class="section section-soft" aria-labelledby="why-title">
      <div class="container split">
        <div class="section-head split-head">
          <p class="eyebrow">Why Axiom Web</p>
          <h2 id="why-title">Built properly. Priced plainly.</h2>
          <p>Every website we build follows the same standard, whatever the package. You know the price before we start, and you know who is building your site.</p>
          <a href="/about/" class="arrow-link">About the studio <Icon name="arrow-right" /></a>
        </div>
        <ul role="list" class="value-grid reveal-stagger">
          {valueProps.map((item) => (
            <li class="card value">
              <span class="icon-tile"><Icon name={item.icon} /></span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Numerals -->
    <section class="numerals" aria-labelledby="numerals-title">
      <div class="container">
        <h2 id="numerals-title" class="sr-only">Axiom Web at a glance</h2>
        <ul role="list" class="numerals-grid reveal-stagger">
          {keyNumbers.map((item) => (
            <li>
              <span class="numeral chrome-text">{item.value}</span>
              <span class="numeral-label">{item.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Process -->
    <section class="section" aria-labelledby="process-title">
      <div class="container split">
        <div class="section-head split-head">
          <p class="eyebrow">How it works</p>
          <h2 id="process-title">From first conversation to launch in four steps</h2>
          <p>A simple, predictable process. Scope and price are agreed in writing before design starts, so there are no surprises later.</p>
          <a href="/approach/" class="arrow-link">See the full process <Icon name="arrow-right" /></a>
        </div>
        <div class="rail">
          <span class="rail-line" aria-hidden="true"><span class="rail-fill"></span></span>
          <ol role="list" class="rail-list">
          {processSteps.map((step) => (
            <li class="rail-step">
              <span class="rail-dot" aria-hidden="true"></span>
              <span class="rail-num chrome-text" aria-hidden="true">{step.number}</span>
              <div class="rail-body">
                <p class="rail-timing">Step {Number(step.number)} · {step.timing}</p>
                <h3>{step.title}</h3>
                <p>{step.summary}</p>
              </div>
            </li>
          ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section class="section section-soft pricing-section" aria-labelledby="pricing-title">
      <div class="container">
        <div class="section-head center reveal">
          <p class="eyebrow">Pricing</p>
          <h2 id="pricing-title">Published packages. No guesswork.</h2>
          <p>Choose the package that fits your business today. Every standard package includes first-year hosting, two revision rounds and thirty days of support after launch.</p>
        </div>
        <div class="reveal">
          <PricingCards packages={packages} compact />
        </div>
        <p class="center-link"><a href="/pricing/" class="arrow-link">Compare packages and what’s included <Icon name="arrow-right" /></a></p>
      </div>
    </section>

    <!-- Industries -->
    <section class="section" aria-labelledby="industries-title">
      <div class="container">
        <div class="section-head-row reveal">
          <div class="section-head">
            <p class="eyebrow">Industries</p>
            <h2 id="industries-title">Websites for local service businesses</h2>
            <p>Different businesses win customers in different ways. We plan each site around what your buyers need to see before they get in touch.</p>
          </div>
          <a href="/industries/" class="arrow-link">All industries <Icon name="arrow-right" /></a>
        </div>
        <div class="reveal">
          <IndustryGrid />
        </div>
      </div>
    </section>

    <!-- Founders -->
    <section class="section section-soft" aria-labelledby="team-title">
      <div class="container split">
        <div class="section-head split-head">
          <p class="eyebrow">Who you’ll work with</p>
          <h2 id="team-title">Two founders. No account managers.</h2>
          <p>
            Aidan Magee and Riley Hinsperger are the co-founders of Axiom Web, the web-focused subsidiary of Axiom International.
            You work directly with the people who plan, design and build your website.
          </p>
          <a href="/about/" class="arrow-link">Meet the founders <Icon name="arrow-right" /></a>
        </div>
        <div class="reveal">
          <FounderCards />
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section" aria-labelledby="faq-title">
      <div class="container split">
        <div class="section-head split-head">
          <p class="eyebrow">FAQ</p>
          <h2 id="faq-title">Common questions</h2>
          <p>Straight answers about cost, timing and what working with us looks like.</p>
          <div class="faq-contact">
            <p class="small muted">Still have a question?</p>
            <a class="text-link" href={`tel:${SITE_TELEPHONE}`}>{SITE_PHONE_DISPLAY}</a>
            <a class="text-link" href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>
          </div>
        </div>
        <FaqList items={homeFaq} openFirst />
      </div>
    </section>

    <CtaBand title="Let’s make your business the obvious choice." />
  </main>
</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────── */
  .home-hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(3rem, 1rem + 6vh, 6rem);
    isolation: isolate;
  }

  .hero-atmosphere {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  /* A single cone of light from above the headline. */
  .hero-beam {
    position: absolute;
    top: -20%;
    left: 50%;
    width: min(140rem, 220vw);
    height: 110%;
    transform: translateX(-50%);
    background: conic-gradient(
      from 180deg at 50% 0%,
      transparent 152deg,
      rgb(130 160 255 / 0.1) 172deg,
      rgb(170 195 255 / 0.16) 180deg,
      rgb(130 160 255 / 0.1) 188deg,
      transparent 208deg
    );
    mask-image: linear-gradient(180deg, #000 30%, transparent 85%);
  }

  .hero-aurora span {
    position: absolute;
    border-radius: 50%;
  }

  .hero-aurora span:nth-child(1) {
    top: 2%;
    left: 50%;
    width: 64rem;
    height: 34rem;
    margin-left: -32rem;
    background: radial-gradient(closest-side, rgb(58 108 240 / 0.34), transparent);
  }

  .hero-aurora span:nth-child(2) {
    top: 26%;
    left: 8%;
    width: 38rem;
    height: 28rem;
    background: radial-gradient(closest-side, rgb(110 90 255 / 0.16), transparent);
  }

  .hero-aurora span:nth-child(3) {
    top: 18%;
    right: 4%;
    width: 40rem;
    height: 30rem;
    background: radial-gradient(closest-side, rgb(60 170 255 / 0.13), transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-aurora span:nth-child(1) {
      animation: aurora-a 18s ease-in-out infinite alternate;
    }
    .hero-aurora span:nth-child(2) {
      animation: aurora-b 22s ease-in-out infinite alternate;
    }
    .hero-aurora span:nth-child(3) {
      animation: aurora-b 26s ease-in-out -8s infinite alternate-reverse;
    }
  }

  @keyframes aurora-a {
    to {
      transform: translate3d(4%, 6%, 0) scale(1.08);
    }
  }

  @keyframes aurora-b {
    to {
      transform: translate3d(-10%, -8%, 0) scale(1.15);
    }
  }

  /* A perspective grid floor the work stage stands on. */
  .hero-floor {
    position: absolute;
    right: -50%;
    bottom: 0;
    left: -50%;
    height: 62%;
    background-image:
      linear-gradient(rgb(140 170 255 / 0.16) 1px, transparent 1px),
      linear-gradient(90deg, rgb(140 170 255 / 0.16) 1px, transparent 1px);
    background-size: 84px 84px;
    background-position: center top;
    transform: perspective(640px) rotateX(64deg);
    transform-origin: 50% 100%;
    mask-image: linear-gradient(0deg, #000 0%, rgb(0 0 0 / 0.5) 40%, transparent 80%);
  }

  .hero-copy {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 1rem 0.45rem 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.04);
    color: var(--ink-2);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.01em;
    backdrop-filter: blur(10px);
  }

  .kicker-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--success);
    box-shadow: 0 0 0 4px rgb(95 216 160 / 0.15), 0 0 12px var(--success);
  }

  /* Each line has its own chrome finish so it can rise independently. */
  .hero-title {
    max-width: 14ch;
    font-size: clamp(2.75rem, 1.2rem + 5.6vw, 5.75rem);
    background: none;
    color: var(--ink);
  }

  .hero-title .line {
    display: block;
    padding-bottom: 0.06em;
    overflow: hidden;
  }

  .hero-title .line > span {
    display: inline-block;
    padding-inline: 0.04em;
    background: var(--chrome);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-title .line > .accent-text {
    background: var(--chrome-accent);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .hero-copy .lead {
    max-width: 40rem;
  }

  .hero-actions {
    justify-content: center;
    margin-top: 0.25rem;
  }

  .hero-assurances {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    margin: 0.25rem 0 0;
    color: var(--text);
    font-size: var(--fs-sm);
  }

  .hero-assurances li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hero-assurances :global(svg) {
    flex: none;
    color: var(--success);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-kicker,
    .hero-copy .lead,
    .hero-actions,
    .hero-assurances {
      animation: hero-fade 1000ms var(--ease-out) both;
    }
    .hero-kicker {
      animation-delay: 50ms;
    }
    .hero-title .line > span {
      animation: line-rise 950ms var(--ease-out) both;
    }
    .hero-title .line:nth-child(1) > span {
      animation-delay: 60ms;
    }
    .hero-title .line:nth-child(2) > span {
      animation-delay: 140ms;
    }
    .hero-title .line:nth-child(3) > span {
      animation-delay: 220ms;
    }
    .hero-copy .lead {
      animation-delay: 380ms;
    }
    .hero-actions {
      animation-delay: 460ms;
    }
    .hero-assurances {
      animation-delay: 540ms;
    }
    .stage {
      animation: stage-in 1300ms var(--ease-out) 420ms both;
    }
  }

  @keyframes line-rise {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translateY(16px);
      filter: blur(8px);
    }
  }

  @keyframes stage-in {
    from {
      opacity: 0;
      transform: translateY(80px);
    }
  }

  /* ── Work stage ───────────────────────────────────────── */
  .stage-wrap {
    position: relative;
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
  }

  .stage {
    position: relative;
    max-width: 66rem;
    margin-inline: auto;
    perspective: 2200px;
  }

  .stage-tilt {
    position: relative;
    padding-top: 7%;
    transform-origin: 50% 0%;
    transform-style: preserve-3d;
  }

  /* The stage flattens toward the reader as the page scrolls. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .stage-tilt {
        animation: stage-flatten linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 50%;
      }
    }
  }

  @keyframes stage-flatten {
    from {
      transform: rotateX(26deg) scale(0.9);
    }
    to {
      transform: none;
    }
  }

  .stage-main {
    position: relative;
    width: 84%;
    margin-left: auto;
  }

  .stage-main :global(.browser) {
    box-shadow:
      0 80px 160px -40px rgb(0 0 0 / 0.95),
      0 0 0 1px rgb(255 255 255 / 0.06),
      0 -20px 120px -30px rgb(80 120 255 / 0.45);
  }

  .stage-side {
    position: absolute;
    top: 0;
    left: 0;
    width: 52%;
    opacity: 0.75;
    filter: brightness(0.7) saturate(0.9);
    transform: translateZ(-60px);
  }

  .stage-side-badge {
    position: absolute;
    top: 3.1rem;
    left: 0.85rem;
  }

  .stage-chip {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1rem 0.7rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: 16px;
    background: rgb(12 17 30 / 0.78);
    box-shadow: var(--shadow-lg), inset 0 1px 0 rgb(255 255 255 / 0.08);
    font-size: var(--fs-xs);
    line-height: 1.3;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .stage-chip-live {
    bottom: 30%;
    left: -1.5rem;
    transition: transform 300ms var(--ease-out), border-color 300ms var(--ease);
  }

  .stage-chip-live:hover {
    transform: translateY(-3px);
    border-color: rgb(95 216 160 / 0.5);
  }

  .stage-chip-time {
    top: 22%;
    right: -1.5rem;
  }

  .chip-icon {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    border: 1px solid var(--brand-line);
    border-radius: 10px;
    background: rgb(64 108 255 / 0.14);
    color: var(--brand-ink);
  }

  .chip-icon-live {
    border-color: rgb(95 216 160 / 0.35);
    background: var(--success-soft);
    color: var(--success);
  }

  .chip-label {
    display: block;
    color: var(--text-muted);
    font-weight: 500;
  }

  .chip-title {
    display: block;
    color: var(--ink);
    font-size: var(--fs-sm);
    font-weight: 650;
  }

  /* The screenshot fades into the floor; the chips stay above the fade. */
  .stage-main::before {
    content: '';
    position: absolute;
    right: -2px;
    bottom: -2px;
    left: -2px;
    height: 42%;
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    background: linear-gradient(180deg, transparent, var(--bg-soft) 96%);
    pointer-events: none;
  }

  @media (max-width: 719px) {
    .stage-side {
      display: none;
    }
    .stage-tilt {
      padding-top: 0;
    }
    .stage-main {
      width: 100%;
    }
    .stage-chip-time {
      display: none;
    }
    .stage-chip-live {
      bottom: 22%;
      left: 0.75rem;
    }
  }

  /* ── Ribbon ───────────────────────────────────────────── */
  .ribbon {
    position: relative;
    display: grid;
    gap: 1rem;
