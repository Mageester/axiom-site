  }

  .ax-root .ax-reveal--title { transition-duration: 1.45s; }
  .ax-root .ax-reveal--statement { transition-duration: 1.5s; }
  .ax-root .ax-reveal--final { transition-duration: 1.35s; }
  .ax-root .ax-reveal--rule {
    transition: opacity 900ms var(--ease-premium), transform 1.15s var(--ease-cinematic);
    transition-delay: var(--reveal-delay, 0ms);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .ax-root .ax-reveal--title:not(.is-in) { opacity: 0; transform: translate3d(0, 1.1rem, 0) !important; clip-path: none !important; }
    :global(html.js) .ax-root .ax-reveal--statement:not(.is-in) { opacity: 0; transform: translate3d(0, 1.2rem, 0) !important; }
    :global(html.js) .ax-root .ax-reveal--copy:not(.is-in) { opacity: 0; transform: translate3d(0, 1rem, 0) !important; }
    :global(html.js) .ax-root .ax-reveal--item:not(.is-in) { opacity: 0; transform: translate3d(0, 1rem, 0) !important; }
    :global(html.js) .ax-root .ax-reveal--row:not(.is-in) { opacity: 0; transform: translate3d(0, 1rem, 0) !important; }
    :global(html.js) .ax-root .ax-reveal--metric:not(.is-in) { opacity: 0; transform: translate3d(0, 1rem, 0) !important; }
    :global(html.js) .ax-root .ax-reveal--step:not(.is-in) { opacity: 0; transform: translate3d(0, 1rem, 0) !important; }
    :global(html.js) .ax-root .ax-reveal--final:not(.is-in) { opacity: 0; transform: translate3d(0, 1.15rem, 0) !important; }
    :global(html.js) .ax-root .ax-reveal--rule:not(.is-in) { opacity: 0; transform: scaleX(0.28); transform-origin: left center; }

    :global(html.js) .ax-root .ax-hero-title .ax-mask {
      animation: ax-title-card-reveal-pro 1.55s var(--ease-cinematic) both;
      animation-delay: calc(140ms + (var(--i, 0) * 190ms));
    }

    :global(html.js) .ax-root .ax-hero-actions.ax-load {
      animation: ax-hero-support-reveal-pro 900ms var(--ease-cinematic) 820ms both;
    }

    :global(html.js) .ax-root .ax-hero-foot > .ax-lead.ax-load {
      animation: ax-hero-support-reveal-pro 900ms var(--ease-cinematic) 980ms both;
    }

    :global(html.js) .ax-root .ax-hero::before { animation: ax-line-in 1.6s var(--ease-cinematic) 220ms both; }
  }

  @keyframes ax-title-card-reveal-pro {
    0% { opacity: 0; transform: translate3d(0, 1.15em, 0); filter: blur(6px); }
    55% { opacity: 1; transform: translate3d(0, 0, 0); filter: blur(0); }
    100% { opacity: 1; transform: none; filter: blur(0); }
  }

  @keyframes ax-hero-support-reveal-pro {
    0% { opacity: 0; transform: translate3d(0, 0.8rem, 0); }
    68% { opacity: 1; transform: translate3d(0, 0, 0); }
    100% { opacity: 1; transform: none; }
  }

  /* The statement is the first contrast change after the opening frame. */
  .ax-root .ax-statement::before,
  .ax-root .ax-statement::after { background: rgba(10, 10, 10, 0.34); }
  .ax-root .ax-statement-line--resolve { position: relative; }
  .ax-root .ax-statement-line--resolve::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0.04em;
    left: 0;
    height: 0.06em;
    background: rgba(10, 10, 10, 0.68);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 1.2s var(--ease-cinematic);
  }
  .ax-root .ax-big.is-in .ax-statement-line--resolve::after { transform: scaleX(1); }

  /* The three standards disclose like an editorial index, not a card grid. */
  .ax-root .ax-solution-item::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--text-primary), transparent 78%);
    opacity: 0.34;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 1.25s var(--ease-cinematic), opacity 700ms var(--ease-premium);
  }
  .ax-root .ax-solution-item.is-in::after { opacity: 0.72; transform: scaleX(1); }
  .ax-root .ax-item-index { transition: color 700ms var(--ease-premium), letter-spacing 900ms var(--ease-cinematic); }
  .ax-root .ax-solution-item.is-in .ax-item-index { color: var(--text-primary); letter-spacing: 0.22em; }

  /* Work is the visual anchor: reveal the frame, then let the photograph settle. */
  .ax-root .ax-work-feature { clip-path: inset(0 0 12% 0) !important; }
  .ax-root .ax-work-feature.is-active { clip-path: inset(0) !important; }
  .ax-root .ax-work-feature-img {
    transform: scale(1.09) !important;
    filter: grayscale(0.16) brightness(0.9);
    transition: transform 1.9s var(--ease-cinematic), filter 1.15s var(--ease-premium);
  }
  .ax-root .ax-work-feature.is-active .ax-work-feature-img { transform: scale(1) !important; filter: grayscale(0) brightness(1); }
  .ax-root .ax-work-feature-frame::before {
    content: '';
    position: absolute;
    z-index: 2;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 58%, rgba(0, 0, 0, 0.28));
  }

  /* Index rows gain a readable active edge and a controlled arrow lift. */
  .ax-root .ax-row-num { transition: color 700ms var(--ease-premium), transform 700ms var(--ease-cinematic); }
  .ax-root .ax-list > li.is-in .ax-row-num { color: var(--text-primary); transform: translateX(0.2rem); }
  .ax-root .ax-list > li.is-in .ax-row-arrow { color: var(--text-primary); }
  .ax-root .ax-scene--index .ax-list > li.is-in .ax-row-num,
  .ax-root .ax-scene--index .ax-list > li.is-in .ax-row-arrow { color: var(--bg-base); }

  /* Principle numbers make the split section scan instead of stack. */
  .ax-root .ax-principle-num { transition: color 700ms var(--ease-premium), transform 700ms var(--ease-cinematic); }
  .ax-root .ax-principle.is-in .ax-principle-num { color: var(--text-primary); transform: translateX(0.2rem); }

  /* The metric strip is the second contrast change: a quiet paper-white beat. */
  .ax-root .ax-scene--metrics::before,
  .ax-root .ax-scene--metrics::after { background: rgba(10, 10, 10, 0.28); }
  .ax-root .ax-scene--metrics .ax-figure-num,
  .ax-root .ax-scene--metrics .ax-figure-label { display: block; }
  :global(html.js) .ax-root .ax-scene--metrics .ax-figure { animation: none; }
  :global(html.js) .ax-root .ax-scene--metrics .ax-figure.is-in .ax-figure-num {
    animation: ax-metric-settle-pro 1.45s var(--ease-cinematic) both;
    animation-delay: calc(180ms + (var(--scene-index, 0) * 170ms));
  }
  :global(html.js) .ax-root .ax-scene--metrics .ax-figure.is-in .ax-figure-label {
    animation: ax-metric-label-pro 1.05s var(--ease-premium) both;
    animation-delay: calc(420ms + (var(--scene-index, 0) * 170ms));
  }

  @keyframes ax-metric-settle-pro {
    0% { opacity: 0; transform: translate3d(0, 1rem, 0) scale(0.94); }
    62% { opacity: 1; transform: translate3d(0, 0, 0) scale(1.035); }
    100% { opacity: 1; transform: none; }
  }

  @keyframes ax-metric-label-pro {
    from { opacity: 0; transform: translate3d(0, 0.5rem, 0); letter-spacing: 0.2em; }
    to { opacity: 1; transform: none; letter-spacing: 0.1em; }
  }

  /* Process is the only looping accent: one live node tells the eye where to look. */
  .ax-root .ax-step.is-current .ax-step-node {
    animation: ax-node-pulse 2.8s ease-in-out infinite;
  }

  .ax-root .ax-step.is-complete .ax-step-node { background: var(--text-primary); transform: scale(1); }

  @keyframes ax-node-pulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(10, 10, 10, 0.06); }
    50% { box-shadow: 0 0 0 8px rgba(10, 10, 10, 0.14); }
  }

  /* The final frame earns its emphasis from scale and timing, not decoration. */
  .ax-root .ax-final-mega { letter-spacing: -0.035em; }
  .ax-root .ax-final .btn-primary { box-shadow: 0 10px 30px rgba(242, 240, 234, 0.08); }

  @media (max-width: 759px) {
    .ax-root .ax-hero { min-height: calc(100svh - 4rem); }
    .ax-root .ax-section-index { margin-bottom: 2.25rem; }
    .ax-root .ax-scene--metrics .ax-figures { gap: 1.75rem 1.25rem; }
    .ax-root .ax-work-feature-frame::before { background: linear-gradient(180deg, transparent 46%, rgba(0, 0, 0, 0.32)); }
    .ax-root .ax-work-feature-frame::after { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ax-root .ax-hero-title .ax-mask,
    .ax-root .ax-hero-actions.ax-load,
    .ax-root .ax-hero-foot > .ax-lead.ax-load,
    .ax-root .ax-work-feature-img,
    .ax-root .ax-figure-num,
    .ax-root .ax-figure-label,
    .ax-root .ax-step.is-current .ax-step-node { animation: none !important; }
    .ax-root .ax-work-feature,
    .ax-root .ax-work-feature.is-active,
    .ax-root .ax-figure-num,
    .ax-root .ax-figure-label { transform: none !important; clip-path: none !important; opacity: 1 !important; }
    .ax-root .ax-statement-line--resolve::after { transform: scaleX(1); transition: none; }
  }
</style>

<script>
  type HomeWindow = Window & { __axiomHomeCleanup?: () => void };

  const initAxiomHomepage = () => {
    const root = document.querySelector<HTMLElement>('[data-homepage]');
    const homeWindow = window as HomeWindow;

    if (!root) {
      homeWindow.__axiomHomeCleanup?.();
      homeWindow.__axiomHomeCleanup = undefined;
      return;
    }

    if (root.dataset.homeMotionReady === 'true') return;

    homeWindow.__axiomHomeCleanup?.();
    root.dataset.homeMotionReady = 'true';

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const triggers = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-work-trigger]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-work-panel]'));
    const features = Array.from(root.querySelectorAll<HTMLElement>('[data-work-feature]'));
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-work-item]'));
    const scenes = Array.from(root.querySelectorAll<HTMLElement>('[data-cinematic-scene]'));
    const panelTimers = new WeakMap<HTMLElement, number>();
    const processTrack = root.querySelector<HTMLElement>('[data-process-track]');
    const processSteps = Array.from(root.querySelectorAll<HTMLElement>('[data-process-step]'));
    const homeFooter = document.querySelector<HTMLElement>('.site-footer');
    let scrollFrame = 0;

    homeFooter?.setAttribute('data-home-footer', 'true');

    const setPanelLinkState = (panel: HTMLElement, enabled: boolean) => {
      panel.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
        if (enabled) link.removeAttribute('tabindex');
        else link.tabIndex = -1;
      });
    };

    const cancelPanelTimer = (panel: HTMLElement) => {
      const timer = panelTimers.get(panel);
      if (timer !== undefined) {
        window.clearTimeout(timer);
        panelTimers.delete(panel);
      }
    };

    const setPanelOpen = (panel: HTMLElement, open: boolean) => {
      cancelPanelTimer(panel);

      if (open) {
        panel.hidden = false;
        panel.setAttribute('aria-hidden', 'false');
        setPanelLinkState(panel, true);
        if (reducedMotion) {
          panel.classList.add('is-open');
        } else {
          window.requestAnimationFrame(() => panel.classList.add('is-open'));
        }
        return;
      }

      panel.classList.remove('is-open');
      panel.setAttribute('aria-hidden', 'true');
      setPanelLinkState(panel, false);

      if (reducedMotion) {
        panel.hidden = true;
        return;
      }

      const timer = window.setTimeout(() => {
        if (!panel.classList.contains('is-open')) panel.hidden = true;
        panelTimers.delete(panel);
      }, 440);
      panelTimers.set(panel, timer);
    };

    const setWorkActive = (activeId: string) => {
      triggers.forEach((trigger) => {
        const isActive = trigger.dataset.workTrigger === activeId;
        trigger.setAttribute('aria-expanded', String(isActive));
      });

      items.forEach((item) => {
        const trigger = item.querySelector<HTMLButtonElement>('[data-work-trigger]');
        item.classList.toggle('is-open', trigger?.dataset.workTrigger === activeId);
      });

      panels.forEach((panel) => {
        setPanelOpen(panel, panel.dataset.workPanel === activeId);
      });

      features.forEach((feature) => {
        const isActive = feature.dataset.workFeature === activeId;
        feature.classList.toggle('is-active', isActive);
        feature.setAttribute('aria-hidden', String(!isActive));
      });

      root.dataset.activeWork = activeId;
    };

    triggers.forEach((trigger, index) => {
      trigger.addEventListener('click', () => {
        const activeId = trigger.dataset.workTrigger;
        if (activeId && activeId !== root.dataset.activeWork) setWorkActive(activeId);
      });

      trigger.addEventListener('keydown', (event) => {
        let nextIndex = index;
        if (event.key === 'ArrowDown') nextIndex = (index + 1) % triggers.length;
        if (event.key === 'ArrowUp') nextIndex = (index - 1 + triggers.length) % triggers.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = triggers.length - 1;
        if (nextIndex === index) return;
        event.preventDefault();
        triggers[nextIndex]?.focus();
      });
    });

    const clamp = (value: number) => Math.min(Math.max(value, 0), 1);

    const updateScrollState = () => {
      scrollFrame = 0;
      const documentRange = document.documentElement.scrollHeight - window.innerHeight;
      root.style.setProperty('--page-progress', String(documentRange > 0 ? clamp(window.scrollY / documentRange) : 0));

      const viewportHeight = Math.max(window.innerHeight, 1);
      const viewportStart = viewportHeight * 0.86;
      const viewportEnd = viewportHeight * 0.22;
      let activeScene = '';
      let activeScore = Number.NEGATIVE_INFINITY;

      scenes.forEach((scene) => {
        const rect = scene.getBoundingClientRect();
        const sceneRange = Math.max(rect.height + viewportStart - viewportEnd, 1);
        const sceneProgress = clamp((viewportStart - rect.top) / sceneRange);

        scene.style.setProperty('--scene-progress', String(sceneProgress));
        scene.dataset.scenePhase = sceneProgress < 0.24 ? 'enter' : sceneProgress > 0.78 ? 'exit' : 'hold';

        const visibleTop = Math.max(rect.top, 0);
        const visibleBottom = Math.min(rect.bottom, viewportHeight);
        const visibleHeight = Math.max(0, visibleBottom - visibleTop);
        const isInScene = rect.top <= viewportHeight * 0.62 && rect.bottom >= viewportHeight * 0.28;
        const centerDistance = Math.abs((rect.top + rect.bottom) / 2 - viewportHeight * 0.48);
        const score = visibleHeight - centerDistance * 0.02;
        if (isInScene && score > activeScore) {
          activeScore = score;
          activeScene = scene.dataset.cinematicScene || '';
        }
      });

      scenes.forEach((scene) => {
        scene.classList.toggle('is-scene-active', scene.dataset.cinematicScene === activeScene);
      });
      if (activeScene) root.dataset.activeScene = activeScene;

      if (homeFooter) {
        const footerRect = homeFooter.getBoundingClientRect();
        const footerRange = Math.max(footerRect.height + viewportHeight * 0.9 - viewportHeight * 0.2, 1);
        const footerProgress = clamp((viewportHeight * 0.9 - footerRect.top) / footerRange);
        homeFooter.style.setProperty('--footer-progress', String(footerProgress));
        homeFooter.classList.toggle(
          'is-footer-active',
          footerRect.top <= viewportHeight * 0.78 && footerRect.bottom >= viewportHeight * 0.2
        );
      }

      if (!processTrack) return;

      const trackRect = processTrack.getBoundingClientRect();
      const processViewportStart = viewportHeight * 0.8;
      const processViewportEnd = viewportHeight * 0.22;
      const trackRange = Math.max(trackRect.height + processViewportStart - processViewportEnd, 1);
      const processProgress = clamp((processViewportStart - trackRect.top) / trackRange);
      processTrack.style.setProperty('--process-progress', String(processProgress));

      const activeStepIndex = Math.min(
        processSteps.length - 1,
        Math.floor(processProgress * processSteps.length)
      );
      processSteps.forEach((step, index) => {
        step.classList.toggle('is-current', index === activeStepIndex);
        step.classList.toggle('is-complete', index < activeStepIndex);
        const stepProgress = clamp(
          (processProgress - index / Math.max(processSteps.length, 1)) * Math.max(processSteps.length, 1)
        );
        step.style.setProperty('--step-progress', String(stepProgress));
      });
    };

    const requestScrollState = () => {
      if (scrollFrame) return;
      scrollFrame = window.requestAnimationFrame(updateScrollState);
    };

    window.addEventListener('scroll', requestScrollState, { passive: true });
    window.addEventListener('resize', requestScrollState, { passive: true });
    updateScrollState();

    homeWindow.__axiomHomeCleanup = () => {
      window.removeEventListener('scroll', requestScrollState);
      window.removeEventListener('resize', requestScrollState);
      if (scrollFrame) window.cancelAnimationFrame(scrollFrame);
      scenes.forEach((scene) => {
        scene.classList.remove('is-scene-active');
        delete scene.dataset.scenePhase;
        scene.style.removeProperty('--scene-progress');
      });
      processSteps.forEach((step) => step.classList.remove('is-current', 'is-complete'));
      homeFooter?.removeAttribute('data-home-footer');
      homeFooter?.classList.remove('is-footer-active');
      homeFooter?.style.removeProperty('--footer-progress');
      homeFooter?.style.removeProperty('--footer-drift');
      root.dataset.homeMotionReady = 'false';
    };
  };

  document.addEventListener('astro:page-load', initAxiomHomepage);
  if (document.readyState !== 'loading') initAxiomHomepage();
</script>
