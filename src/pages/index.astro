---
import ResponsivePicture from '../components/site/ResponsivePicture.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { CTA_PATHS } from '../lib/cta';
import { HOME_JSON_LD, WEBSITE_SCHEMA, SEO_ROUTES } from '../lib/seo';
import { getWorkProofImage } from '../lib/workProofImages';

const work = [
  {
    sector: 'Dental',
    title: 'Aurelia Dental Studio',
    outcome: 'Clear, warm, and easy to navigate. New patients find what they need and book without second-guessing.',
    img: getWorkProofImage('concept-dental-demo'),
  },
  {
    sector: 'Beauty',
    title: 'Nails Studio',
    outcome: 'Booking is visible early, services are easy to compare, and the brand reads calm and polished.',
    img: getWorkProofImage('concept-salon-demo'),
  },
  {
    sector: 'Grooming',
    title: 'Blackline Barber Co.',
    outcome: 'Fast, sharp, and direct. Clients get to the booking button in seconds — no hunting required.',
    img: getWorkProofImage('concept-barber-demo'),
  },
] as const;

const services = [
  {
    num: '01',
    label: 'Conversion Sites',
    description: 'For service businesses that need a clearer offer, stronger trust signals, and fewer steps from visit to inquiry.',
    href: '/services#conversion-sites',
  },
  {
    num: '02',
    label: 'Local Business Websites',
    description: 'For companies whose reputation, service quality, and contact path need to be obvious on every device.',
    href: '/services#local-business-websites',
  },
  {
    num: '03',
    label: 'Rebuilds',
    description: 'Replace a dated or confusing site while protecting useful content, redirects, domains, and buyer trust.',
    href: '/services#rebuilds',
  },
] as const;

// Honest capability band — what we actually deliver, not fabricated client logos.
const marquee = [
  'Custom code — never templates',
  'Sub-one-second load',
  'Mobile-first by default',
  'Built to get you booked',
  'Managed hosting & security',
  'Direct line to the makers',
  'Clean, maintainable builds',
  '30-day delivery',
] as const;

const solution = [
  { title: 'Understood in seconds', description: 'What you do, who you help, and how to book — clear the moment someone lands. No scrolling to figure you out.' },
  { title: 'Trusted where it counts', description: 'Real reviews, credentials, and proof placed exactly where a visitor decides whether to call you.' },
  { title: 'Fast enough to convert', description: 'Sub-second loads on the phones your customers actually use, so nobody bounces before they reach the button.' },
] as const;

const principles = [
  { num: '01', title: 'Visitors get it in seconds', description: 'People should understand what you do, who you help, and how to book the moment they land — no scrolling around, no guessing.' },
  { num: '02', title: 'Built to earn trust', description: 'Real reviews, credentials, and proof go exactly where people decide whether to call you. We never make up numbers or fake testimonials.' },
  { num: '03', title: 'Fast on every phone', description: 'Most of your visitors are on their phone. Your site loads in under a second and looks sharp on every screen — so nobody bounces.' },
  { num: '04', title: 'Looked after, even after launch', description: "We handle the hosting, the security, and the small updates. When something's needed, you message the two people who built it — not a ticket queue." },
] as const;

const figures = [
  { value: 'Under 1s', label: 'Load time, every build' },
  { value: 'Two', label: 'Partners, zero middlemen' },
  { value: '~30 days', label: 'From kickoff to launch' },
  { value: '$0', label: 'Down to get started' },
] as const;

const process = [
  { num: '01', title: 'Diagnostics', description: 'We audit your brand, copy, and where visitors drop off — and define exactly what the site needs to do.' },
  { num: '02', title: 'Blueprint', description: 'We map every page, the flow, and the exact words. The whole plan is approved before a line of code is written.' },
  { num: '03', title: 'Build', description: 'Custom, lightweight code. No templates, no bloated plugins, no performance compromises.' },
  { num: '04', title: 'Launch & handoff', description: 'Speed, mobile, and DNS checks, then a clean handoff — with managed hosting if you want it.' },
] as const;

const team = [
  { name: 'Aidan', role: 'Strategy & scope', description: 'Shapes the message and the structure so the site maps to exactly how your customers decide.' },
  { name: 'Riley', role: 'Engineering & delivery', description: 'Builds the site itself — obsessed with speed, clean code, and how it feels on a phone.' },
] as const;

// Headline split into lines for the masked, staggered reveal.
const heroLines = ['Websites that get', 'local businesses'] as const;
---

<SiteLayout
  title={SEO_ROUTES.home.title}
  description={SEO_ROUTES.home.description}
  canonicalPath="/"
  ogImageAlt="Axiom — web design studio in Kitchener-Waterloo."
  schema={[HOME_JSON_LD, WEBSITE_SCHEMA]}
>
  <main id="main-content" tabindex="-1" class="ax-root">
    <!-- ░░ CINEMATIC HERO ░░ -->
    <section class="ax-hero" id="ax-hero">
      <div class="ax-hero-bg" aria-hidden="true">
        <canvas id="ax-hero-canvas" class="ax-hero-canvas"></canvas>
        <div class="ax-hero-grid" data-parallax="0.04"></div>
        <div class="ax-hero-glow" data-parallax="0.12"></div>
        <div class="ax-hero-aurora" data-parallax="0.08"></div>
        <div class="ax-hero-vignette"></div>
      </div>

      <div class="ax-container ax-hero-inner">
        <div class="ax-masthead ax-load" style="--i: 0">
          <span>Web Design Studio</span>
          <span class="ax-sep">/</span>
          <span>Kitchener · Waterloo, ON</span>
          <span class="ax-sep">/</span>
          <span>Est. 2024</span>
          <span class="ax-avail"><i></i>Now booking — 2 slots</span>
        </div>

        <h1 class="ax-mega ax-hero-title">
          {heroLines.map((line, i) => (
            <span class="ax-line"><span class="ax-line-inner ax-mask" style={`--i: ${i + 1}`}>{line}</span></span>
          ))}
          <span class="ax-line"><span class="ax-line-inner ax-mask" style="--i: 3"><em>booked.</em></span></span>
        </h1>

        <div class="ax-hero-foot">
          <div class="ax-hero-actions ax-load" style="--i: 5">
            <a href={CTA_PATHS.startProject} class="ax-cta" data-magnetic>Start a project <span aria-hidden="true">→</span></a>
            <a href="/work" class="ax-textlink">See the work</a>
          </div>
          <p class="ax-lead ax-load" style="--i: 6">
            Custom websites for established local businesses — built to look the part on every phone, load in under a second, and turn visitors into booked clients. You work directly with the two people who design and build it.
          </p>
        </div>
      </div>

      <a href="#ax-statement" class="ax-scroll-cue ax-load" style="--i: 7" aria-label="Scroll to content">
        <span class="ax-scroll-line"><span></span></span>
        <span class="ax-scroll-label">Scroll</span>
      </a>
    </section>

    <!-- ░░ CAPABILITY MARQUEE BAND ░░ -->
    <section class="ax-marquee-band" aria-label="What every Axiom build includes">
      <div class="ax-marquee" aria-hidden="true">
        <div class="ax-marquee-track">
          {[...marquee, ...marquee].map((item) => (
            <span class="ax-marquee-item"><i class="ax-marquee-dot"></i>{item}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- ░░ PROBLEM ░░ -->
    <section class="ax-statement" id="ax-statement">
      <div class="ax-container">
        <span class="ax-index" data-reveal data-motion="eyebrow">№ 01 — The problem</span>
        <p class="ax-big" data-reveal data-motion="editorialMaskReveal">
          Most local businesses lose customers to a website that looks like an afterthought.
          <em>We make yours the reason they call.</em>
        </p>
      </div>
    </section>

    <!-- ░░ SOLUTION ░░ -->
    <section class="ax-section">
      <div class="ax-container">
        <header class="ax-head">
          <span class="ax-label" data-reveal data-motion="eyebrow">№ 02 — The fix</span>
          <h2 class="ax-h2" data-reveal data-motion="editorial">A site that does the <em>quiet, important work</em></h2>
          <p class="ax-head-note" data-reveal data-motion="editorial" style="--reveal-delay: 80ms">
            We rebuild the version of your business that earns the click — composed, credible, and fast enough that the decision to call feels obvious.
          </p>
        </header>

        <div class="ax-solution">
          {solution.map((s, i) => (
            <div class="ax-solution-item" data-reveal data-motion="depth" style={`--reveal-delay: ${i * 110}ms`}>
              <span class="ax-solution-num">0{i + 1}</span>
              <h3 class="ax-solution-title">{s.title}</h3>
              <p class="ax-solution-desc">{s.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ░░ WORK ░░ -->
    <section class="ax-section">
      <div class="ax-container">
        <header class="ax-head">
          <span class="ax-label" data-reveal data-motion="eyebrow">Selected work · 2024–25</span>
          <h2 class="ax-h2" data-reveal data-motion="editorial">The kind of site <em>you'll get</em></h2>
          <p class="ax-head-note" data-reveal data-motion="editorial" style="--reveal-delay: 80ms">Concept builds for local businesses like yours — clean, fast, and built to make booking the obvious next step.</p>
        </header>

        <div class="ax-work">
          {work.map((w, i) => (
            <a href="/work" class="ax-work-item" data-cursor-label="View" data-reveal data-motion="depthCardReveal" style={`--reveal-delay: ${i * 120}ms`}>
              <div class="ax-work-top">
                <span class="ax-work-num">0{i + 1}</span>
                <span class="ax-label">{w.sector}</span>
              </div>
              <figure class="ax-work-shot">
                <ResponsivePicture
                  source={w.img.source}
                  alt={w.img.alt || w.title}
                  sizes="(min-width: 900px) 28vw, 90vw"
                  class="ax-work-img"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  objectPosition={w.img.position || 'center 40%'}
                />
                <span class="ax-work-cta" aria-hidden="true">View <span>→</span></span>
              </figure>
              <h3 class="ax-work-title">{w.title}</h3>
              <p class="ax-work-outcome">{w.outcome}</p>
            </a>
          ))}
        </div>

        <a href="/work" class="ax-more" data-reveal data-motion="eyebrow">All work <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <!-- ░░ SERVICES ░░ -->
    <section class="ax-section">
      <div class="ax-container">
        <header class="ax-head">
          <span class="ax-label" data-reveal data-motion="eyebrow">Services</span>
          <h2 class="ax-h2" data-reveal data-motion="editorial">Three ways we <em>strengthen the site</em></h2>
        </header>

        <ol class="ax-list">
          {services.map((s, i) => (
            <li data-reveal data-motion="system" style={`--reveal-delay: ${i * 90}ms`}>
              <a href={s.href} class="ax-row">
                <span class="ax-row-num">{s.num}</span>
                <span class="ax-row-title">{s.label}</span>
                <span class="ax-row-desc">{s.description}</span>
                <span class="ax-row-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ░░ WHY ░░ -->
    <section class="ax-section">
      <div class="ax-container ax-split">
        <div class="ax-split-left">
          <span class="ax-label" data-reveal data-motion="eyebrow">Why Axiom</span>
          <h2 class="ax-h2" data-reveal data-motion="editorial">Made for businesses that <em>can't look cheap</em></h2>
          <p class="ax-lead" data-reveal data-motion="editorial" style="--reveal-delay: 80ms">
            Established local businesses with a reputation behind them. If a new customer judges you by your website before they ever call, this is built for you.
          </p>
        </div>
        <div class="ax-split-right">
          {principles.map((p, i) => (
            <div class="ax-principle" data-reveal data-motion="depth" style={`--reveal-delay: ${i * 90}ms`}>
              <span class="ax-row-num">{p.num}</span>
              <div>
                <h3 class="ax-principle-title">{p.title}</h3>
                <p class="ax-principle-desc">{p.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ░░ FIGURES ░░ -->
    <section class="ax-section ax-section--tight">
      <div class="ax-container">
        <div class="ax-figures">
          {figures.map((f, i) => (
            <div class="ax-figure" data-reveal data-motion="system" style={`--reveal-delay: ${i * 90}ms`}>
              <span class="ax-figure-num">{f.value}</span>
              <span class="ax-figure-label">{f.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ░░ PROCESS ░░ -->
    <section class="ax-section">
      <div class="ax-container">
        <header class="ax-head">
          <span class="ax-label" data-reveal data-motion="eyebrow">Process</span>
          <h2 class="ax-h2" data-reveal data-motion="editorial">A disciplined, <em>30-day delivery</em></h2>
        </header>

        <ol class="ax-process">
          {process.map((p, i) => (
            <li class="ax-step" data-reveal data-motion="timelineSequence" style={`--reveal-delay: ${i * 110}ms`}>
              <span class="ax-step-node" aria-hidden="true"></span>
              <span class="ax-step-num">{p.num}</span>
              <h3 class="ax-step-title">{p.title}</h3>
              <p class="ax-step-desc">{p.description}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ░░ STUDIO ░░ -->
    <section class="ax-section">
      <div class="ax-container ax-split">
        <div class="ax-split-left">
          <span class="ax-label" data-reveal data-motion="eyebrow">The studio</span>
          <h2 class="ax-h2" data-reveal data-motion="editorial">Two people. <em>Direct line.</em></h2>
          <p class="ax-lead" data-reveal data-motion="editorial" style="--reveal-delay: 80ms">
            Axiom is run by two partners. You work directly with the people designing and building your site — no account managers, no layers, no ticket queues.
          </p>
        </div>
        <div class="ax-split-right">
          {team.map((m, i) => (
            <div class="ax-person" data-reveal data-motion="depth" style={`--reveal-delay: ${i * 110}ms`}>
              <span class="ax-person-name">{m.name}</span>
              <span class="ax-person-role">{m.role}</span>
              <p class="ax-person-desc">{m.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ░░ FINAL CTA ░░ -->
    <section class="ax-final">
      <div class="ax-final-bg" aria-hidden="true"></div>
      <div class="ax-container">
        <span class="ax-index" data-reveal data-motion="eyebrow">№ — Start here</span>
        <h2 class="ax-mega ax-final-mega" data-reveal data-motion="cta">
          Let's build the<br /><em>site you deserve.</em>
        </h2>
        <div class="ax-hero-actions" data-reveal data-motion="cta" style="--reveal-delay: 120ms">
          <a href={CTA_PATHS.startProject} class="ax-cta" data-magnetic>Start a project <span aria-hidden="true">→</span></a>
          <a href="/pricing" class="ax-textlink">See pricing</a>
        </div>
        <p class="ax-fineprint" data-reveal data-motion="editorial" style="--reveal-delay: 200ms">
          Monthly or one-time from $3,500. Pricing is public, the launch path is defined, and every build is checked for speed and mobile quality before it ships.
        </p>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .ax-root {
    --ax-gutter: clamp(1.25rem, 5vw, 4rem);
    color: var(--text-primary);
  }

  .ax-container {
    width: 100%;
    max-width: 84rem;
    margin-inline: auto;
    padding-inline: var(--ax-gutter);
  }

  /* ── Type ─────────────────────────────────────────── */
  .ax-mega {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.15rem, 8.4vw, 9rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: var(--text-primary);
    margin: 0;
  }
  .ax-mega em {
    font-family: var(--font-editorial);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.015em;
    color: var(--accent);
  }

  .ax-h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0;
  }
  .ax-h2 em {
    font-family: var(--font-editorial);
    font-style: italic;
    font-weight: 400;
    color: var(--accent);
  }

  .ax-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--text-muted);
  }

  .ax-lead {
    font-size: clamp(1rem, 1.25vw, 1.18rem);
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 42ch;
    margin: 0;
  }

  /* ── Hero ─────────────────────────────────────────── */
  .ax-hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(620px, 92svh, 1000px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: clamp(2.5rem, 7vh, 5.5rem);
    padding-bottom: clamp(4rem, 10vh, 7rem);
    overflow: hidden;
  }

  .ax-hero-bg { position: absolute; inset: -10% -5% 0; z-index: -1; pointer-events: none; }
  .ax-hero-bg > * { position: absolute; inset: 0; will-change: transform; }

  .ax-hero-canvas { width: 100%; height: 100%; opacity: 0; transition: opacity 1.2s var(--ease-cinematic); }
  .ax-hero.has-webgl .ax-hero-canvas { opacity: 1; }
  /* The shader carries the ambient glow once active — retire the CSS aurora to avoid muddiness. */
  .ax-hero.has-webgl .ax-hero-aurora { display: none; }
  .ax-hero.has-webgl .ax-hero-glow { opacity: 0.5; }

  .ax-hero-grid {
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.028) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.028) 1px, transparent 1px);
    background-size: clamp(48px, 7vw, 96px) clamp(48px, 7vw, 96px);
    mask-image: radial-gradient(ellipse 90% 70% at 50% 36%, #000 35%, transparent 78%);
    -webkit-mask-image: radial-gradient(ellipse 90% 70% at 50% 36%, #000 35%, transparent 78%);
    opacity: 0.7;
  }

  .ax-hero-glow {
    background:
      radial-gradient(60% 50% at 50% -8%, rgb(var(--accent-v2-rgb) / 0.16), transparent 60%),
      radial-gradient(40% 40% at 82% 8%, rgb(var(--accent-v2-rgb) / 0.06), transparent 60%);
  }

  .ax-hero-aurora {
    background: conic-gradient(from 210deg at 30% 18%, transparent 0deg, rgb(var(--accent-v2-rgb) / 0.08) 60deg, transparent 160deg);
    filter: blur(40px);
    opacity: 0.7;
  }

  .ax-hero-vignette {
    background: radial-gradient(120% 90% at 50% 30%, transparent 50%, rgba(0, 0, 0, 0.55) 100%);
  }

  html[data-motion-active='true'] .ax-hero-aurora {
    animation: ax-aurora 26s var(--ease-premium-soft) infinite alternate;
  }

  .ax-hero-inner { position: relative; }

  .ax-masthead {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--text-muted);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--hairline);
  }
  .ax-masthead .ax-sep { color: rgba(245, 241, 233, 0.22); }
  .ax-avail { margin-left: auto; display: inline-flex; align-items: center; gap: 0.5rem; color: var(--text-secondary); }
  .ax-avail i {
    width: 0.45rem; height: 0.45rem; border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 10px rgb(var(--accent-v2-rgb) / 0.9);
    animation: ax-pulse 2.4s ease-in-out infinite;
  }

  /* Masked, staggered headline reveal */
  .ax-hero-title { margin: 0; }
  .ax-line { display: block; overflow: hidden; padding-bottom: 0.04em; }
  .ax-line-inner { display: block; }
  .ax-line-inner em { font-family: var(--font-editorial); font-style: italic; font-weight: 400; color: var(--accent); }

  .ax-hero-foot { margin-top: clamp(2.25rem, 5vw, 3.75rem); display: grid; gap: 2rem; }
  .ax-hero-actions { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }

  @media (min-width: 900px) {
    .ax-hero-foot { grid-template-columns: auto 1fr; align-items: end; gap: 3.5rem; }
    .ax-hero-foot .ax-lead { justify-self: end; }
  }

  .ax-scroll-cue {
    position: absolute;
    left: var(--ax-gutter);
    bottom: clamp(1.5rem, 4vh, 2.75rem);
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--text-muted);
    transition: color 0.25s ease;
  }
  .ax-scroll-cue:hover { color: var(--accent); }
  .ax-scroll-line { position: relative; display: block; width: 1px; height: 2.4rem; background: var(--hairline-strong); overflow: hidden; }
  .ax-scroll-line span { position: absolute; inset: 0; background: var(--accent); transform: translateY(-100%); animation: ax-scroll 2.2s var(--ease-cinematic) infinite; }

  /* ── Mobile hero refinement ───────────────────────── */
  @media (max-width: 767px) {
    .ax-hero { min-height: auto; padding-top: 1.25rem; padding-bottom: 2.75rem; }
    .ax-masthead { font-size: 0.62rem; letter-spacing: 0.12em; gap: 0.4rem 0.6rem; margin-bottom: 1.5rem; padding-bottom: 1rem; }
    .ax-avail { margin-left: 0; flex-basis: 100%; margin-top: 0.25rem; }
    .ax-hero-foot { margin-top: 1.75rem; gap: 1.5rem; }
    .ax-scroll-cue { display: none; }
    .ax-hero-actions { gap: 1rem; }
    .ax-hero-actions .ax-cta { flex: 1 1 auto; justify-content: center; }
  }

  /* ── Buttons / links ──────────────────────────────── */
  .ax-cta {
    display: inline-flex; align-items: center; gap: 0.6rem;
    background: var(--accent); color: var(--text-on-accent);
    font-weight: 600; font-size: 0.95rem; letter-spacing: 0.01em;
    padding: 0.95rem 1.5rem; border-radius: 5px;
    transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 10px 30px -12px rgb(var(--accent-v2-rgb) / 0.55);
  }
  .ax-cta span { transition: transform 0.25s var(--ease-premium, ease); }
  .ax-cta:hover { background: var(--accent-hover); transform: translateY(-2px); box-shadow: 0 16px 40px -12px rgb(var(--accent-v2-rgb) / 0.7); }
