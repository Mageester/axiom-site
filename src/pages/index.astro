---
import BrowserFrame from '../components/site/BrowserFrame.astro';
import CtaBand from '../components/site/CtaBand.astro';
import FactsBar from '../components/site/FactsBar.astro';
import FaqList from '../components/site/FaqList.astro';
import FounderCards from '../components/site/FounderCards.astro';
import Icon from '../components/site/Icon.astro';
import IndustryGrid from '../components/site/IndustryGrid.astro';
import LinkCard from '../components/site/LinkCard.astro';
import PricingCards from '../components/site/PricingCards.astro';
import ProcessSteps from '../components/site/ProcessSteps.astro';
import ResponsivePicture from '../components/site/ResponsivePicture.astro';
import WorkCard from '../components/site/WorkCard.astro';
import { homeFaq, valueProps } from '../content/company';
import { packages } from '../content/pricing';
import { processSteps } from '../content/process';
import { services } from '../content/services';
import { getProject } from '../content/work';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CTA_PATHS } from '../lib/cta';
import { SEO_ROUTES, SITE_EMAIL, SITE_PHONE_DISPLAY, SITE_TELEPHONE, faqJsonLd } from '../lib/seo';

const featured = ['reids-home-and-yard', 'physio-clinic', 'dental-aurelia'].map((id) => getProject(id)!);
const hero = featured[0];
const heroSizes = '(min-width: 1180px) 600px, (min-width: 1024px) 48vw, 92vw';
---

<BaseLayout
  {...SEO_ROUTES.home}
  schema={faqJsonLd(homeFaq)}
  ogImageAlt="Axiom Web — clear, fast websites for local businesses in Kitchener-Waterloo"
  preload={{ type: 'image/avif', href: '/images/work-reids-960.avif', srcset: hero.image.avifSrcSet, sizes: heroSizes }}
>
  <main id="main-content" tabindex="-1">
    <!-- Hero -->
    <section class="home-hero">
      <div class="container">
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="hero-kicker"><span class="kicker-dot" aria-hidden="true"></span>Web design studio in Kitchener-Waterloo</p>
            <h1 class="display">Websites that make your business the <span class="hl">obvious choice.</span></h1>
            <p class="lead">
              Axiom Web designs and builds clear, fast websites for local businesses across Kitchener-Waterloo and Ontario,
              with published pricing from CAD $900 and launch in two to four weeks.
            </p>
            <div class="btn-row">
              <a href={CTA_PATHS.startProject} class="btn btn-lg">Start a project <Icon name="arrow-right" /></a>
              <a href="/pricing/" class="btn btn-secondary btn-lg">See pricing</a>
            </div>
            <ul role="list" class="hero-assurances">
              <li><Icon name="check" size={18} strokeWidth={2.2} />Fixed price agreed before work starts</li>
              <li><Icon name="check" size={18} strokeWidth={2.2} />Work directly with the two founders</li>
              <li><Icon name="check" size={18} strokeWidth={2.2} />First year of hosting included</li>
            </ul>
          </div>

          <div class="hero-visual">
            <div class="hero-glow" aria-hidden="true"></div>
            <BrowserFrame url="reidshomeandyard.getaxiom.ca" class="hero-browser">
              <ResponsivePicture
                source={hero.image}
                alt={hero.alt}
                sizes={heroSizes}
                loading="eager"
                fetchpriority="high"
                position="center top"
              />
            </BrowserFrame>
            <a class="hero-chip hero-chip-launch" href={hero.href} target="_blank" rel="noopener">
              <span class="chip-icon chip-icon-live" aria-hidden="true"><Icon name="rocket" size={18} /></span>
              <span>
                <span class="chip-label">Live client site</span>
                <span class="chip-title">Reid’s Home &amp; Yard <span class="sr-only">(opens in a new tab)</span></span>
              </span>
            </a>
            <div class="hero-chip hero-chip-time" aria-hidden="true">
              <span class="chip-icon"><Icon name="calendar" size={18} /></span>
              <span>
                <span class="chip-label">Typical launch</span>
                <span class="chip-title">2–4 weeks</span>
              </span>
            </div>
          </div>
        </div>

        <div class="hero-facts">
          <FactsBar />
        </div>
      </div>
    </section>

    <!-- Services -->
    <section class="section" aria-labelledby="services-title">
      <div class="container">
        <div class="section-head-row">
          <div class="section-head">
            <p class="eyebrow">Services</p>
            <h2 id="services-title">A website built around how your customers decide</h2>
            <p>Whether you need your first proper website or a rebuild of one that no longer fits, the goal is the same: make your business easy to understand, easy to trust and easy to contact.</p>
          </div>
          <a href="/services/" class="arrow-link">All services <Icon name="arrow-right" /></a>
        </div>
        <div class="grid grid-3">
          {services.map((service) => (
            <LinkCard href={`/services/${service.slug}/`} icon={service.icon} title={service.name} text={service.cardSummary} />
          ))}
        </div>
      </div>
    </section>

    <!-- Work -->
    <section class="section section-soft" aria-labelledby="work-title">
      <div class="container">
        <div class="section-head-row">
          <div class="section-head">
            <p class="eyebrow">Work</p>
            <h2 id="work-title">Recent work</h2>
            <p>A live client website and concept builds that show how we structure sites for different kinds of local businesses.</p>
          </div>
          <a href="/work/" class="arrow-link">View all work <Icon name="arrow-right" /></a>
        </div>
        <div class="grid grid-3">
          {featured.map((project) => <WorkCard project={project} />)}
        </div>
        <p class="work-note">Concept builds are demonstrations designed by Axiom Web and are labelled clearly. They are not client results.</p>
      </div>
    </section>

    <!-- Why Axiom -->
    <section class="section" aria-labelledby="why-title">
      <div class="container why-grid">
        <div class="section-head why-head">
          <p class="eyebrow">Why Axiom Web</p>
          <h2 id="why-title">Built properly. Priced plainly.</h2>
          <p>Every website we build follows the same standard, whatever the package. You know the price before we start, and you know who is building your site.</p>
          <a href="/about/" class="arrow-link">About the studio <Icon name="arrow-right" /></a>
        </div>
        <ul role="list" class="value-grid">
          {valueProps.map((item) => (
            <li class="value">
              <span class="icon-tile"><Icon name={item.icon} /></span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Process -->
    <section class="section section-soft" aria-labelledby="process-title">
      <div class="container">
        <div class="section-head-row">
          <div class="section-head">
            <p class="eyebrow">How it works</p>
            <h2 id="process-title">From first conversation to launch in four steps</h2>
            <p>A simple, predictable process. Scope and price are agreed in writing before design starts, so there are no surprises later.</p>
          </div>
          <a href="/approach/" class="arrow-link">See the full process <Icon name="arrow-right" /></a>
        </div>
        <ProcessSteps steps={processSteps} />
      </div>
    </section>

    <!-- Pricing -->
    <section class="section" aria-labelledby="pricing-title">
      <div class="container">
        <div class="section-head center">
          <p class="eyebrow">Pricing</p>
          <h2 id="pricing-title">Published packages. No guesswork.</h2>
          <p>Choose the package that fits your business today. Every standard package includes first-year hosting, two revision rounds and thirty days of support after launch.</p>
        </div>
        <PricingCards packages={packages} compact />
        <p class="center-link"><a href="/pricing/" class="arrow-link">Compare packages and what’s included <Icon name="arrow-right" /></a></p>
      </div>
    </section>

    <!-- Industries -->
    <section class="section section-soft" aria-labelledby="industries-title">
      <div class="container">
        <div class="section-head-row">
          <div class="section-head">
            <p class="eyebrow">Industries</p>
            <h2 id="industries-title">Websites for local service businesses</h2>
            <p>Different businesses win customers in different ways. We plan each site around what your buyers need to see before they get in touch.</p>
          </div>
          <a href="/industries/" class="arrow-link">All industries <Icon name="arrow-right" /></a>
        </div>
        <IndustryGrid />
      </div>
    </section>

    <!-- Founders -->
    <section class="section" aria-labelledby="team-title">
      <div class="container team-grid">
        <div class="section-head team-head">
          <p class="eyebrow">Who you’ll work with</p>
          <h2 id="team-title">Two founders. No account managers.</h2>
          <p>
            Aidan Magee and Riley Hinsperger are the co-founders of Axiom Web, the web-focused subsidiary of Axiom International.
            You work directly with the people who plan, design and build your website.
          </p>
          <a href="/about/" class="arrow-link">Meet the founders <Icon name="arrow-right" /></a>
        </div>
        <FounderCards />
      </div>
    </section>

    <!-- FAQ -->
    <section class="section section-soft" aria-labelledby="faq-title">
      <div class="container faq-grid">
        <div class="section-head faq-head">
          <p class="eyebrow">FAQ</p>
          <h2 id="faq-title">Common questions</h2>
          <p>Straight answers about cost, timing and what working with us looks like.</p>
          <div class="faq-contact">
            <p class="small muted">Still have a question?</p>
            <a class="text-link" href={`tel:${SITE_TELEPHONE}`}>{SITE_PHONE_DISPLAY}</a>
            <a class="text-link" href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>
          </div>
        </div>
        <FaqList items={homeFaq} openFirst />
      </div>
    </section>

    <CtaBand />
  </main>
</BaseLayout>

<style>
  /* Hero */
  .home-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) clamp(2.5rem, 2rem + 2vw, 3.5rem);
    background:
      radial-gradient(52rem 30rem at 92% 8%, rgb(36 83 214 / 0.1), transparent 70%),
      linear-gradient(180deg, var(--bg-soft) 0%, var(--bg) 100%);
    border-bottom: 1px solid var(--line);
  }

  .home-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(70% 60% at 80% 20%, #000 0%, transparent 75%);
    opacity: 0.55;
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    display: grid;
    gap: clamp(2.75rem, 2rem + 3vw, 4rem);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
      gap: clamp(3rem, 1rem + 4vw, 5rem);
    }
  }

  .hero-copy {
    display: grid;
    gap: 1.4rem;
    align-content: start;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 0.55rem;
    padding: 0.4rem 0.85rem 0.4rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fff;
    color: var(--ink-2);
    font-size: var(--fs-xs);
    font-weight: 600;
    box-shadow: var(--shadow-xs);
  }

  .kicker-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--brand);
    box-shadow: 0 0 0 4px var(--brand-soft);
  }

  .hero-copy h1 {
    max-width: 15.5ch;
  }

  .hl {
    color: var(--brand);
  }

  .hero-copy .lead {
    max-width: 36rem;
  }

  .hero-copy .btn-row {
    margin-top: 0.4rem;
  }

  .hero-assurances {
    display: grid;
    gap: 0.5rem;
    margin: 0.4rem 0 0;
    color: var(--ink-2);
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  .hero-assurances li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .hero-assurances :global(svg) {
    flex: none;
    color: var(--success);
  }

  .hero-visual {
    position: relative;
    padding: 1.5rem 0 2.5rem;
  }

  @media (min-width: 1024px) {
    .hero-visual {
      padding: 2rem 0 3rem 1.5rem;
    }
  }

  .hero-glow {
    position: absolute;
    inset: 8% -6% 4% 8%;
    border-radius: 40px;
    background: linear-gradient(135deg, rgb(36 83 214 / 0.18), rgb(157 181 255 / 0.12));
    filter: blur(40px);
  }

  .hero-visual :global(.hero-browser) {
    position: relative;
  }

  .hero-chip {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem 0.75rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: #fff;
    box-shadow: var(--shadow-md);
    font-size: var(--fs-xs);
    line-height: 1.3;
  }

  .hero-chip-launch {
    bottom: 0.5rem;
    left: -0.5rem;
    transition: transform 200ms var(--ease), box-shadow 200ms var(--ease);
  }

  .hero-chip-launch:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .hero-chip-time {
    top: 0.25rem;
    right: -0.25rem;
  }

  @media (min-width: 1024px) {
    .hero-chip-launch {
      left: -1rem;
    }
    .hero-chip-time {
      right: -1.25rem;
    }
  }

  .chip-icon {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    border-radius: 10px;
    background: var(--brand-soft);
    color: var(--brand);
  }

  .chip-icon-live {
    background: var(--success-soft);
    color: var(--success);
  }

  .chip-label {
    display: block;
    color: var(--text-muted);
    font-weight: 500;
  }

  .chip-title {
    display: block;
    color: var(--ink);
    font-size: var(--fs-sm);
    font-weight: 650;
  }

  .hero-facts {
    position: relative;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    padding-top: clamp(1.75rem, 1.5rem + 1vw, 2.25rem);
    border-top: 1px solid var(--line);
  }

  @media (max-width: 519px) {
    .hero-chip-time {
      display: none;
    }
  }

  /* Work */
  .work-note {
    margin-top: 1.5rem;
    color: var(--text-muted);
    font-size: var(--fs-xs);
  }

  /* Two-column sections */
  .why-grid,
  .team-grid,
  .faq-grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .why-grid,
    .team-grid,
    .faq-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
      gap: clamp(3rem, 2rem + 4vw, 6rem);
      align-items: start;
    }

    .why-head,
    .team-head,
    .faq-head {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  .why-head,
  .team-head,
  .faq-head {
    margin-bottom: 0;
    justify-items: start;
  }

  .value-grid {
    display: grid;
    gap: 2rem 2.5rem;
    margin: 0;
  }

  @media (min-width: 640px) {
    .value-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .value {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .value .icon-tile {
    margin-bottom: 0.35rem;
  }

  .value p {
    color: var(--text);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  /* Pricing */
  .center-link {
    margin-top: 1.75rem;
    text-align: center;
  }

  /* FAQ */
  .faq-contact {
    display: grid;
    gap: 0.35rem;
    justify-items: start;
    margin-top: 0.5rem;
    font-size: var(--fs-sm);
  }
</style>
