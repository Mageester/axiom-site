---
import ResponsivePicture from '../components/site/ResponsivePicture.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { CTA_PATHS } from '../lib/cta';
import { HOME_JSON_LD, WEBSITE_SCHEMA, SEO_ROUTES } from '../lib/seo';
import { getWorkProofImage } from '../lib/workProofImages';

const work = [
  {
    sector: 'Dental',
    title: 'Aurelia Dental Studio',
    outcome: 'Clear, warm, and easy to navigate. New patients find what they need and book without second-guessing.',
    img: getWorkProofImage('concept-dental-demo'),
  },
  {
    sector: 'Beauty',
    title: 'Nails Studio',
    outcome: 'Booking is visible early, services are easy to compare, and the brand reads calm and polished.',
    img: getWorkProofImage('concept-salon-demo'),
  },
  {
    sector: 'Grooming',
    title: 'Blackline Barber Co.',
    outcome: 'Fast, sharp, and direct. Clients get to the booking button in seconds — no hunting required.',
    img: getWorkProofImage('concept-barber-demo'),
  },
] as const;

const services = [
  {
    num: '01',
    label: 'Conversion Sites',
    description: 'For service businesses that need a clearer offer, stronger trust signals, and fewer steps from visit to inquiry.',
    href: '/services#conversion-sites',
  },
  {
    num: '02',
    label: 'Local Business Websites',
    description: 'For companies whose reputation, service quality, and contact path need to be obvious on every device.',
    href: '/services#local-business-websites',
  },
  {
    num: '03',
    label: 'Rebuilds',
    description: 'Replace a dated or confusing site while protecting useful content, redirects, domains, and buyer trust.',
    href: '/services#rebuilds',
  },
] as const;

// Honest capability band — what we actually deliver, not fabricated client logos.
const marquee = [
  'Custom code — never templates',
  'Sub-one-second load',
  'Mobile-first by default',
  'Built to get you booked',
  'Managed hosting & security',
  'Direct line to the makers',
  'Clean, maintainable builds',
  '30-day delivery',
] as const;

const solution = [
  { title: 'Understood in seconds', description: 'What you do, who you help, and how to book — clear the moment someone lands. No scrolling to figure you out.' },
  { title: 'Trusted where it counts', description: 'Real reviews, credentials, and proof placed exactly where a visitor decides whether to call you.' },
  { title: 'Fast enough to convert', description: 'Sub-second loads on the phones your customers actually use, so nobody bounces before they reach the button.' },
] as const;

const principles = [
  { num: '01', title: 'Visitors get it in seconds', description: 'People should understand what you do, who you help, and how to book the moment they land — no scrolling around, no guessing.' },
  { num: '02', title: 'Built to earn trust', description: 'Real reviews, credentials, and proof go exactly where people decide whether to call you. We never make up numbers or fake testimonials.' },
  { num: '03', title: 'Fast on every phone', description: 'Most of your visitors are on their phone. Your site loads in under a second and looks sharp on every screen — so nobody bounces.' },
  { num: '04', title: 'Looked after, even after launch', description: "We handle the hosting, the security, and the small updates. When something's needed, you message the two people who built it — not a ticket queue." },
] as const;

const figures = [
  { value: 'Under 1s', label: 'Load time, every build' },
  { value: 'Two', label: 'Partners, zero middlemen' },
  { value: '~30 days', label: 'From kickoff to launch' },
  { value: '$0', label: 'Down to get started' },
] as const;

const process = [
  { num: '01', title: 'Diagnostics', description: 'We audit your brand, copy, and where visitors drop off — and define exactly what the site needs to do.' },
  { num: '02', title: 'Blueprint', description: 'We map every page, the flow, and the exact words. The whole plan is approved before a line of code is written.' },
  { num: '03', title: 'Build', description: 'Custom, lightweight code. No templates, no bloated plugins, no performance compromises.' },
  { num: '04', title: 'Launch & handoff', description: 'Speed, mobile, and DNS checks, then a clean handoff — with managed hosting if you want it.' },
] as const;

const team = [
  { name: 'Aidan', role: 'Strategy & scope', description: 'Shapes the message and the structure so the site maps to exactly how your customers decide.' },
  { name: 'Riley', role: 'Engineering & delivery', description: 'Builds the site itself — obsessed with speed, clean code, and how it feels on a phone.' },
] as const;
---

<SiteLayout
  title={SEO_ROUTES.home.title}
  description={SEO_ROUTES.home.description}
  canonicalPath="/"
  ogImageAlt="Axiom — web design studio in Kitchener-Waterloo."
  schema={[HOME_JSON_LD, WEBSITE_SCHEMA]}
>
  <main id="main-content" tabindex="-1" class="ax-root">
    <!-- ░░ HERO ░░ -->
    <section class="ax-hero">
      <div class="ax-container">
        <div class="ax-masthead ax-load" style="--i: 0">
          <span>Web Design Studio</span>
          <span class="ax-sep">/</span>
          <span>Kitchener · Waterloo, ON</span>
          <span class="ax-sep">/</span>
          <span>Est. 2024</span>
          <span class="ax-avail"><i></i>Now booking — 2 slots</span>
        </div>

        <h1 class="ax-mega ax-hero-title">
          <span class="ax-line"><span class="ax-line-inner ax-mask" style="--i: 1">Websites that get</span></span>
          <span class="ax-line"><span class="ax-line-inner ax-mask" style="--i: 2">local businesses</span></span>
          <span class="ax-line"><span class="ax-line-inner ax-mask" style="--i: 3"><em>booked.</em></span></span>
        </h1>

        <div class="ax-hero-foot">
          <div class="ax-hero-actions ax-load" style="--i: 5">
            <a href={CTA_PATHS.startProject} class="btn btn-primary">Start a project <span aria-hidden="true">→</span></a>
            <a href="/work" class="btn-ghost-link">See the work</a>
          </div>
          <p class="ax-lead ax-load" style="--i: 6">
            Custom websites for established local businesses — built to look the part on every phone, load in under a second, and turn visitors into booked clients. You work directly with the two people who design and build it.
          </p>
        </div>
      </div>
    </section>

    <!-- ░░ CAPABILITY MARQUEE BAND ░░ -->
    <section class="ax-marquee-band" aria-label="What every Axiom build includes">
      <div class="ax-marquee" data-marquee aria-hidden="true">
        <div class="ax-marquee-track" data-marquee-track>
          {[...marquee, ...marquee].map((item) => (
            <span class="ax-marquee-item"><i class="ax-marquee-dot"></i>{item}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- ░░ PROBLEM ░░ -->
    <section class="ax-statement" id="ax-statement">
      <div class="ax-container">
        <span class="ax-index reveal">№ 01 — The problem</span>
        <p class="ax-big reveal" style="--reveal-delay: 80ms">
          Most local businesses lose customers to a website that looks like an afterthought.
          <em>We make yours the reason they call.</em>
        </p>
      </div>
    </section>

    <!-- ░░ SOLUTION ░░ -->
    <section class="ax-section">
      <div class="ax-container">
        <header class="ax-head">
          <span class="ax-label reveal">№ 02 — The fix</span>
          <h2 class="ax-h2 reveal" style="--reveal-delay: 60ms">A site that does the <em>quiet, important work</em></h2>
          <p class="ax-head-note reveal" style="--reveal-delay: 120ms">
            We rebuild the version of your business that earns the click — composed, credible, and fast enough that the decision to call feels obvious.
          </p>
        </header>

        <div class="ax-solution">
          {solution.map((s, i) => (
            <div class="ax-solution-item reveal" style={`--reveal-delay: ${i * 90}ms`}>
              <span class="ax-solution-num">0{i + 1}</span>
              <h3 class="ax-solution-title">{s.title}</h3>
              <p class="ax-solution-desc">{s.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ░░ WORK ░░ -->
    <section class="ax-section">
      <div class="ax-container">
        <header class="ax-head">
          <span class="ax-label reveal">Selected work · 2024–25</span>
          <h2 class="ax-h2 reveal" style="--reveal-delay: 60ms">The kind of site <em>you'll get</em></h2>
          <p class="ax-head-note reveal" style="--reveal-delay: 120ms">Concept builds for local businesses like yours — clean, fast, and built to make booking the obvious next step.</p>
        </header>

        <div class="ax-work">
          {work.map((w, i) => (
            <a href="/work" class="ax-work-item reveal" style={`--reveal-delay: ${i * 90}ms`}>
              <div class="ax-work-top">
                <span class="ax-work-num">0{i + 1}</span>
                <span class="ax-label">{w.sector}</span>
              </div>
              <figure class="ax-work-shot">
                <ResponsivePicture
                  source={w.img.source}
                  alt={w.img.alt || w.title}
                  sizes="(min-width: 900px) 28vw, 90vw"
                  class="ax-work-img"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  objectPosition={w.img.position || 'center 40%'}
                />
              </figure>
              <h3 class="ax-work-title">{w.title}</h3>
              <p class="ax-work-outcome">{w.outcome}</p>
            </a>
          ))}
        </div>

        <a href="/work" class="ax-more reveal">All work <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <!-- ░░ SERVICES ░░ -->
    <section class="ax-section">
      <div class="ax-container">
        <header class="ax-head">
          <span class="ax-label reveal">Services</span>
          <h2 class="ax-h2 reveal" style="--reveal-delay: 60ms">Three ways we <em>strengthen the site</em></h2>
        </header>

        <ol class="ax-list">
          {services.map((s, i) => (
            <li class="reveal" style={`--reveal-delay: ${i * 70}ms`}>
              <a href={s.href} class="ax-row">
                <span class="ax-row-num">{s.num}</span>
                <span class="ax-row-title">{s.label}</span>
                <span class="ax-row-desc">{s.description}</span>
                <span class="ax-row-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ░░ WHY ░░ -->
    <section class="ax-section">
      <div class="ax-container ax-split">
        <div class="ax-split-left">
          <span class="ax-label reveal">Why Axiom</span>
          <h2 class="ax-h2 reveal" style="--reveal-delay: 60ms">Made for businesses that <em>can't look cheap</em></h2>
          <p class="ax-lead reveal" style="--reveal-delay: 120ms">
            Established local businesses with a reputation behind them. If a new customer judges you by your website before they ever call, this is built for you.
          </p>
        </div>
        <div class="ax-split-right">
          {principles.map((p, i) => (
            <div class="ax-principle reveal" style={`--reveal-delay: ${i * 80}ms`}>
              <span class="ax-principle-num">{p.num}</span>
              <div>
                <h3 class="ax-principle-title">{p.title}</h3>
                <p class="ax-principle-desc">{p.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ░░ FIGURES ░░ -->
    <section class="ax-section ax-section--tight">
      <div class="ax-container">
        <div class="ax-figures">
          {figures.map((f, i) => (
            <div class="ax-figure reveal" style={`--reveal-delay: ${i * 70}ms`}>
              <span class="ax-figure-num">{f.value}</span>
              <span class="ax-figure-label">{f.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ░░ PROCESS ░░ -->
    <section class="ax-section">
      <div class="ax-container">
        <header class="ax-head">
          <span class="ax-label reveal">Process</span>
          <h2 class="ax-h2 reveal" style="--reveal-delay: 60ms">A disciplined, <em>30-day delivery</em></h2>
        </header>

        <ol class="ax-process">
          {process.map((p, i) => (
            <li class="ax-step reveal" style={`--reveal-delay: ${i * 80}ms`}>
              <span class="ax-step-node" aria-hidden="true"></span>
              <span class="ax-step-num">{p.num}</span>
              <h3 class="ax-step-title">{p.title}</h3>
              <p class="ax-step-desc">{p.description}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ░░ STUDIO ░░ -->
    <section class="ax-section">
      <div class="ax-container ax-split">
        <div class="ax-split-left">
          <span class="ax-label reveal">The studio</span>
          <h2 class="ax-h2 reveal" style="--reveal-delay: 60ms">Two people. <em>Direct line.</em></h2>
          <p class="ax-lead reveal" style="--reveal-delay: 120ms">
            Axiom is run by two partners. You work directly with the people designing and building your site — no account managers, no layers, no ticket queues.
          </p>
        </div>
        <div class="ax-split-right">
          {team.map((m, i) => (
            <div class="ax-person reveal" style={`--reveal-delay: ${i * 90}ms`}>
              <span class="ax-person-name">{m.name}</span>
              <span class="ax-person-role">{m.role}</span>
              <p class="ax-person-desc">{m.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ░░ FINAL CTA ░░ -->
    <section class="ax-final">
      <div class="ax-container">
        <span class="ax-index reveal">Start here</span>
        <h2 class="ax-mega ax-final-mega reveal" style="--reveal-delay: 60ms">
          Let's build the<br /><em>site you deserve.</em>
        </h2>
        <div class="ax-hero-actions reveal" style="--reveal-delay: 140ms">
          <a href={CTA_PATHS.startProject} class="btn btn-primary">Start a project <span aria-hidden="true">→</span></a>
          <a href="/pricing" class="btn-ghost-link">See pricing</a>
        </div>
        <p class="ax-fineprint reveal" style="--reveal-delay: 200ms">
          Monthly or one-time from $3,500. Pricing is public, the launch path is defined, and every build is checked for speed and mobile quality before it ships.
        </p>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .ax-root {
    --ax-gutter: clamp(1.5rem, 5vw, 4rem);
    color: var(--text-primary);
  }

  .ax-container {
    width: 100%;
    max-width: 75rem;
    margin-inline: auto;
    padding-inline: var(--ax-gutter);
  }

  /* ── Type ─────────────────────────────────────────── */
  .ax-mega {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.6rem, 8vw, 7.5rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin: 0;
  }
  .ax-mega em {
    font-style: italic;
    font-weight: 400;
  }

  .ax-h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.9rem, 4vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 0;
    max-width: 18ch;
  }
  .ax-h2 em {
    font-style: italic;
    font-weight: 400;
  }

  .ax-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--text-muted);
  }

  .ax-lead {
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 44ch;
    margin: 0;
  }

  /* ── Hero ─────────────────────────────────────────── */
  .ax-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: clamp(560px, 84svh, 880px);
    padding-block: clamp(2.5rem, 7vh, 5rem) clamp(3.5rem, 9vh, 6rem);
  }

  .ax-masthead {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--hairline);
  }
  .ax-masthead .ax-sep { color: var(--hairline-strong); }
  .ax-avail { margin-left: auto; display: inline-flex; align-items: center; gap: 0.5rem; color: var(--text-secondary); }
  .ax-avail i {
    width: 0.45rem; height: 0.45rem; border-radius: 999px;
    background: var(--text-primary);
    animation: ax-pulse 2.4s ease-in-out infinite;
  }

  .ax-hero-title { margin: 0; }
  .ax-line { display: block; overflow: hidden; padding-bottom: 0.04em; }
  .ax-line-inner { display: block; }

  .ax-hero-foot { margin-top: clamp(2.25rem, 5vw, 3.5rem); display: grid; gap: 2rem; }
  .ax-hero-actions { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }

  @media (min-width: 900px) {
    .ax-hero-foot { grid-template-columns: auto 1fr; align-items: end; gap: 3.5rem; }
    .ax-hero-foot .ax-lead { justify-self: end; }
  }

  /* ── Mobile hero ──────────────────────────────────── */
  @media (max-width: 767px) {
    .ax-hero { min-height: auto; padding-top: 1.25rem; padding-bottom: 2.75rem; }
    .ax-masthead { font-size: 0.62rem; letter-spacing: 0.1em; gap: 0.4rem 0.6rem; margin-bottom: 1.5rem; padding-bottom: 1rem; }
    .ax-avail { margin-left: 0; flex-basis: 100%; margin-top: 0.25rem; }
    .ax-hero-foot { margin-top: 1.75rem; gap: 1.5rem; }
    .ax-hero-actions { gap: 1rem; }
    .ax-hero-actions .btn-primary { flex: 1 1 auto; justify-content: center; }
  }

  /* ── Marquee band ─────────────────────────────────── */
  .ax-marquee-band { border-block: 1px solid var(--hairline); padding-block: clamp(1.1rem, 2.5vw, 1.5rem); overflow: hidden; }
  .ax-marquee { position: relative; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .ax-marquee-track { display: flex; align-items: center; gap: clamp(2rem, 4vw, 3.5rem); width: max-content; }
  .ax-marquee-item {
    display: inline-flex; align-items: center; gap: 0.85rem; flex: none;
    font-family: var(--font-mono); font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.14em;
    color: var(--text-secondary); white-space: nowrap;
  }
  .ax-marquee-dot { width: 0.3rem; height: 0.3rem; border-radius: 999px; background: var(--text-muted); flex: none; }

  /* ── Section frame ────────────────────────────────── */
  .ax-section { padding-block: clamp(4.5rem, 11vh, 8rem); border-top: 1px solid var(--hairline); }
  .ax-section--tight { padding-block: clamp(3rem, 7vh, 5rem); }

  .ax-head { display: grid; gap: 1.1rem; margin-bottom: clamp(2.5rem, 5vw, 3.75rem); max-width: 42rem; }
  .ax-head-note { color: var(--text-secondary); font-size: 1rem; line-height: 1.7; margin: 0; max-width: 48ch; }

  /* ── Problem statement ────────────────────────────── */
  .ax-statement { padding-block: clamp(4.5rem, 13vh, 9rem); border-top: 1px solid var(--hairline); }
  .ax-index {
    display: inline-block; font-family: var(--font-mono); font-size: 0.72rem;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 1.75rem;
  }
  .ax-big {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(1.7rem, 4.4vw, 3.4rem); line-height: 1.18; letter-spacing: -0.02em;
    color: var(--text-muted); max-width: 22ch; margin: 0;
  }
  .ax-big em { font-style: normal; color: var(--text-primary); }

  /* ── Solution ─────────────────────────────────────── */
  .ax-solution { display: grid; grid-template-columns: 1fr; gap: clamp(1.5rem, 3vw, 2rem); border-top: 1px solid var(--hairline); padding-top: clamp(2rem, 4vw, 3rem); }
  @media (min-width: 760px) { .ax-solution { grid-template-columns: repeat(3, 1fr); gap: clamp(2rem, 3vw, 3rem); } }
  .ax-solution-item { display: grid; gap: 0.75rem; align-content: start; }
  .ax-solution-num { font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-muted); letter-spacing: 0.1em; }
  .ax-solution-title { font-family: var(--font-display); font-size: clamp(1.25rem, 2vw, 1.6rem); font-weight: 500; letter-spacing: -0.015em; color: var(--text-primary); margin: 0; }
  .ax-solution-desc { color: var(--text-secondary); font-size: 0.95rem; line-height: 1.65; margin: 0; max-width: 38ch; }

  /* ── Work ─────────────────────────────────────────── */
  .ax-work { display: grid; grid-template-columns: 1fr; gap: clamp(2rem, 3vw, 2.75rem); }
  @media (min-width: 760px) { .ax-work { grid-template-columns: repeat(3, 1fr); } }

  .ax-work-item { display: block; }
  .ax-work-top {
    display: flex; align-items: center; justify-content: space-between;
    border-top: 1px solid var(--hairline-strong);
    padding-block: 0.85rem; margin-bottom: 1rem;
  }
  .ax-work-num { font-family: var(--font-mono); font-size: 0.82rem; color: var(--text-muted); transition: color 0.25s ease; }

  .ax-work-shot { position: relative; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 6px; background: var(--surface-1); margin: 0; }
  :global(.ax-work-img) {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.7s var(--ease-premium), filter 0.5s ease;
    filter: grayscale(1) brightness(0.85);
  }
  .ax-work-item:hover :global(.ax-work-img) { transform: scale(1.04); filter: grayscale(0.4) brightness(1); }
  .ax-work-item:hover .ax-work-num { color: var(--text-primary); }

  .ax-work-title { font-family: var(--font-display); font-size: 1.35rem; font-weight: 500; letter-spacing: -0.015em; color: var(--text-primary); margin: 1.1rem 0 0; }
  .ax-work-outcome { color: var(--text-secondary); font-size: 0.92rem; line-height: 1.6; margin: 0.6rem 0 0; }

  .ax-more {
    display: inline-flex; align-items: center; gap: 0.55rem; margin-top: clamp(2.5rem, 5vw, 3.5rem);
    font-family: var(--font-mono); font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.14em;
    color: var(--text-secondary); transition: color 0.2s ease, gap 0.2s ease;
  }
  .ax-more:hover { color: var(--text-primary); gap: 0.85rem; }

  /* ── Index list (services) ────────────────────────── */
  .ax-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--hairline); }
  .ax-row {
    display: grid; grid-template-columns: 3rem 1fr; grid-template-areas: 'num title' 'desc desc';
    gap: 0.5rem 1.25rem; align-items: start;
    padding-block: clamp(1.6rem, 3vw, 2.4rem); border-bottom: 1px solid var(--hairline);
    transition: background-color 0.25s ease;
  }
