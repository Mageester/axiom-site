---
import BrowserFrame from '../components/site/BrowserFrame.astro';
import CtaBand from '../components/site/CtaBand.astro';
import EmailText from '../components/site/EmailText.astro';
import FaqList from '../components/site/FaqList.astro';
import Film from '../components/site/Film.astro';
import FounderCards from '../components/site/FounderCards.astro';
import Icon from '../components/site/Icon.astro';
import IndexList from '../components/site/IndexList.astro';
import IndustryGrid from '../components/site/IndustryGrid.astro';
import PricingCards from '../components/site/PricingCards.astro';
import ResponsivePicture from '../components/site/ResponsivePicture.astro';
import WorkCard from '../components/site/WorkCard.astro';
import { homeFaq, keyNumbers, valueProps } from '../content/company';
import { packages } from '../content/pricing';
import { processSteps } from '../content/process';
import { services } from '../content/services';
import { getProject } from '../content/work';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CTA_PATHS } from '../lib/cta';
import { FILM_JSON_LD, SEO_ROUTES, SITE_EMAIL, SITE_PHONE_DISPLAY, SITE_TELEPHONE, faqJsonLd } from '../lib/seo';

const [lead, ...concepts] = ['reids-home-and-yard', 'physio-clinic', 'dental-aurelia'].map((id) => getProject(id)!);
const reelSizes = '(min-width: 1320px) 1240px, 94vw';

const statement =
  'Most local websites look fine and say very little. We build sites that explain what you do, show why you can be trusted and make the next step obvious, on the phone your customer is already holding.';

const serviceItems = services.map((service) => ({
  href: `/services/${service.slug}/`,
  title: service.name,
  text: service.cardSummary,
}));
---

<BaseLayout
  {...SEO_ROUTES.home}
  schema={[faqJsonLd(homeFaq), FILM_JSON_LD]}
  ogImageAlt="Axiom Web — clear, fast websites for local businesses in Kitchener-Waterloo"
  preload={{ type: 'image/avif', href: '/images/work-reids-1200.avif', srcset: lead.image.avifSrcSet, sizes: reelSizes }}
>
  <main id="main-content" tabindex="-1">
    <!-- Hero -->
    <section class="home-hero">
      <div class="grid-lines" aria-hidden="true"></div>
      <div class="container hero-inner">
        <h1 class="hero-title">
          <span class="hero-kicker">Web design studio in Kitchener-Waterloo, Ontario<span class="sr-only">:</span></span>
          <span class="line"><span>Websites that make</span></span>
          <span class="line"><span>your business the</span></span>
          <span class="line"><span>obvious choice.</span></span>
        </h1>

        <div class="hero-foot">
          <p class="lead">
            Axiom Web designs and builds clear, fast websites for local businesses across Kitchener-Waterloo and Ontario,
            with published pricing from CAD $900 and launch in two to four weeks.
          </p>
          <div class="btn-row">
            <a href={CTA_PATHS.startProject} class="btn btn-lg">Start a project <Icon name="arrow-right" /></a>
            <a href="/pricing/" class="btn btn-secondary btn-lg">See pricing</a>
          </div>
        </div>

        <dl class="hero-spec">
          <div><dt>Price</dt><dd>Fixed, and agreed before work starts</dd></div>
          <div><dt>Team</dt><dd>Work directly with the two founders</dd></div>
          <div><dt>Hosting</dt><dd>First year included</dd></div>
          <div><dt>Availability</dt><dd class="hero-status"><span class="status-dot" aria-hidden="true"></span>Taking new projects</dd></div>
        </dl>
      </div>

      <figure class="container hero-reel">
        <div class="reel-frame">
          <BrowserFrame url="reidshomeandyard.getaxiom.ca">
            <ResponsivePicture source={lead.image} alt={lead.alt} sizes={reelSizes} loading="eager" fetchpriority="high" position="center top" />
          </BrowserFrame>
        </div>
        <figcaption class="reel-caption">
          <span class="badge badge-success badge-dot">Client site · Live</span>
          <span class="reel-title">{lead.title}</span>
          <span class="reel-meta">{lead.industryLabel} · {lead.location}</span>
          <a class="arrow-link reel-link" href={lead.href} target="_blank" rel="noopener">
            Visit the site <span class="sr-only">(opens in a new tab)</span><Icon name="arrow-up-right" />
          </a>
        </figcaption>
      </figure>
    </section>

    <!-- Statement -->
    <section class="section statement-section" aria-labelledby="statement-label">
      <div class="container statement-grid">
        <h2 id="statement-label" class="label statement-label">Our view</h2>
        <p class="statement" data-reveal>
          {statement.split(' ').map((word, index) => (
            <>
              <span class="word" style={`--i:${index}`}>{word}</span>{' '}
            </>
          ))}
        </p>
      </div>
    </section>

    <!-- Services -->
    <section class="section section-soft" aria-labelledby="services-title">
      <div class="container">
        <div class="section-head-row reveal">
          <div class="section-head">
            <p class="eyebrow">Services</p>
            <h2 id="services-title">A website built around how your customers decide</h2>
            <p>Whether you need your first proper website or a rebuild of one that no longer fits, the goal is the same: make your business easy to understand, easy to trust and easy to contact.</p>
          </div>
          <a href="/services/" class="arrow-link">All services <Icon name="arrow-right" /></a>
        </div>
        <IndexList items={serviceItems} />
      </div>
    </section>

    <!-- Work -->
    <section class="section" aria-labelledby="work-title">
      <div class="container">
        <div class="section-head-row reveal">
          <div class="section-head">
            <p class="eyebrow">Work</p>
            <h2 id="work-title">Recent work</h2>
            <p>A live client website and concept builds that show how we structure sites for different kinds of local businesses.</p>
          </div>
          <a href="/work/" class="arrow-link">View all work <Icon name="arrow-right" /></a>
        </div>
        <div class="work-showcase reveal-stagger">
          <WorkCard project={lead} featured sizes="(min-width: 900px) 60vw, 92vw" />
          <div class="grid grid-2">
            {concepts.map((project) => <WorkCard project={project} sizes="(min-width: 720px) 45vw, 92vw" />)}
          </div>
        </div>
        <p class="work-note">Concept builds are demonstrations designed by Axiom Web and are labelled clearly. They are not client results.</p>
      </div>
    </section>

    <!-- Film -->
    <section class="section section-soft" aria-labelledby="film-title">
      <div class="container">
        <div class="section-head reveal">
          <p class="eyebrow">Studio film</p>
          <h2 id="film-title">Built to the pixel.</h2>
          <p>Thirty-two seconds on how we approach every website: structure first, then the details most people never notice but every visitor feels.</p>
        </div>
        <div class="reveal">
          <Film />
        </div>
      </div>
    </section>

    <!-- Why Axiom -->
    <section class="section" aria-labelledby="why-title">
      <div class="container split">
        <div class="section-head split-head">
          <p class="eyebrow">Why Axiom Web</p>
          <h2 id="why-title">Built properly. Priced plainly.</h2>
          <p>Every website we build follows the same standard, whatever the package. You know the price before we start, and you know who is building your site.</p>
          <a href="/about/" class="arrow-link">About the studio <Icon name="arrow-right" /></a>
        </div>
        <ol role="list" class="principles reveal-stagger">
          {valueProps.map((item, index) => (
            <li class="principle">
              <span class="index-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Numerals -->
    <section class="numerals" aria-labelledby="numerals-title">
      <div class="container">
        <h2 id="numerals-title" class="sr-only">Axiom Web at a glance</h2>
        <ul role="list" class="numerals-grid reveal-stagger">
          {keyNumbers.map((item) => (
            <li>
              <span class="numeral">{item.value}</span>
              <span class="numeral-label">{item.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Process -->
    <section class="section" aria-labelledby="process-title">
      <div class="container split">
        <div class="section-head split-head">
          <p class="eyebrow">How it works</p>
          <h2 id="process-title">From first conversation to launch in four steps</h2>
          <p>A simple, predictable process. Scope and price are agreed in writing before design starts, so there are no surprises later.</p>
          <a href="/approach/" class="arrow-link">See the full process <Icon name="arrow-right" /></a>
        </div>
        <div class="rail" data-reveal>
          <span class="rail-line" aria-hidden="true"><span class="rail-fill"></span></span>
          <ol role="list" class="rail-list reveal-stagger">
            {processSteps.map((step) => (
              <li class="rail-step">
                <span class="rail-dot" aria-hidden="true"></span>
                <span class="rail-num" aria-hidden="true">{step.number}</span>
                <div class="rail-body">
                  <p class="rail-timing">Step {Number(step.number)} · {step.timing}</p>
                  <h3>{step.title}</h3>
                  <p>{step.summary}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section class="section section-soft" aria-labelledby="pricing-title">
      <div class="container">
        <div class="section-head-row reveal">
          <div class="section-head">
            <p class="eyebrow">Pricing</p>
            <h2 id="pricing-title">Published packages. No guesswork.</h2>
            <p>Choose the package that fits your business today. Every standard package includes first-year hosting, two revision rounds and thirty days of support after launch.</p>
          </div>
          <a href="/pricing/" class="arrow-link">Compare packages <Icon name="arrow-right" /></a>
        </div>
        <div class="reveal">
          <PricingCards packages={packages} compact />
        </div>
      </div>
    </section>

    <!-- Industries -->
    <section class="section" aria-labelledby="industries-title">
      <div class="container">
        <div class="section-head-row reveal">
          <div class="section-head">
            <p class="eyebrow">Industries</p>
            <h2 id="industries-title">Websites for local service businesses</h2>
            <p>Different businesses win customers in different ways. We plan each site around what your buyers need to see before they get in touch.</p>
          </div>
          <a href="/industries/" class="arrow-link">All industries <Icon name="arrow-right" /></a>
        </div>
        <IndustryGrid />
      </div>
    </section>

    <!-- Founders -->
    <section class="section section-soft" aria-labelledby="team-title">
      <div class="container split">
        <div class="section-head split-head">
          <p class="eyebrow">Who you’ll work with</p>
          <h2 id="team-title">Two founders. No account managers.</h2>
          <p>
            Aidan Magee and Riley Hinsperger are the co-founders of Axiom Web, the web-focused subsidiary of Axiom International.
            You work directly with the people who plan, design and build your website.
          </p>
          <a href="/about/" class="arrow-link">Meet the founders <Icon name="arrow-right" /></a>
        </div>
        <div class="reveal">
          <FounderCards />
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section" aria-labelledby="faq-title">
      <div class="container split">
        <div class="section-head split-head">
          <p class="eyebrow">FAQ</p>
          <h2 id="faq-title">Common questions</h2>
          <p>Straight answers about cost, timing and what working with us looks like.</p>
          <div class="faq-contact">
            <p class="small muted">Still have a question?</p>
            <a class="text-link" href={`tel:${SITE_TELEPHONE}`}>{SITE_PHONE_DISPLAY}</a>
            <a class="text-link" href={`mailto:${SITE_EMAIL}`}><EmailText /></a>
          </div>
        </div>
        <FaqList items={homeFaq} openFirst />
      </div>
    </section>

    <CtaBand title="Let’s make your business the obvious choice." />
  </main>
</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────── */
  .home-hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(2.5rem, 1rem + 5vh, 5rem);
    isolation: isolate;
  }

  .hero-inner {
    position: relative;
    display: grid;
    gap: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
  }

  /* The primary search phrase, set as a small label line inside the h1. */
  .hero-kicker {
    display: block;
    margin-bottom: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--line);
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    font-weight: 600;
    font-stretch: var(--wdth-heading);
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .status-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--success);
  }

  /* Each line rises from its own mask. */
  .hero-title {
    font-size: clamp(2.1rem, 0.75rem + 6.6vw, 6.75rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .hero-title .line {
    max-width: 17ch;
  }

  .hero-title .line {
    display: block;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
    overflow: hidden;
  }

  .hero-title .line > span {
    display: inline-block;
  }

  /* On phones the fixed line breaks would strand single words, so the headline
     wraps naturally (balanced) and fades in instead of rising line by line. */
  @media (max-width: 639px) {
    .hero-title .line,
    .hero-title .line > span {
      display: inline;
      overflow: visible;
      padding: 0;
      margin: 0;
    }
  }

  .hero-foot {
    display: grid;
    gap: 1.75rem;
    align-items: end;
  }

  .hero-foot .lead {
    max-width: 36rem;
  }

  @media (min-width: 1024px) {
    .hero-foot {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 4rem;
    }
  }

  .hero-spec {
    display: grid;
    margin: 0.5rem 0 0;
    border-top: 1px solid var(--line);
  }

  .hero-spec > div {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-sm);
  }

  .hero-spec dt {
    color: var(--text-muted);
    font-size: var(--fs-label);
    font-weight: 600;
    font-stretch: var(--wdth-heading);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.9;
  }

  .hero-spec dd {
    margin: 0;
    color: var(--ink-2);
  }

  @media (min-width: 900px) {
    .hero-spec {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      border-bottom: 1px solid var(--line);
    }
    .hero-spec > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
      padding: 1rem 1.5rem 1rem 0;
      border-bottom: 0;
    }
    .hero-spec > div + div {
      padding-left: 1.5rem;
      border-left: 1px solid var(--line);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-kicker,
    .hero-foot,
    .hero-spec {
      animation: hero-fade 900ms var(--ease-out) both;
    }
    .hero-title .line > span {
      animation: line-rise 950ms var(--ease-out) both;
    }
    .hero-title .line:nth-child(1) > span {
      animation-delay: 60ms;
    }
    .hero-title .line:nth-child(2) > span {
      animation-delay: 140ms;
    }
    .hero-title .line:nth-child(3) > span {
      animation-delay: 220ms;
    }
    .hero-foot {
      animation-delay: 380ms;
    }
    .hero-spec {
      animation-delay: 480ms;
    }
    .hero-reel {
      animation: hero-fade 1200ms var(--ease-out) 420ms both;
    }
  }

  @media (prefers-reduced-motion: no-preference) and (max-width: 639px) {
    .hero-title .line > span {
      animation-name: line-fade;
    }
  }

  @keyframes line-rise {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes line-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* ── Hero reel: the real work, large ──────────────────── */
  .hero-reel {
    margin-top: clamp(3rem, 2rem + 4vw, 5.5rem);
  }

  .reel-frame :global(.browser) {
    border-radius: var(--radius-lg);
  }

  .reel-frame :global(.browser-view) {
    aspect-ratio: 16 / 9;
  }

  .reel-caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    padding-block: 1rem 0;
    font-size: var(--fs-sm);
  }

  .reel-title {
    color: var(--ink);
    font-weight: 600;
  }

  .reel-meta {
    color: var(--text-muted);
  }

  .reel-link {
    margin-left: auto;
    min-height: 2.25rem;
  }

  /* ── Statement ────────────────────────────────────────── */
  .statement-grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 1024px) {
    .statement-grid {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      gap: 2rem;
    }
  }

  .statement-label {
    align-self: start;
    padding-top: 0.6rem;
    font-family: var(--font-sans);
  }

  .statement {
    max-width: 24ch;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 0.9rem + 3.2vw, 3.6rem);
    font-weight: 500;
    font-stretch: var(--wdth-heading);
    line-height: 1.12;
    letter-spacing: -0.035em;
    text-wrap: pretty;
  }

  /* Once the statement is well into view, its words brighten in reading order.
     The resting state stays above 3:1, the large-text contrast minimum. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.reveal-ready) .statement .word {
      opacity: 0.45;
      transition: opacity 600ms var(--ease) calc(var(--i) * 28ms);
    }
    :global(.reveal-ready) .statement:global(.is-revealed) .word {
      opacity: 1;
    }
  }

  /* ── Work ─────────────────────────────────────────────── */
  .work-showcase {
    display: grid;
    gap: clamp(1rem, 0.6rem + 1.2vw, 1.5rem);
  }

  .work-note {
    margin-top: 1.5rem;
    color: var(--text-muted);
    font-size: var(--fs-xs);
  }

  /* ── Split sections ───────────────────────────────────── */
  .split {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .split {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
      gap: clamp(3rem, 2rem + 4vw, 6rem);
      align-items: start;
    }

    .split-head {
      position: sticky;
      top: calc(var(--header-h) + 2.5rem);
    }
  }

  .split-head {
    margin-bottom: 0;
    justify-items: start;
  }

  /* ── Principles: numbered, no icons ───────────────────── */
  .principles {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--line-strong);
  }

  @media (min-width: 640px) {
    .principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2.5rem;
    }
  }

  .principle {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding-block: 1.5rem 1.75rem;
    border-bottom: 1px solid var(--line);
  }

  .principle h3 {
    font-size: 1.125rem;
  }

  .principle p {
    color: var(--text);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  /* ── Numerals ─────────────────────────────────────────── */
  .numerals {
    position: relative;
    padding-block: clamp(4rem, 2.5rem + 5vw, 7rem);
    border-block: 1px solid var(--line);
  }

  .numerals-grid {
    display: grid;
    gap: 2.5rem 1.5rem;
    margin: 0;
  }

  @media (min-width: 640px) {
    .numerals-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .numerals-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .numerals-grid li + li {
      border-left: 1px solid var(--line);
      padding-left: 2rem;
    }
  }

  .numerals-grid li {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .numeral {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 2.2rem + 4vw, 5.75rem);
    font-weight: 500;
    font-stretch: var(--wdth-display);
    line-height: 0.95;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }

  .numeral-label {
    max-width: 16rem;
    color: var(--text);
    font-size: var(--fs-sm);
  }

  /* ── Process rail ─────────────────────────────────────── */
  .rail {
    position: relative;
  }

  .rail-list {
    display: grid;
    margin: 0;
  }

  .rail-line {
    position: absolute;
    top: 0.75rem;
    bottom: 0.75rem;
    left: 0.25rem;
    width: 1px;
    background: var(--line-strong);
  }

  .rail-fill {
    position: absolute;
    inset: 0;
    background: var(--ink);
    transform-origin: 50% 0;
  }

  .rail-step {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.25rem 1.5rem;
    padding: 0 0 clamp(2.5rem, 2rem + 2vw, 3.5rem) 2rem;
  }

  .rail-step:last-child {
    padding-bottom: 0;
  }

  .rail-dot {
    position: absolute;
    top: 0.55rem;
    left: 0.25rem;
    width: 0.5rem;
    height: 0.5rem;
    margin-left: -0.25rem;
    background: var(--ink);
    box-shadow: 0 0 0 5px var(--bg);
  }

  .rail-num {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.8rem + 2vw, 3.25rem);
    font-weight: 500;
    font-stretch: var(--wdth-display);
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }

  .rail-body {
    display: grid;
    gap: 0.45rem;
  }

  .rail-timing {
    color: var(--text-muted);
    font-size: var(--fs-label);
    font-weight: 600;
    font-stretch: var(--wdth-heading);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

