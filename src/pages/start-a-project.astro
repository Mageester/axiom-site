---
import IntakeForm from '../components/site/IntakeForm.astro';
import { FadeIn } from '../components/ui/FadeIn';
import SiteLayout from '../layouts/SiteLayout.astro';
import { SEO_ROUTES, START_PROJECT_JSON_LD, SITE_URL, breadcrumbSchema } from '../lib/seo';
import { CTA_PATHS } from '../lib/cta';
import { Eyebrow } from '../components/ui/Eyebrow';
import { MotionHeading } from '../components/motion/MotionHeading';
import { SectionDivider } from '../components/motion/SectionDivider';

const heroCopy = {
  eyebrow: 'START A PROJECT',
  heading: 'Tell us what the site needs to fix.',
  sub: 'Five short steps. We review the business, the current site, and the right next step before we reply.',
};

const followupSteps = ['We review the business and site', 'You get a reply within one business day', 'If there is a fit, you get a clear scope'];
---

<SiteLayout
  title={SEO_ROUTES.startProject.title}
  description={SEO_ROUTES.startProject.description}
  canonicalPath="/start-a-project"
  schema={[START_PROJECT_JSON_LD, breadcrumbSchema([{ name: 'Home', url: SITE_URL }, { name: 'Start a Project', url: `${SITE_URL}/start-a-project` }])]}
>
  <main id="main-content" tabindex="-1" class="pb-20 md:pb-24">
    <section class="axiom-container pt-14 md:pt-20">
      <div class="mx-auto max-w-5xl">
        <div class="mx-auto max-w-3xl text-center">
          <FadeIn motion="eyebrow">
            <div data-teardown-target="eyebrow"><Eyebrow>{heroCopy.eyebrow}</Eyebrow></div>
            <SectionDivider className="mx-auto mt-6" />
          </FadeIn>
          <FadeIn motion="sceneOpen" delay={180}>
            <div data-teardown-target="heading"><MotionHeading as="h1" text={heroCopy.heading} className="mt-4" /></div>
          </FadeIn>
          <FadeIn motion="editorialMaskReveal" delay={460}>
            <p class="section-copy mx-auto mt-5 max-w-2xl md:text-[17px]" data-teardown-target="sub">
              {heroCopy.sub}
            </p>
          </FadeIn>

          <FadeIn motion="formFocusMotion" delay={580}>
            <div class="mt-7 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-[12px] font-medium uppercase tracking-[0.14em] text-[var(--text-secondary)]">
              <span>ABOUT 2 MINUTES</span>
              <span aria-hidden="true" class="text-[var(--text-muted)]">&bull;</span>
              <span>MONTHLY OR OWNERSHIP</span>
              <span aria-hidden="true" class="text-[var(--text-muted)]">&bull;</span>
              <span>REPLY WITHIN ONE BUSINESS DAY</span>
            </div>
          </FadeIn>
        </div>

        <div class="mt-8 md:mt-10">
          <div class="mx-auto w-full max-w-3xl">
            <IntakeForm
              kind="project"
              endpoint="/api/intake"
              title="Start with the business and the site."
              eyebrow="PROJECT INTAKE"
              description="A few clear details are enough for us to recommend monthly, ownership, or a custom scope."
              helper="Plain language is perfect. Tell us what is unclear, outdated, slow, or hard for buyers to do."
              submitLabel={`Send project details \u2192`}
              successTitle="Project details received."
              successText="We will review the business, the current site, and the right next step before we reply."
              noteLinkHref={CTA_PATHS.contact}
              noteLinkLabel="contact page"
              noteText="Need a quick question instead? Use the"
            />
          </div>
        </div>

        <FadeIn as="div" motion="formFocusMotion" className="mx-auto mt-5 max-w-3xl">
          <div class="grid gap-3 rounded-[22px] border border-[color:var(--hairline)] bg-[rgba(255,255,255,0.018)] p-5 text-left sm:grid-cols-3">
            {followupSteps.map((item, index) => (
              <p class="flex gap-3 text-[14px] leading-[1.6] text-[var(--text-secondary)]">
                <span class="font-mono text-[12px] text-[var(--accent-solid)]">0{index + 1}</span>
                <span data-teardown-target={`step${index + 1}`}>{item}</span>
              </p>
            ))}
          </div>
        </FadeIn>
      </div>
    </section>
  </main>

  <script is:inline>
    (function () {
      try {
        var params = new URLSearchParams(window.location.search);
        if (params.get('path') !== 'teardown') return;
        var swaps = {
          eyebrow: 'FREE SITE TEARDOWN',
          heading: "Send the URL. We'll send the teardown.",
          sub: "Tell us your site, your business, and what you want more of. We reply within one business day with a short teardown: what's working, what's creating friction, and what we would change first. No sales call, no obligation.",
          step1: 'We review your site',
          step2: 'You get a teardown within one business day',
          step3: 'If you want help, we recommend the next step'
        };
        document.title = 'Free Site Teardown | Axiom Web';
        Object.keys(swaps).forEach(function (key) {
          var el = document.querySelector('[data-teardown-target="' + key + '"]');
          if (!el) return;
          el.textContent = swaps[key];
        });
      } catch (e) { /* noop */ }
    })();
  </script>

  <style is:global>
    .project-intake-wizard [data-step-panel] {
      animation: wizard-step-in 360ms var(--ease-premium-soft);
      transform-origin: top center;
    }

    .project-intake-wizard [data-step-panel].wizard-step-panel-backward {
      animation-name: wizard-step-in-backward;
    }

    @keyframes wizard-step-in {
      from {
        opacity: 0;
        transform: translate3d(0, 10px, 0);
      }

      to {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }
    }

    @keyframes wizard-step-in-backward {
      from {
        opacity: 0;
        transform: translate3d(0, -8px, 0);
      }

      to {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .project-intake-wizard [data-step-panel] {
        animation: none;
      }
    }
  </style>
</SiteLayout>
