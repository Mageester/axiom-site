---
import EmailText from '../components/site/EmailText.astro';
import Icon from '../components/site/Icon.astro';
import IntakeForm from '../components/site/IntakeForm.astro';
import PageHero from '../components/site/PageHero.astro';
import { packages } from '../content/pricing';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SEO_ROUTES, SITE_EMAIL, SITE_PHONE_DISPLAY, SITE_TELEPHONE, type Crumb } from '../lib/seo';

const crumbs: Crumb[] = [
  { name: 'Home', url: '/' },
  { name: 'Start a project', url: '/start-a-project/' },
];

const steps = [
  { title: 'We review your business', text: 'We look at what you sent and your current site, if you have one.' },
  { title: 'You hear back within one business day', text: 'A reply from the founders with the package we recommend and the price.' },
  { title: 'You decide, with no pressure', text: 'If it’s a fit, we send a written scope. If not, we’ll tell you honestly.' },
] as const;
---

<BaseLayout {...SEO_ROUTES.startProject} pageType="ContactPage" crumbs={crumbs} showCta={false}>
  <main id="main-content" tabindex="-1">
    <PageHero eyebrow="Start a project" title="Tell us about your project" crumbs={crumbs}>
      <p class="lead" data-swap="lead">
        It takes about two minutes. We reply within one business day with the right package, a clear price and the next step. No obligation.
      </p>
    </PageHero>

    <section class="section start-section">
      <div class="container start-grid">
        <IntakeForm
          kind="project"
          title="Your project details"
          description="Plain language is perfect. Tell us what the business does and what the website needs to do."
        />

        <aside class="start-aside" aria-label="What to expect">
          <div class="card aside-card">
            <h2 class="aside-title">What happens next</h2>
            <ol role="list" class="aside-steps">
              {steps.map((step, index) => (
                <li>
                  <span class="aside-num" aria-hidden="true">{index + 1}</span>
                  <div>
                    <h3>{step.title}</h3>
                    <p>{step.text}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>

          <div class="card aside-card">
            <h2 class="aside-title">Packages at a glance</h2>
            <ul role="list" class="aside-packages">
              {packages.map((pkg) => (
                <li>
                  <span>{pkg.name}<small>{pkg.scope}</small></span>
                  <strong>{pkg.priceValue ? `From ${pkg.price}` : pkg.price}</strong>
                </li>
              ))}
            </ul>
            <a href="/pricing/" class="arrow-link">Compare packages <Icon name="arrow-right" /></a>
          </div>

          <div class="card aside-card aside-direct">
            <h2 class="aside-title">Prefer to talk?</h2>
            <a href={`tel:${SITE_TELEPHONE}`} class="direct-link"><Icon name="phone" size={18} /> {SITE_PHONE_DISPLAY}</a>
            <a href={`mailto:${SITE_EMAIL}`} class="direct-link"><Icon name="mail" size={18} /> <EmailText /></a>
          </div>
        </aside>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  // Outreach links use ?path=teardown for a free site review; adjust the intro to match.
  if (new URLSearchParams(window.location.search).get('path') === 'teardown') {
    const lead = document.querySelector('[data-swap="lead"]');
    const title = document.querySelector('.page-hero h1');
    if (title) title.textContent = 'Request a free site teardown';
    if (lead)
      lead.textContent =
        'Send your website and what you want more of. Within one business day we reply with a short teardown: what is working, what is creating friction and what we would change first. No sales call, no obligation.';
    document.title = 'Free Site Teardown | Axiom Web';
  }
</script>

<style>
  .start-section {
    padding-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .start-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .start-grid {
      grid-template-columns: minmax(0, 1.5fr) minmax(18rem, 0.8fr);
      gap: 2.5rem;
      align-items: start;
    }

    .start-aside {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }

  .start-aside {
    display: grid;
    gap: 1rem;
  }

  .aside-card {
    gap: 1rem;
    padding: 1.5rem;
  }

  .aside-title {
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .aside-steps {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  .aside-steps li {
    display: flex;
    gap: 0.85rem;
  }

  .aside-num {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    flex: none;
    border-radius: 999px;
    background: var(--brand-soft);
    color: var(--accent);
    font-size: var(--fs-xs);
    font-weight: 700;
  }

  .aside-steps h3 {
    font-size: var(--fs-sm);
  }

  .aside-steps p {
    color: var(--text);
    font-size: var(--fs-sm);
    line-height: 1.5;
  }

  .aside-packages {
    display: grid;
    margin: 0;
  }

  .aside-packages li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-sm);
  }

  .aside-packages li:first-child {
    padding-top: 0;
  }

  .aside-packages span {
    color: var(--ink);
    font-weight: 600;
  }

  .aside-packages small {
    display: block;
    color: var(--text-muted);
    font-size: var(--fs-xs);
    font-weight: 400;
  }

  .aside-packages strong {
    white-space: nowrap;
  }

  .aside-direct {
    gap: 0.5rem;
  }

  .direct-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.5rem;
    color: var(--ink);
    font-size: var(--fs-sm);
    font-weight: 600;
    word-break: break-word;
  }

  .direct-link :global(svg) {
    flex: none;
    color: var(--accent);
  }

  .direct-link:hover {
    color: var(--accent);
  }
</style>
