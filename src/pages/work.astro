---
import BrowserFrame from '../components/site/BrowserFrame.astro';
import CtaBand from '../components/site/CtaBand.astro';
import Icon from '../components/site/Icon.astro';
import PageHero from '../components/site/PageHero.astro';
import ResponsivePicture from '../components/site/ResponsivePicture.astro';
import WorkCard from '../components/site/WorkCard.astro';
import { everydayBuilds, projects } from '../content/work';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CTA_PATHS } from '../lib/cta';
import { SEO_ROUTES, SITE_URL, itemListSchema, type Crumb } from '../lib/seo';

const crumbs: Crumb[] = [
  { name: 'Home', url: '/' },
  { name: 'Work', url: '/work/' },
];

const client = projects.find((project) => project.kind === 'client')!;
const concepts = projects.filter((project) => project.kind === 'concept');
const numberWords = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve'];
const conceptWord = numberWords[concepts.length] ?? String(concepts.length);
const everydayWord = numberWords[everydayBuilds.length] ?? String(everydayBuilds.length);
const allWork = [...projects, ...everydayBuilds];
---

<BaseLayout
  {...SEO_ROUTES.work}
  pageType="CollectionPage"
  crumbs={crumbs}
  schema={itemListSchema(
    'Axiom Web portfolio',
    allWork.map((project) => ({
      name: project.kind === 'client' ? project.title : `${project.title} (concept build)`,
      url: new URL(project.href, SITE_URL).href,
      description: project.summary,
    }))
  )}
>
  <main id="main-content" tabindex="-1">
    <PageHero
      eyebrow="Work"
      title="Websites we’ve designed and built"
      lead={`One live client website, ${everydayWord} everyday builds that show the sites most small businesses actually need, and ${conceptWord} design experiments that show our range. Everything except the client site is a fictional business, and every one is labelled as such.`}
      crumbs={crumbs}
    >
      <Fragment slot="actions">
        <a href={CTA_PATHS.startProject} class="btn btn-lg">Start a project <Icon name="arrow-right" /></a>
        <a href="#everyday-title" class="btn btn-secondary btn-lg">See the everyday builds</a>
      </Fragment>
    </PageHero>

    <section class="section" aria-labelledby="client-heading">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Live</p>
          <h2 id="client-heading">Client work</h2>
        </div>
        <article class="featured" aria-labelledby="client-title">
          <BrowserFrame url="reidshomeandyard.getaxiom.ca" class="featured-frame">
            <ResponsivePicture
              source={client.image}
              alt={client.alt}
              sizes="(min-width: 1024px) 640px, 92vw"
              position="center top"
              loading="eager"
              fetchpriority="high"
            />
          </BrowserFrame>
          <div class="featured-copy">
            <span class="badge badge-success badge-dot">Client site · Live</span>
            <p class="featured-meta">{client.industryLabel} · {client.location}</p>
            <h3 id="client-title" class="featured-title">{client.title}</h3>
            <p class="featured-summary">{client.summary}</p>
            <dl class="featured-details">
              <div>
                <dt>The brief</dt>
                <dd>{client.brief}</dd>
              </div>
              <div>
                <dt>What we built</dt>
                <dd>{client.built}</dd>
              </div>
            </dl>
            <a href={client.href} class="btn" target="_blank" rel="noopener">
              Visit the live site <span class="sr-only">(opens in a new tab)</span> <Icon name="arrow-up-right" />
            </a>
          </div>
        </article>
      </div>
    </section>

    <section class="section" id="everyday" aria-labelledby="everyday-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Concept builds</p>
          <h2 id="everyday-title">Everyday builds</h2>
          <p>
            The sites most local businesses actually need: an online store, a portfolio for a creative studio and a
            service business that gets booked by phone. They use no heavy effects, just fast pages that work on a phone and
            with a keyboard.
          </p>
        </div>
        <ul role="list" class="grid grid-3 builds">
          {everydayBuilds.map((project) => (
            <li>
              <WorkCard project={project} />
            </li>
          ))}
        </ul>
        <p class="builds-note">
          All {everydayWord} are fictional businesses. Their checkout, forms and reviews are examples: nothing is sold, sent or
          stored, and none of them is a client result.
        </p>
      </div>
    </section>

    <section class="concepts" aria-labelledby="concepts-title">
      <div class="container concepts-head">
        <p class="eyebrow">Concept experiments</p>
        <h2 id="concepts-title">{conceptWord.charAt(0).toUpperCase() + conceptWord.slice(1)} design <em>experiments.</em></h2>
        <p>
          Each one is a working site for a fictional local business, built around a single idea from that trade, to show our
          range with real-time 3D, simulation and heavy interaction. They are experiments rather than the everyday sites above,
          and they are not client results. Open one and play with it.
        </p>
      </div>
      <ol role="list" class="stack">
        {concepts.map((project, index) => (
          <li class="stack-item" style={`--i: ${index}`}>
            <a class="stack-card" href={project.href} data-cursor="Open">
              <div class="stack-media">
                <ResponsivePicture source={project.image} alt={project.alt} sizes="(min-width: 1500px) 1360px, 94vw" position={project.position} loading="eager" />
              </div>
              <div class="stack-copy">
                <div class="stack-title">
                  <p class="mono stack-meta">
                    <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                    <span>{project.industryLabel}</span>
                    <span class="stack-kind">Concept (fictional business)</span>
                  </p>
                  <h3>{project.title}</h3>
                </div>
                <div class="stack-side">
                  <p>{project.summary}</p>
                  <span class="stack-open">Open the concept <Icon name="arrow-right" /></span>
                </div>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <CtaBand
      title="Want a website like these for your business?"
      text="Tell us what you do and what your current site is missing. We reply within one business day with a recommended package and a clear price."
    />
  </main>
</BaseLayout>

<style>
  .featured {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .featured {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: 4rem;
    }
  }

  .featured-copy {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .featured-title {
    font-size: var(--fs-h2);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .featured-meta {
    color: var(--text-muted);
    font-size: var(--fs-xs);
    font-weight: 600;
  }

  .featured-summary {
    font-size: var(--fs-lead);
  }

  .featured-details {
    display: grid;
    gap: 1rem;
    width: 100%;
    margin: 0.5rem 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .featured-details dt {
    color: var(--ink);
    font-weight: 650;
  }

  .featured-details dd {
    margin: 0.2rem 0 0;
  }

  .builds {
    margin: 0;
    padding: 0;
  }

  .builds-note {
    max-width: 44rem;
    margin-top: 2rem;
    color: var(--text);
    font-size: var(--fs-sm);
  }

  /* ── Concepts: a deck of cards that stack as you scroll ───── */
  .concepts {
    padding-block: clamp(2rem, 1rem + 4vw, 5rem) clamp(4rem, 2rem + 6vw, 8rem);
  }

  .concepts-head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }

  .concepts-head h2 {
    max-width: 14ch;
    font-size: clamp(2.75rem, 1rem + 7vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .concepts-head p:last-child {
    max-width: 44ch;
    font-size: var(--fs-lead);
  }

  .stack {
    display: grid;
    gap: 1.25rem;
    width: min(100%, calc(var(--container) + var(--gutter) * 2));
    margin: 0 auto;
    padding-inline: var(--gutter);
  }

  .stack-card {
    display: grid;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--night);
    color: var(--snow);
    text-decoration: none;
  }

  .stack-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .stack-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .stack-media :global(img) {
    transition: transform 1400ms var(--ease-out);
  }

  .stack-copy {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 0.75rem + 2vw, 2.5rem);
  }

  .stack-kind { opacity: 0.75; }

  .stack-kind::before { content: "·"; margin: 0 0.5em; }


  .stack-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 0.75rem;
    color: var(--mute-night);
  }

  .stack-copy h3 {
    color: inherit;
    font-size: clamp(2rem, 1rem + 4.5vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .stack-side {
    display: grid;
    gap: 1rem;
    align-content: end;
    justify-items: start;
    color: var(--mute-night);
  }

  .stack-open {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--snow);
    font-weight: 500;
  }

  .stack-open :global(svg) {
    transition: transform 500ms var(--ease-out);
  }

  @media (hover: hover) {
    .stack-card:hover .stack-media :global(img) {
      transform: scale(1.03);
    }
    .stack-card:hover .stack-open :global(svg) {
      transform: translateX(6px);
    }
  }

  @media (min-width: 900px) {
    .stack {
      gap: 0;
    }

    /* Each card pins just below the last one's edge, so they deal over each other.
       A pinned card has to fit the screen, or its title would never come into view. */
    .stack-item {
      position: sticky;
      top: calc(var(--header-h) + var(--i) * 12px);
      padding-bottom: 2rem;
    }

    .stack-card {
      grid-template-rows: minmax(0, 1fr) auto;
      height: calc(100svh - var(--header-h) - 2.5rem - var(--i) * 12px);
      min-height: 30rem;
    }

    .stack-media {
      aspect-ratio: auto;
      min-height: 0;
    }

    .stack-copy {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: 3rem;
      align-items: end;
    }
  }
</style>
