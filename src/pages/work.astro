---
import BrowserFrame from '../components/site/BrowserFrame.astro';
import CtaBand from '../components/site/CtaBand.astro';
import Icon from '../components/site/Icon.astro';
import PageHero from '../components/site/PageHero.astro';
import ResponsivePicture from '../components/site/ResponsivePicture.astro';
import WorkCard from '../components/site/WorkCard.astro';
import { projects } from '../content/work';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CTA_PATHS } from '../lib/cta';
import { SEO_ROUTES, itemListSchema, type Crumb } from '../lib/seo';

const crumbs: Crumb[] = [
  { name: 'Home', url: '/' },
  { name: 'Work', url: '/work/' },
];

const client = projects.find((project) => project.kind === 'client')!;
const concepts = projects.filter((project) => project.kind === 'concept');
---

<BaseLayout
  {...SEO_ROUTES.work}
  pageType="CollectionPage"
  crumbs={crumbs}
  schema={itemListSchema(
    'Axiom Web portfolio',
    projects.map((project) => ({
      name: project.kind === 'client' ? project.title : `${project.title} (concept build)`,
      url: project.href,
      description: project.summary,
    }))
  )}
>
  <main id="main-content" tabindex="-1">
    <PageHero
      eyebrow="Work"
      title="Websites we’ve designed and built"
      lead="A live client website, plus concept builds that show how we structure sites for different kinds of local businesses. Every concept is clearly labelled."
      crumbs={crumbs}
    >
      <Fragment slot="actions">
        <a href={CTA_PATHS.startProject} class="btn btn-lg">Start a project <Icon name="arrow-right" /></a>
        <a href="/services/" class="btn btn-secondary btn-lg">Our services</a>
      </Fragment>
    </PageHero>

    <section class="section" aria-labelledby="client-title">
      <div class="container">
        <article class="featured">
          <BrowserFrame url="reidshomeandyard.getaxiom.ca" class="featured-frame">
            <ResponsivePicture
              source={client.image}
              alt={client.alt}
              sizes="(min-width: 1024px) 640px, 92vw"
              position="center top"
              loading="eager"
              fetchpriority="high"
            />
          </BrowserFrame>
          <div class="featured-copy">
            <span class="badge badge-success badge-dot">Client site · Live</span>
            <p class="featured-meta">{client.industryLabel} · {client.location}</p>
            <h2 id="client-title">{client.title}</h2>
            <p class="featured-summary">{client.summary}</p>
            <dl class="featured-details">
              <div>
                <dt>The brief</dt>
                <dd>{client.brief}</dd>
              </div>
              <div>
                <dt>What we built</dt>
                <dd>{client.built}</dd>
              </div>
            </dl>
            <a href={client.href} class="btn" target="_blank" rel="noopener">
              Visit the live site <span class="sr-only">(opens in a new tab)</span> <Icon name="arrow-up-right" />
            </a>
          </div>
        </article>
      </div>
    </section>

    <section class="section section-soft" aria-labelledby="concepts-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Concept builds</p>
          <h2 id="concepts-title">How we approach different industries</h2>
          <p>
            Concept builds are working demonstration websites designed by Axiom Web. Each one starts from a common problem in its
            industry and shows how we would structure the site to solve it. They are not client results.
          </p>
        </div>
        <div class="grid grid-3 reveal-stagger">
          {concepts.map((project) => <WorkCard project={project} detailed />)}
        </div>
      </div>
    </section>

    <CtaBand
      title="Want a website like these for your business?"
      text="Tell us what you do and what your current site is missing. We reply within one business day with a recommended package and a clear price."
    />
  </main>
</BaseLayout>

<style>
  .featured {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .featured {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: 4rem;
    }
  }

  .featured-copy {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .featured-meta {
    color: var(--text-muted);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .featured-summary {
    font-size: var(--fs-lead);
  }

  .featured-details {
    display: grid;
    gap: 1rem;
    width: 100%;
    margin: 0.5rem 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .featured-details dt {
    color: var(--ink);
    font-weight: 650;
  }

  .featured-details dd {
    margin: 0.2rem 0 0;
  }
</style>
