---
import CtaBand from '../../components/site/CtaBand.astro';
import PageHero from '../../components/site/PageHero.astro';
import { guides } from '../../content/guides';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SEO_ROUTES, SITE_URL, itemListSchema, type Crumb } from '../../lib/seo';

const crumbs: Crumb[] = [
  { name: 'Home', url: '/' },
  { name: 'Guides', url: '/guides/' },
];
---

<BaseLayout
  {...SEO_ROUTES.guides}
  pageType="CollectionPage"
  crumbs={crumbs}
  schema={itemListSchema(
    'Website guides for small businesses',
    guides.map((guide) => ({ name: guide.title, url: `${SITE_URL}/guides/${guide.slug}/`, description: guide.metaDescription }))
  )}
>
  <main id="main-content" tabindex="-1">
    <PageHero
      eyebrow="Guides"
      title="Straight answers before you hire anyone"
      lead="What a website costs, what it should include and what to prepare. Written for small business owners in Ontario, using our real prices and process."
      crumbs={crumbs}
    />

    <section class="section" aria-labelledby="guides-title">
      <div class="container">
        <h2 id="guides-title" class="sr-only">All guides</h2>
        <ul role="list" class="guide-list">
          {guides.map((guide) => (
            <li>
              <a href={`/guides/${guide.slug}/`} class="card guide-card">
                <span class="guide-card-title">{guide.title}</span>
                <span class="guide-card-lead">{guide.lead}</span>
                <span class="guide-card-meta mono">{guide.readMinutes} minute read</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <CtaBand />
  </main>
</BaseLayout>

<style>
  .guide-list {
    display: grid;
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 900px) {
    .guide-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .guide-card {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .guide-card-title {
    color: var(--ink);
    font-size: var(--fs-lg);
    font-weight: 600;
    line-height: 1.25;
  }

  .guide-card-lead {
    color: var(--text);
    font-size: var(--fs-sm);
  }

  .guide-card-meta {
    color: var(--text-muted);
    font-size: var(--fs-xs);
  }
</style>
