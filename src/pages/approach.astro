---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Card } from '../components/ui/card';
import { Eyebrow } from '../components/ui/Eyebrow';
import DrawIcon from '../components/ui/DrawIcon.astro';
import { FadeIn } from '../components/ui/FadeIn';
import { MotionHeading } from '../components/motion/MotionHeading';
import { SectionDivider } from '../components/motion/SectionDivider';
import { CTA_PATHS } from '../lib/cta';
import { APPROACH_JSON_LD, SEO_ROUTES, SITE_URL, breadcrumbSchema } from '../lib/seo';

const timelineSteps = [
  {
    kicker: 'Week 1 · Review',
    title: 'Understand the business before design starts.',
    description:
      'We look at the offer, audience, current site, proof, search surface, and contact paths before design starts.',
  },
  {
    kicker: 'Week 2 · Scope',
    title: 'Make the decision path obvious.',
    description:
      'We define the pages, message order, proof placement, and primary contact route so the site has a clear plan. Decisions happen here, not mid-build.',
  },
  {
    kicker: 'Weeks 2-3 · Build',
    title: 'Design and development move together.',
    description:
      'Copy, layout, mobile behavior, performance, accessibility, and motion are built as one system, simple enough to ship clean.',
  },
  {
    kicker: 'Weeks 3-4 · Launch',
    title: 'Ship only after the fundamentals hold.',
    description:
      'We check mobile quality, forms, metadata, redirects, analytics readiness, speed, and support expectations before release.',
  },
] as const;

const needsFromYou = [
  { title: 'Pages to build', detail: 'Which pages matter most right now.' },
  { title: 'Photos and reviews', detail: 'Past work, customer reviews, and anything worth showing early.' },
  { title: 'Quote and contact paths', detail: 'Where each button and form should go.' },
  { title: 'Domain and redirects', detail: 'Technical handoff so nothing breaks at launch.' },
] as const;

const standards = [
  {
    title: 'Buyer-language first',
    detail: 'The site should sound like it understands the customer, not like it is explaining technical decisions.',
    icon: 'eye',
  },
  {
    title: 'Proof without invention',
    detail: 'Concepts are labeled as concepts. Client outcomes are only used when they are real, approved, and supportable.',
    icon: 'shield-check',
  },
  {
    title: 'Motion with purpose',
    detail: 'Transitions stay cinematic and restrained. Reduced-motion settings are respected without flattening the whole experience.',
    icon: 'bolt',
  },
  {
    title: 'One conversion path',
    detail: 'The site should guide serious project interest into one simple path, with direct email and phone still available.',
    icon: 'target',
  },
] as const;
---

<SiteLayout
  title={SEO_ROUTES.approach.title}
  description={SEO_ROUTES.approach.description}
  canonicalPath="/approach"
  schema={[APPROACH_JSON_LD, breadcrumbSchema([{ name: 'Home', url: SITE_URL }, { name: 'Approach', url: `${SITE_URL}/approach` }])]}
>
  <main id="main-content" tabindex="-1" class="pb-0">
    <section class="axiom-container pt-20 md:pt-28">
      <div class="max-w-3xl">
        <FadeIn motion="eyebrow">
          <Eyebrow>APPROACH</Eyebrow>
          <SectionDivider className="mt-6" />
        </FadeIn>
        <FadeIn motion="sceneOpen" delay={180}>
          <MotionHeading as="h1" text="A calmer way to get a sharper site." className="mt-4" />
        </FadeIn>
        <FadeIn motion="editorialMaskReveal" delay={500}>
          <p class="section-copy mt-5 md:text-[17px]">
            The work is strategy, structure, writing, design, development, launch checks, and support. Most standard builds move from first review to launch in two to four weeks - and the point is not more pages. It is a site buyers can understand and trust faster.
          </p>
        </FadeIn>
        <FadeIn motion="sceneOpen" delay={720}>
          <div class="mt-7 flex flex-col gap-4 sm:flex-row sm:items-center">
            <a href={CTA_PATHS.startProject} class="btn btn-primary btn-lg w-full justify-center sm:w-auto">Start a project</a>
            <a href="/services" class="btn-ghost-link">See services</a>
          </div>
        </FadeIn>
      </div>
    </section>

    <div aria-hidden="true" class="section-glow section-glow-offset-top" />

    <section class="page-section section-shell">
      <div class="axiom-container">
        <h2 class="sr-only">Approach timeline</h2>
        <ol class="approach-timeline">
          {timelineSteps.map((step, index) => (
            <li class="approach-step reveal" style={`--reveal-delay: ${index * 90}ms`}>
              <span class="approach-step-num">{`0${index + 1}`}</span>
              <span class="approach-step-kicker">{step.kicker}</span>
              <h3 class="approach-step-title">{step.title}</h3>
              <p class="approach-step-desc">{step.description}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <div aria-hidden="true" class="section-glow section-glow-offset-top" />

    <section class="page-section section-shell">
      <div class="axiom-container">
        <FadeIn motion="editorialMaskReveal" className="max-w-3xl">
          <Eyebrow>WHAT WE NEED FROM YOU</Eyebrow>
          <SectionDivider className="mt-6" />
          <MotionHeading as="h2" text="Four things from you. That's it." className="section-heading mt-4" />
        </FadeIn>

        <div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          {needsFromYou.map((item, index) => (
            <FadeIn motion="timelineSequence" delay={index * 150} distance={16} as="div">
              <div class="h-full rounded-[var(--radius-card)] border border-[color:var(--hairline)] bg-[var(--surface-1)] p-5 sm:p-6">
                <p class="flex items-center gap-2 text-[15px] font-semibold tracking-[-0.01em] text-[var(--text-primary)]">
                  <DrawIcon name="check" size={14} className="text-[var(--accent-solid)]" />
                  {item.title}
                </p>
                <p class="section-copy mt-3 text-[15px]">
                  {item.detail}
                </p>
              </div>
            </FadeIn>
          ))}
        </div>
      </div>
    </section>

    <div aria-hidden="true" class="section-glow section-glow-offset-top" />

    <section class="page-section section-shell">
      <div class="axiom-container">
        <FadeIn motion="editorialMaskReveal" className="max-w-3xl">
          <Eyebrow>OPERATING STANDARD</Eyebrow>
          <SectionDivider className="mt-6" />
          <MotionHeading as="h2" text="Premium is a set of decisions." className="section-heading mt-4" />
        </FadeIn>

        <div class="mt-10 grid gap-5 md:grid-cols-2">
          {standards.map((standard, index) => (
            <FadeIn motion="timelineSequence" delay={Math.min(index * 140, 560)} as="div">
              <Card className="h-full p-0">
                <div class="flex h-full flex-col p-6 sm:p-7">
                  <div class="mb-5 flex items-center justify-between gap-4">
                    <DrawIcon name={standard.icon} className="text-[var(--accent-solid)]" />
                    <p class="font-mono text-[0.75rem] font-medium uppercase tracking-[0.08em] text-[var(--accent-solid)]">
                      0{index + 1}
                    </p>
                  </div>
                  <h3 class="text-[clamp(1.25rem,1.5vw,1.5rem)] font-medium tracking-normal text-[var(--text-primary)]">
                    {standard.title}
                  </h3>
                  <p class="section-copy mt-3">
                    {standard.detail}
                  </p>
                </div>
              </Card>
            </FadeIn>
          ))}
        </div>
      </div>
    </section>

    <div aria-hidden="true" class="section-glow section-glow-offset-top" />

    <section class="page-section-tight section-shell">
      <div class="axiom-container grid gap-6 lg:grid-cols-2">
        <FadeIn as="div" motion="finalFrameFooter" direction="left">
          <Card className="h-full p-0">
            <div class="h-full px-6 py-8 sm:px-8 sm:py-10 md:px-10 md:py-12">
              <Eyebrow>AFTER LAUNCH</Eyebrow>
              <SectionDivider className="mt-6" />
              <MotionHeading as="h2" text="Monthly clients stay supported." className="section-heading mt-4" />
              <p class="section-copy mt-4">
                Monthly clients keep edits, refinements, bug fixes, and priority support. Ownership clients get a clean handoff and can add ongoing support separately.
              </p>
            </div>
          </Card>
        </FadeIn>

        <FadeIn as="div" motion="finalFrameFooter" direction="right">
          <Card className="h-full p-0">
            <div class="h-full px-6 py-8 sm:px-8 sm:py-10 md:px-10 md:py-12">
              <Eyebrow>BEFORE WE SHIP</Eyebrow>
              <SectionDivider className="mt-6" />
              <MotionHeading as="h2" text="If it weakens trust, it does not ship." className="section-heading mt-4" />
              <p class="section-copy mt-4">
                Every build is checked for clarity, mobile behavior, forms, metadata, and speed before it goes live. The transitions stay impressive, but the fundamentals carry the sale.
              </p>
              <div class="mt-7">
                <a href={CTA_PATHS.startProject} class="btn btn-primary">Start a project</a>
              </div>
            </div>
          </Card>
        </FadeIn>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
  .approach-timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 860px) {
    .approach-timeline {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .approach-step {
    position: relative;
    padding-top: 2rem;
    padding-right: clamp(1rem, 2vw, 2rem);
    border-top: 1px solid var(--hairline-strong);
  }

  .approach-step::before {
    content: '';
    position: absolute;
    top: -4px;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--text-primary);
  }

  @media (max-width: 859px) {
    .approach-step {
      padding-top: 1.6rem;
      padding-bottom: 1.6rem;
    }
    .approach-step + .approach-step {
      border-top: 1px solid var(--hairline);
    }
  }

  .approach-step-num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .approach-step-kicker {
    display: block;
    margin-top: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--text-secondary);
  }

  .approach-step-title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.9vw, 1.5rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--text-primary);
    margin: 0.5rem 0 0;
  }

  .approach-step-desc {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.65;
    margin: 0.7rem 0 0;
    max-width: 34ch;
  }
</style>
