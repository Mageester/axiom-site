---
import CtaBand from '../components/site/CtaBand.astro';
import FaqList from '../components/site/FaqList.astro';
import Icon from '../components/site/Icon.astro';
import PageHero from '../components/site/PageHero.astro';
import ProcessSteps from '../components/site/ProcessSteps.astro';
import { approachFaq, processSteps, standards } from '../content/process';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CTA_PATHS } from '../lib/cta';
import { SEO_ROUTES, faqJsonLd, type Crumb } from '../lib/seo';

const crumbs: Crumb[] = [
  { name: 'Home', url: '/' },
  { name: 'Process', url: '/approach/' },
];
---

<BaseLayout {...SEO_ROUTES.approach} crumbs={crumbs} schema={faqJsonLd(approachFaq)}>
  <main id="main-content" tabindex="-1">
    <PageHero
      eyebrow="Process"
      title="How a website project works"
      lead="Four clear steps from first conversation to launch. Standard packages usually go live in two to four weeks, with the scope and price agreed in writing before design starts."
      crumbs={crumbs}
    >
      <Fragment slot="actions">
        <a href={CTA_PATHS.startProject} class="btn btn-lg">Start a project <Icon name="arrow-right" /></a>
        <a href="/pricing/" class="btn btn-secondary btn-lg">See pricing</a>
      </Fragment>
      <ol slot="aside" role="list" class="card overview" aria-label="Process overview">
        {processSteps.map((step) => (
          <li>
            <span class="overview-num" aria-hidden="true">{step.number}</span>
            <span class="overview-title">{step.title}</span>
            <span class="overview-time">{step.timing}</span>
          </li>
        ))}
      </ol>
    </PageHero>

    <section class="section" aria-labelledby="steps-title">
      <div class="container-narrow">
        <div class="section-head">
          <p class="eyebrow">Step by step</p>
          <h2 id="steps-title">What happens, and when</h2>
          <p>Each step has a clear output and a clear decision, so you always know where the project stands and what comes next.</p>
        </div>
        <ProcessSteps steps={processSteps} detailed />
      </div>
    </section>

    <section class="section section-soft" aria-labelledby="standards-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Our standards</p>
          <h2 id="standards-title">The rules every site follows</h2>
          <p>Whatever the package, these principles shape every page we design and build.</p>
        </div>
        <ul role="list" class="grid grid-4 standards">
          {standards.map((item) => (
            <li class="card standard">
              <span class="icon-tile"><Icon name={item.icon} /></span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="faq-title">
      <div class="container faq-grid">
        <div class="section-head">
          <p class="eyebrow">FAQ</p>
          <h2 id="faq-title">Process questions</h2>
          <p>More about pricing and payments is on the <a class="text-link" href="/pricing/">pricing page</a>.</p>
        </div>
        <FaqList items={approachFaq} />
      </div>
    </section>

    <CtaBand />
  </main>
</BaseLayout>

<style>
  .overview {
    gap: 0;
    padding: 0.5rem 1.5rem;
    margin: 0;
    box-shadow: var(--shadow-md);
  }

  .overview li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .overview li:last-child {
    border-bottom: 0;
  }

  .overview-num {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: var(--brand-soft);
    color: var(--brand);
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  .overview-title {
    color: var(--ink);
    font-weight: 650;
  }

  .overview-time {
    color: var(--text-muted);
    font-size: var(--fs-sm);
    white-space: nowrap;
  }

  .standards {
    margin: 0;
  }

  .standard {
    gap: 0.65rem;
  }

  .standard .icon-tile {
    margin-bottom: 0.4rem;
  }

  .standard p {
    color: var(--text);
    font-size: var(--fs-sm);
  }

  .faq-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .faq-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
      gap: 5rem;
      align-items: start;
    }
  }

  .faq-grid .section-head {
    margin-bottom: 0;
  }
</style>
