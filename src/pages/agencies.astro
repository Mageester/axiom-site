---
import CtaBand from '../components/site/CtaBand.astro';
import FaqList from '../components/site/FaqList.astro';
import Icon from '../components/site/Icon.astro';
import PageHero from '../components/site/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailText from '../components/site/EmailText.astro';
import { SEO_ROUTES, SITE_EMAIL, faqJsonLd, type Crumb } from '../lib/seo';

const crumbs: Crumb[] = [
  { name: 'Home', url: '/' },
  { name: 'For agencies', url: '/agencies/' },
];

const terms = [
  { label: 'Rate', value: 'CAD 50 an hour' },
  { label: 'Quote', value: 'Fixed, within 24 hours' },
  { label: 'Credit', value: 'Your name, not ours' },
  { label: 'Aftercare', value: '30 days of free fixes' },
];

const work = [
  {
    title: 'Page builds',
    text: 'Landing pages, service pages and new sections built from your designs or your brand system, ready for your review.',
  },
  {
    title: 'Fixes and upkeep',
    text: 'Broken layouts, mobile issues, slow pages, form problems and plugin trouble on client sites you already manage.',
  },
  {
    title: 'Small sites',
    text: 'Complete small business sites delivered behind the scenes, from first build to launch, so your team can stay on strategy.',
  },
  {
    title: 'Accessibility passes',
    text: 'Contrast, labels, headings and keyboard checks against WCAG 2.0 AA, with a written list of what changed.',
  },
];

const steps = [
  { title: 'Send the brief', text: 'A link, a design file or a few lines on what the client needs.' },
  { title: 'Fixed quote in 24 hours', text: 'Scope and price in writing before any work starts. NDA signed by default.' },
  { title: 'We build, you review', text: 'Work happens on a staging copy. You approve it before your client sees it.' },
  { title: 'You deliver', text: 'Hand it over under your name. Anything we missed is fixed free for 30 days.' },
];

const faq = [
  {
    question: 'Will our clients know you are involved?',
    answer:
      'No. We work under your agency name, sign an NDA by default and never contact your clients unless you ask us to.',
  },
  {
    question: 'How is a job priced?',
    answer:
      'At CAD 50 an hour, quoted as a fixed price within 24 hours of your brief. The quote is the price unless the scope changes, and we agree any change in writing first.',
  },
  {
    question: 'What platforms do you work on?',
    answer:
      'Custom-coded sites and the common builders and content systems agencies hand over. Tell us the platform in the brief and we will say plainly if it is not a fit.',
  },
  {
    question: 'How do we start?',
    answer:
      'Send one small job first. It is the fastest way to see how we work before trusting us with anything larger.',
  },
];

const mailto = `mailto:${SITE_EMAIL}?subject=Agency%20overflow%20work`;
---

<BaseLayout {...SEO_ROUTES.agencies} crumbs={crumbs} schema={faqJsonLd(faq)}>
  <main id="main-content" tabindex="-1">
    <PageHero
      eyebrow="For agencies"
      title="Extra hands for the weeks with more site work than people"
      lead="Axiom Web takes on page builds, fixes and small sites behind the scenes, delivered under your agency's name. Fixed quotes within 24 hours, an NDA by default, and nothing reaches your client until you approve it."
      crumbs={crumbs}
    >
      <Fragment slot="actions">
        <a href={mailto} class="btn btn-lg">Send a first job <Icon name="arrow-right" /></a>
        <a href="/work/" class="btn btn-secondary btn-lg">See our work</a>
      </Fragment>
      <dl slot="aside" class="card terms">
        {terms.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    </PageHero>

    <section class="section" aria-labelledby="work-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">What we take on</p>
          <h2 id="work-title">The work that stalls a busy studio</h2>
          <p>Well-defined jobs your team would rather not context-switch into, finished to your standard.</p>
        </div>
        <ul role="list" class="grid grid-4 offers">
          {work.map((item, index) => (
            <li class="card offer">
              <span class="index-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section section-soft" aria-labelledby="how-title">
      <div class="container-narrow">
        <div class="section-head">
          <p class="eyebrow">How it works</p>
          <h2 id="how-title">From brief to handover</h2>
          <p>Four steps, each with a clear decision, so a job never drifts.</p>
        </div>
        <ol role="list" class="steps">
          {steps.map((step, index) => (
            <li>
              <span class="step-num" aria-hidden="true">{index + 1}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section" aria-labelledby="faq-title">
      <div class="container faq-grid">
        <div class="section-head">
          <p class="eyebrow">FAQ</p>
          <h2 id="faq-title">Agency questions</h2>
          <p>Prefer to talk it through? Email <a class="text-link" href={mailto}><EmailText /></a>.</p>
        </div>
        <FaqList items={faq} />
      </div>
    </section>

    <CtaBand />
  </main>
</BaseLayout>

<style>
  .terms {
    display: grid;
    gap: 0;
    padding: 0.5rem 1.5rem;
    margin: 0;
    box-shadow: var(--shadow-md);
  }

  .terms div {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .terms div:last-child {
    border-bottom: 0;
  }

  .terms dt {
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .terms dd {
    margin: 0;
    color: var(--ink);
    font-weight: 650;
    text-align: right;
  }

  .offers {
    margin: 0;
  }

  .offer {
    gap: 0.65rem;
  }

  .offer .index-num {
    margin-bottom: 0.4rem;
  }

  .offer p {
    color: var(--text);
    font-size: var(--fs-sm);
  }

  .steps {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
  }

  .steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .steps li:last-child {
    border-bottom: 0;
  }

  .step-num {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--line-strong);
    color: var(--ink);
    font-weight: 700;
  }

  .steps h3 {
    margin: 0 0 0.35rem;
  }

  .steps p {
    margin: 0;
    color: var(--text);
  }

  .faq-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .faq-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
      gap: 5rem;
      align-items: start;
    }
  }

  .faq-grid .section-head {
    margin-bottom: 0;
  }
</style>
