---
import CtaBand from '../components/site/CtaBand.astro';
import EmailText from '../components/site/EmailText.astro';
import Film from '../components/site/Film.astro';
import FounderCards from '../components/site/FounderCards.astro';
import Icon from '../components/site/Icon.astro';
import PageHero from '../components/site/PageHero.astro';
import { founders } from '../content/company';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CTA_PATHS } from '../lib/cta';
import {
  FILM_JSON_LD,
  SEO_ROUTES,
  SITE_EMAIL,
  SITE_PHONE_DISPLAY,
  SITE_TELEPHONE,
  personSchema,
  type Crumb,
} from '../lib/seo';

const crumbs: Crumb[] = [
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about/' },
];

const beliefs = [
  {
    icon: 'eye',
    title: 'The offer has to be obvious',
    text: 'A visitor should understand what you do, who you serve and how to take the next step without decoding the site.',
  },
  {
    icon: 'shield',
    title: 'Proof sits next to the decision',
    text: 'Reviews, credentials, work examples and real photos belong near the price, the service and the contact button.',
  },
  {
    icon: 'users',
    title: 'Direct accountability matters',
    text: 'You talk to the people shaping the message and building the site, with one clear support path after launch.',
  },
] as const;
---

<BaseLayout
  {...SEO_ROUTES.about}
  pageType="AboutPage"
  crumbs={crumbs}
  schema={[...founders.map((founder) => personSchema(founder)), FILM_JSON_LD]}
>
  <main id="main-content" tabindex="-1">
    <PageHero eyebrow="About" title="A founder-led web design studio in Kitchener-Waterloo" crumbs={crumbs}>
      <p class="lead">
        We are Aidan Magee and Riley Hinsperger, co-founders of Axiom International and Axiom Web, its web-focused subsidiary. Based in Kitchener-Waterloo and serving Canada, we lead every engagement directly—from strategy and design through development, launch, and support.
      </p>
      <Fragment slot="actions">
        <a href={CTA_PATHS.startProject} class="btn btn-lg">Start a project <Icon name="arrow-right" /></a>
        <a href="/approach/" class="btn btn-secondary btn-lg">How we work</a>
      </Fragment>
      <aside slot="aside" class="card facts-card" aria-label="Axiom Web at a glance">
        <dl>
          <div>
            <dt>Founded by</dt>
            <dd>Aidan Magee &amp; Riley Hinsperger</dd>
          </div>
          <div>
            <dt>Based in</dt>
            <dd>Kitchener-Waterloo, Ontario</dd>
          </div>
          <div>
            <dt>Serving</dt>
            <dd>Waterloo Region, Guelph, Hamilton and clients across Canada</dd>
          </div>
          <div>
            <dt>Parent company</dt>
            <dd>Axiom International</dd>
          </div>
          <div>
            <dt>Contact</dt>
            <dd>
              <a href={`tel:${SITE_TELEPHONE}`} class="text-link">{SITE_PHONE_DISPLAY}</a><br />
              <a href={`mailto:${SITE_EMAIL}`} class="text-link"><EmailText /></a>
            </dd>
          </div>
        </dl>
      </aside>
    </PageHero>

    <section class="section" aria-labelledby="founders-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">The founders</p>
          <h2 id="founders-title">The two people behind every project</h2>
          <p>There are no account managers or hand-offs. The people you speak to on the first call are the people who plan, design, build and support your website.</p>
        </div>
        <FounderCards withAnchors />
      </div>
    </section>

    <section class="section section-soft" aria-labelledby="beliefs-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">What we believe</p>
          <h2 id="beliefs-title">Launch is not the finish line</h2>
          <p>A polished launch matters, but a website also has to stay clear, fast and supported after it goes live. We focus on what helps customers trust a business and take the next step.</p>
        </div>
        <ul role="list" class="grid grid-3 beliefs">
          {beliefs.map((belief, index) => (
            <li class="card belief">
              <span class="index-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h3>{belief.title}</h3>
              <p>{belief.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="film-title">
      <div class="container">
        <div class="section-head center">
          <p class="eyebrow">Studio film</p>
          <h2 id="film-title">Built to the pixel</h2>
          <p>A short look at the care that goes into every site we make.</p>
        </div>
        <div class="film-wrap">
          <Film />
        </div>
      </div>
    </section>

    <CtaBand title="Let’s build something clear together" />
  </main>
</BaseLayout>

<style>
  .facts-card {
    box-shadow: var(--shadow-md);
  }

  .facts-card dl {
    display: grid;
    margin: 0;
  }

  .facts-card dl > div {
    display: grid;
    gap: 0.15rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .facts-card dl > div:first-child {
    padding-top: 0;
  }

  .facts-card dl > div:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .facts-card dt {
    color: var(--text-muted);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .facts-card dd {
    margin: 0;
    color: var(--ink);
    font-weight: 500;
    line-height: 1.5;
  }

  .beliefs {
    margin: 0;
  }

  .belief {
    gap: 0.65rem;
  }

  .belief .index-num {
    margin-bottom: 0.4rem;
  }

  .belief p {
    color: var(--text);
    font-size: var(--fs-sm);
  }

  .film-wrap {
    max-width: 68rem;
    margin-inline: auto;
  }
</style>
