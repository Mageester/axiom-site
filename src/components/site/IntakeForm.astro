---
import { SITE_EMAIL, SITE_PHONE_DISPLAY, SITE_TELEPHONE } from '../../lib/seo';
import EmailText from './EmailText.astro';
import Icon from './Icon.astro';

type Kind = 'contact' | 'project';

type Props = {
  kind: Kind;
  title: string;
  description?: string;
};

const { kind, title, description } = Astro.props as Props;
const endpoint = kind === 'project' ? '/api/intake' : '/api/contact';
const submitLabel = kind === 'project' ? 'Send project details' : 'Send message';
const id = (name: string) => `${kind}-${name}`;

// Values match the intake API's pricing_path vocabulary.
const pricingPathOptions = [
  { value: 'local_launch', label: 'Local Launch Special', intent: 'local-launch' },
  { value: 'local_business', label: 'Local Business Website', intent: 'local-business' },
  { value: 'expanded', label: 'Expanded Website', intent: 'expanded' },
  { value: 'custom', label: 'Custom', intent: 'custom' },
  { value: 'not_sure', label: 'Not sure yet', intent: '' },
] as const;
---

<div class="card intake" data-intake-root>
  <div class="intake-head">
    <h2>{title}</h2>
    {description && <p>{description}</p>}
  </div>

  <div class="intake-success" data-intake-success role="status" aria-live="polite" hidden tabindex="-1">
    <span class="success-icon" aria-hidden="true"><Icon name="check" size={26} strokeWidth={2.4} /></span>
    <h3>{kind === 'project' ? 'Project details received.' : 'Message received.'}</h3>
    <p>
      Thank you. We will review what you sent and reply within one business day
      {kind === 'project' ? ' with the package we recommend, the price and the next step.' : '.'}
    </p>
    <div class="btn-row">
      <a href="/work/" class="btn btn-secondary">See our work</a>
      <button type="button" class="btn btn-secondary" data-intake-reset>
        {kind === 'project' ? 'Send another project' : 'Send another message'}
      </button>
    </div>
  </div>

  <form
    class="intake-form"
    data-axiom-intake-form
    data-intake-kind={kind}
    data-intake-endpoint={endpoint}
    data-submit-label={submitLabel}
    aria-busy="false"
    novalidate
  >
    <div class="intake-alert" data-intake-alert role="alert" hidden></div>

    <div class="intake-grid">
      <div class="field">
        <label class="field-label" for={id('name')}>Name</label>
        <input
          class="input"
          id={id('name')}
          name="name"
          type="text"
          required
          minlength="2"
          maxlength="100"
          autocomplete="name"
          data-intake-field
          data-error-required="Please enter your name."
          data-error-short="Please use at least 2 characters."
          aria-describedby={id('name-error')}
        />
        <p class="field-error" id={id('name-error')} data-intake-error hidden></p>
      </div>

      <div class="field">
        <label class="field-label" for={id('email')}>Email</label>
        <input
          class="input"
          id={id('email')}
          name="email"
          type="email"
          required
          maxlength="160"
          pattern="[^@]+@[^@]+[.][A-Za-z]{2,}"
          autocomplete="email"
          inputmode="email"
          spellcheck="false"
          data-intake-field
          data-error-required="Please enter your email address."
          data-error-type="Please enter a valid email address."
          aria-describedby={id('email-error')}
        />
        <p class="field-error" id={id('email-error')} data-intake-error hidden></p>
      </div>

      {kind === 'project' && (
        <div class="field">
          <label class="field-label" for={id('phone')}>Phone <span class="optional">(optional)</span></label>
          <input class="input" id={id('phone')} name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="30" data-intake-field />
        </div>
      )}

      <div class:list={['field', { 'span-2': kind === 'contact' }]}>
        <label class="field-label" for={id('business')}>Business name <span class="optional">(optional)</span></label>
        <input class="input" id={id('business')} name="business_name" type="text" autocomplete="organization" maxlength="120" data-intake-field />
      </div>

      {kind === 'project' && (
        <div class="field span-2">
          <label class="field-label" for={id('website')}>Current website <span class="optional">(optional)</span></label>
          <input
            class="input"
            id={id('website')}
            name="current_website"
            type="text"
            inputmode="url"
            placeholder="yourbusiness.ca"
            autocomplete="url"
            autocapitalize="none"
            spellcheck="false"
            maxlength="500"
            data-intake-field
          />
        </div>
      )}
    </div>

    {kind === 'project' && (
      <fieldset class="field package-field">
        <legend class="field-label">Which package are you considering?</legend>
        <div class="package-options">
          {pricingPathOptions.map((option) => (
            <label class="package-option">
              <input
                type="radio"
                name="pricing_path"
                value={option.value}
                data-intent={option.intent}
                checked={option.value === 'not_sure'}
              />
              <span>{option.label}</span>
            </label>
          ))}
        </div>
        <p class="field-help">Not sure is fine. We will recommend the right fit. <a class="text-link" href="/pricing/">Compare packages</a></p>
      </fieldset>
    )}

    <div class="field">
      <label class="field-label" for={id('details')}>{kind === 'project' ? 'About the project' : 'Message'}</label>
      <textarea
        class="input"
        id={id('details')}
        name={kind === 'project' ? 'details' : 'message'}
        rows="5"
        required
        minlength="10"
        maxlength="4000"
        placeholder={kind === 'project'
          ? 'What does the business do, what should the website help with, and when would you like to launch?'
          : 'How can we help?'}
        data-intake-field
        data-error-required={kind === 'project' ? 'Please tell us a little about the project.' : 'Please add a message.'}
        data-error-short="Please add a little more detail (at least 10 characters)."
        aria-describedby={id('details-error')}
      ></textarea>
      <p class="field-error" id={id('details-error')} data-intake-error hidden></p>
    </div>

    <div class="honeypot" aria-hidden="true">
      <label for={id('company-fax')}>Leave this field blank</label>
      <input id={id('company-fax')} type="text" name="company_fax" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="source_path" value={Astro.url.pathname} data-source-path />

    <div class="intake-submit">
      <button type="submit" class="btn btn-lg btn-block" data-intake-submit>
        <span data-submit-text>{submitLabel}</span>
        <Icon name="arrow-right" />
      </button>
      <p class="intake-note">
        Prefer to talk? Call <a class="text-link" href={`tel:${SITE_TELEPHONE}`}>{SITE_PHONE_DISPLAY}</a> or email
        <a class="text-link" href={`mailto:${SITE_EMAIL}`}><EmailText /></a>.
      </p>
    </div>
  </form>
</div>

<style>
  .intake {
    gap: 1.75rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    box-shadow: var(--shadow-md);
  }

  .intake-head {
    display: grid;
    gap: 0.5rem;
  }

  .intake-head h2 {
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.75rem);
  }

  .intake-head p {
    color: var(--text);
  }

  .intake-form {
    display: grid;
    gap: 1.35rem;
  }

  .intake-grid {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .intake-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .span-2 {
      grid-column: 1 / -1;
    }
  }

  .package-field {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .package-field legend {
    margin-bottom: 0.6rem;
    padding: 0;
  }

  .package-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .package-option {
    position: relative;
  }

  .package-option input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .package-option span {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.55rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink-2);
    font-size: var(--fs-sm);
    font-weight: 500;
    transition: border-color 160ms var(--ease), background-color 160ms var(--ease), color 160ms var(--ease);
  }

  .package-option:hover span {
    border-color: rgb(255 255 255 / 0.32);
  }

  .package-option input:checked + span {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--bg);
    font-weight: 600;
  }

  .package-option input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .package-field .field-help {
    margin-top: 0.6rem;
  }

  .intake-alert {
    padding: 0.85rem 1rem;
    border: 1px solid rgb(255 143 134 / 0.35);
    border-radius: var(--radius);
    background: var(--danger-soft);
    color: var(--danger);
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  .honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .intake-submit {
    display: grid;
    gap: 0.9rem;
  }

  .intake-note {
    color: var(--text-muted);
    font-size: var(--fs-sm);
    text-align: center;
  }

  .intake-success {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    padding: 1.75rem;
    border: 1px solid rgb(95 216 160 / 0.3);
    border-radius: var(--radius-lg);
    background: var(--success-soft);
  }

  .intake-success[hidden] {
    display: none;
  }

  .intake-success:focus {
    outline: none;
  }

  .success-icon {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius);
    background: var(--success);
    color: var(--bg);
  }

  .intake-success .btn-row {
    margin-top: 0.5rem;
  }

  [data-intake-root][data-sent] .intake-form {
    display: none;
  }
</style>

<script>
  const MESSAGES = {
    fallback: 'Something went wrong and your message was not sent. Please try again, or email aidanmageebusiness@gmail.com.',
    review: 'Please check the highlighted fields.',
  };

  // The server trims values before validating, so check trimmed lengths here too.
  const fieldError = (field: HTMLInputElement | HTMLTextAreaElement) => {
    const v = field.validity;
    const trimmed = field.value.trim();
    if (v.valueMissing || (field.required && !trimmed)) return field.dataset.errorRequired || 'Please complete this field.';
    if (v.typeMismatch || v.patternMismatch) return field.dataset.errorType || 'Please enter a valid value.';
    if (v.tooShort || (field.minLength > 0 && trimmed && trimmed.length < field.minLength)) {
      return field.dataset.errorShort || 'Please add a little more detail.';
    }
    return '';
  };

  // Only messages written for visitors are shown; anything technical falls back to a plain one.
  const visitorMessage = (status: number, result: { error?: unknown } | null) =>
    [429, 502, 503].includes(status) && typeof result?.error === 'string' ? result.error : MESSAGES.fallback;

  const showFieldState = (field: HTMLInputElement | HTMLTextAreaElement) => {
    const message = fieldError(field);
    const errorId = field.getAttribute('aria-describedby');
    const errorEl = errorId ? document.getElementById(errorId) : null;
    if (message) field.setAttribute('aria-invalid', 'true');
    else field.removeAttribute('aria-invalid');
    if (errorEl) {
      errorEl.textContent = message;
      errorEl.hidden = !message;
    }
    return !message;
  };

  // Preselect the package when a pricing link passed ?path=<intent>.
  const intent = new URLSearchParams(window.location.search).get('path');

  document.querySelectorAll<HTMLElement>('[data-intake-root]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-axiom-intake-form]');
    const alertBox = root.querySelector<HTMLElement>('[data-intake-alert]');
    const success = root.querySelector<HTMLElement>('[data-intake-success]');
    const submit = root.querySelector<HTMLButtonElement>('[data-intake-submit]');
    const submitText = root.querySelector<HTMLElement>('[data-submit-text]');
    if (!form || !alertBox || !success || !submit || !submitText) return;

    const kind = form.dataset.intakeKind;
    const endpoint = form.dataset.intakeEndpoint || '/api/contact';
    const label = form.dataset.submitLabel || 'Send';
    const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-intake-field]'));
    let attempted = false;

    if (intent) {
      const match = form.querySelector<HTMLInputElement>(`input[name="pricing_path"][data-intent="${CSS.escape(intent)}"]`);
      if (match) match.checked = true;
      const source = form.querySelector<HTMLInputElement>('[data-source-path]');
      if (source) source.value = `${window.location.pathname}?path=${intent}`.slice(0, 200);
    }

    const setAlert = (message: string) => {
      alertBox.textContent = message;
      alertBox.hidden = !message;
    };

    const setBusy = (busy: boolean) => {
      form.setAttribute('aria-busy', String(busy));
      submit.disabled = busy;
      submitText.textContent = busy ? 'Sending…' : label;
    };

    fields.forEach((field) => {
      field.addEventListener('blur', () => {
        if (field.value || attempted) showFieldState(field);
      });
      field.addEventListener('input', () => {
        if (field.getAttribute('aria-invalid') === 'true' || attempted) showFieldState(field);
      });
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      attempted = true;
      setAlert('');

      const invalid = fields.filter((field) => !showFieldState(field));
      if (invalid.length) {
        setAlert(MESSAGES.review);
        invalid[0].focus();
        return;
      }

      const data = Object.fromEntries(
        Array.from(new FormData(form).entries()).map(([key, value]) => [key, String(value).trim()])
      );
      const body =
        kind === 'project'
          ? { ...data, primary_goal: 'new_site' }
          : {
              name: data.name,
              email: data.email,
              business_name: data.business_name,
              message: data.message,
              source_path: data.source_path,
              company_fax: data.company_fax,
            };

      setBusy(true);
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const result = await response.json().catch(() => null);
        if (!response.ok || !result?.ok) throw new Error(visitorMessage(response.status, result));

        form.reset();
        attempted = false;
        root.setAttribute('data-sent', '');
        success.hidden = false;
        success.focus();
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (error) {
        setAlert(error instanceof Error && error.message ? error.message : MESSAGES.fallback);
      } finally {
        setBusy(false);
      }
    });

    root.querySelector('[data-intake-reset]')?.addEventListener('click', () => {
      root.removeAttribute('data-sent');
      success.hidden = true;
      fields.forEach((field) => {
        field.removeAttribute('aria-invalid');
        const errorId = field.getAttribute('aria-describedby');
        const errorEl = errorId ? document.getElementById(errorId) : null;
        if (errorEl) errorEl.hidden = true;
      });
      fields[0]?.focus();
    });
  });
</script>
