---
type Item = { name: string; url: string };
const { items } = Astro.props as { items: Item[] };
---
<nav aria-label="Breadcrumb" class="axiom-container pt-6 text-[13px] text-[var(--text-secondary)]">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {items.map((item, index) => <li class="inline-flex items-center gap-2">
      {index > 0 && <span aria-hidden="true">/</span>}
      {index === items.length - 1
        ? <span aria-current="page">{item.name}</span>
        : <a class="inline-flex min-h-8 items-center hover:text-[var(--text-primary)]" href={item.url}>{item.name}</a>}
    </li>)}
  </ol>
</nav>
