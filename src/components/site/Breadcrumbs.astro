---
import type { Crumb } from '../../lib/seo';

const { items } = Astro.props as { items: Crumb[] };
---

<nav aria-label="Breadcrumb" class="breadcrumbs mono">
  <ol role="list">
    {items.map((item, index) => (
      <li>
        {index > 0 && <span class="sep" aria-hidden="true">/</span>}
        {index === items.length - 1 ? (
          <span aria-current="page">{item.name}</span>
        ) : (
          <a href={item.url}>{item.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.6rem;
    margin: 0;
    color: var(--text-muted);
  }

  .breadcrumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .breadcrumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    color: var(--text-muted);
    transition: color 300ms var(--ease);
  }

  .breadcrumbs a:hover {
    color: var(--ink);
  }

  .breadcrumbs [aria-current='page'] {
    color: var(--ink);
  }

  .sep {
    color: var(--line-strong);
  }
</style>
