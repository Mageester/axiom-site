---
import type { ProcessStep } from '../../content/process';
import Icon from './Icon.astro';

type Props = {
  steps: ProcessStep[];
  detailed?: boolean;
};

const { steps, detailed = false } = Astro.props;
---

{detailed ? (
  <ol role="list" class="timeline">
    {steps.map((step) => (
      <li class="timeline-step" id={`step-${step.title.toLowerCase().replace(/[^a-z]+/g, '-')}`}>
        <div class="timeline-marker" aria-hidden="true">
          <span class="icon-tile"><Icon name={step.icon} /></span>
        </div>
        <div class="card timeline-card">
          <p class="step-timing">Step {step.number} · {step.timing}</p>
          <h3>{step.title}</h3>
          <p class="step-summary">{step.summary}</p>
          <div class="timeline-cols">
            <div>
              <h4>What happens</h4>
              <ul role="list" class="check-list">
                {step.details.map((detail) => <li>{detail}</li>)}
              </ul>
            </div>
            <div class="from-you">
              <h4>What we need from you</h4>
              <p>{step.you}</p>
            </div>
          </div>
        </div>
      </li>
    ))}
  </ol>
) : (
  <ol role="list" class="steps">
    {steps.map((step) => (
      <li class="step">
        <div class="step-top">
          <span class="step-number" aria-hidden="true">{step.number}</span>
          <span class="step-line" aria-hidden="true"></span>
        </div>
        <p class="step-timing">{step.timing}</p>
        <h3>{step.title}</h3>
        <p class="step-summary">{step.summary}</p>
      </li>
    ))}
  </ol>
)}

<style>
  /* Compact four-step row */
  .steps {
    display: grid;
    gap: 2rem;
    margin: 0;
    counter-reset: step;
  }

  @media (min-width: 720px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  .step {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .step-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .step-number {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    border: 1px solid var(--brand-line);
    border-radius: 999px;
    background:
      radial-gradient(circle at 35% 25%, rgb(150 180 255 / 0.35), transparent 70%),
      #0d1427;
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    box-shadow: 0 0 0 6px rgb(64 108 255 / 0.08), 0 0 28px -6px var(--glow);
  }

  .step-line {
    flex: 1;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--brand-line), transparent);
  }

  .step:last-child .step-line {
    display: none;
  }

  @media (max-width: 1079px) {
    .step-line {
      display: none;
    }
  }

  .step-timing {
    color: var(--accent);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .step-summary {
    color: var(--text);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  /* Detailed vertical timeline */
  .timeline {
    position: relative;
    display: grid;
    gap: 1.5rem;
    margin: 0;
  }

  .timeline-step {
    position: relative;
    display: grid;
    gap: 1rem;
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  @media (min-width: 760px) {
    .timeline::before {
      content: '';
      position: absolute;
      top: 1.5rem;
      bottom: 1.5rem;
      left: 1.375rem;
      width: 2px;
      background: linear-gradient(var(--brand-line), var(--line));
    }

    .timeline-step {
      grid-template-columns: 2.75rem minmax(0, 1fr);
      gap: 1.75rem;
    }

    .timeline-marker {
      position: relative;
      padding-top: 1.75rem;
    }

    .timeline-marker .icon-tile {
      box-shadow: 0 0 0 6px var(--bg);
    }
  }

  .timeline-card {
    gap: 0.6rem;
  }

  .timeline-card .step-summary {
    font-size: var(--fs-body);
    max-width: 60ch;
  }

  .timeline-cols {
    display: grid;
    gap: 1.5rem;
    margin-top: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .timeline-cols {
      grid-template-columns: 1.4fr 1fr;
      gap: 2.5rem;
    }
  }

  .timeline-cols h4 {
    margin-bottom: 0.75rem;
    color: var(--ink);
    font-size: var(--fs-sm);
  }

  .timeline-cols .check-list {
    font-size: var(--fs-sm);
  }

  .from-you {
    padding: 1.1rem 1.2rem;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.025);
    border: 1px solid var(--line);
    font-size: var(--fs-sm);
  }
</style>
