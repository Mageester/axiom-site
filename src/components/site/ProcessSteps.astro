---
import type { ProcessStep } from '../../content/process';

type Props = {
  steps: ProcessStep[];
  detailed?: boolean;
};

const { steps, detailed = false } = Astro.props;
---

{detailed ? (
  <ol role="list" class="timeline">
    {steps.map((step) => (
      <li class="timeline-step" id={`step-${step.title.toLowerCase().replace(/[^a-z]+/g, '-')}`}>
        <div class="timeline-marker" aria-hidden="true">
          <span class="timeline-num">{step.number}</span>
        </div>
        <div class="card timeline-card">
          <p class="step-timing">Step {step.number} · {step.timing}</p>
          <h3>{step.title}</h3>
          <p class="step-summary">{step.summary}</p>
          <div class="timeline-cols">
            <div>
              <h4>What happens</h4>
              <ul role="list" class="check-list">
                {step.details.map((detail) => <li>{detail}</li>)}
              </ul>
            </div>
            <div class="from-you">
              <h4>What we need from you</h4>
              <p>{step.you}</p>
            </div>
          </div>
        </div>
      </li>
    ))}
  </ol>
) : (
  <ol role="list" class="steps">
    {steps.map((step) => (
      <li class="step">
        <div class="step-top">
          <span class="step-number" aria-hidden="true">{step.number}</span>
          <span class="step-line" aria-hidden="true"></span>
        </div>
        <p class="step-timing">{step.timing}</p>
        <h3>{step.title}</h3>
        <p class="step-summary">{step.summary}</p>
      </li>
    ))}
  </ol>
)}

<style>
  /* Compact four-step row */
  .steps {
    display: grid;
    gap: 2rem;
    margin: 0;
    border-top: 1px solid var(--line-strong);
  }

  @media (min-width: 720px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
    }
    .step + .step {
      padding-left: 1.5rem;
      border-left: 1px solid var(--line);
    }
    .step {
      padding-right: 1.5rem;
    }
  }

  .step {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding-top: 1.5rem;
  }

  .step-top {
    margin-bottom: 0.5rem;
  }

  .step-number {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.8rem + 1.6vw, 3rem);
    font-weight: 500;
    font-stretch: var(--wdth-display);
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }

  .step-line {
    display: none;
  }

  .step-timing {
    color: var(--text-muted);
    font-size: var(--fs-label);
    font-weight: 600;
    font-stretch: var(--wdth-heading);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .step h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 540;
    font-stretch: var(--wdth-heading);
    letter-spacing: -0.02em;
  }

  .step-summary {
    color: var(--text);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  /* Detailed vertical timeline */
  .timeline {
    position: relative;
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  .timeline-step {
    position: relative;
    display: grid;
    gap: 1rem;
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .timeline-num {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 560;
    font-stretch: var(--wdth-heading);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 760px) {
    .timeline::before {
      content: '';
      position: absolute;
      top: 1.5rem;
      bottom: 1.5rem;
      left: 1.375rem;
      width: 1px;
      background: var(--line-strong);
    }

    .timeline-step {
      grid-template-columns: 2.75rem minmax(0, 1fr);
      gap: 1.75rem;
    }

    .timeline-marker {
      position: relative;
      padding-top: 1.75rem;
    }
  }

  .timeline-card {
    gap: 0.6rem;
  }

  .timeline-card h3 {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 540;
    font-stretch: var(--wdth-heading);
    letter-spacing: -0.02em;
  }

  .timeline-card .step-summary {
    font-size: var(--fs-body);
    max-width: 60ch;
  }

  .timeline-cols {
    display: grid;
    gap: 1.5rem;
    margin-top: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .timeline-cols {
      grid-template-columns: 1.4fr 1fr;
      gap: 2.5rem;
    }
  }

  .timeline-cols h4 {
    margin-bottom: 0.75rem;
    color: var(--ink);
    font-size: var(--fs-sm);
  }

  .timeline-cols .check-list {
    font-size: var(--fs-sm);
  }

  .from-you {
    padding: 1.1rem 1.2rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    font-size: var(--fs-sm);
  }
</style>
