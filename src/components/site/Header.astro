---
import { NAV_LINKS } from '../../content/company';
import { CTA_PATHS } from '../../lib/cta';
import { SITE_EMAIL, SITE_PHONE_DISPLAY, SITE_TELEPHONE } from '../../lib/seo';
import EmailText from './EmailText.astro';
import Icon from './Icon.astro';

type Props = { showCta?: boolean; theme?: 'dark' | 'light' };
const { showCta = true, theme = 'light' } = Astro.props;

const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const target = href.replace(/\/+$/, '') || '/';
  return current === target || current.startsWith(`${target}/`);
};
---

<header class="site-header" data-header data-theme={theme}>
  <div class="container header-bar">
    <a href="/" class="brand" aria-label="Axiom Web home">axiom<span>web</span></a>

    <nav class="header-nav" aria-label="Primary">
      <ul role="list">
        {NAV_LINKS.map((link) => (
          <li>
            <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      {showCta && (
        <a href={CTA_PATHS.startProject} class="pill header-cta" data-magnetic="0.2">
          Start a project
        </a>
      )}
      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="sr-only" data-menu-label>Open menu</span>
        <Icon name="menu" size={22} class="icon-open" />
        <Icon name="close" size={22} class="icon-close" />
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu" data-menu hidden>
  <nav class="container" aria-label="Mobile">
    <ul role="list" class="mobile-links">
      <li><a href="/" aria-current={current === '/' ? 'page' : undefined}><span class="mono">01</span>Home</a></li>
      {NAV_LINKS.map((link, index) => (
        <li>
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
            <span class="mono">{String(index + 2).padStart(2, '0')}</span>{link.label}
          </a>
        </li>
      ))}
      <li><a href="/agencies/" aria-current={isActive('/agencies/') ? 'page' : undefined}><span class="mono">08</span>For agencies</a></li>
    </ul>
    <div class="mobile-actions">
      <a href={CTA_PATHS.startProject} class="btn btn-light btn-lg btn-block">Start a project <Icon name="arrow-right" /></a>
      <div class="mobile-contact">
        <a href={`tel:${SITE_TELEPHONE}`}>{SITE_PHONE_DISPLAY}</a>
        <a href={`mailto:${SITE_EMAIL}`}><EmailText /></a>
      </div>
    </div>
  </nav>
</div>

<style>
  /* Fixed and transparent: the header reads ink on paper and snow on the dark
     stages, swapping as a stage passes beneath it. A faint blur backs it once
     the page has scrolled. */
  .site-header {
    --hd-ink: var(--ink);
    --hd-mute: var(--mute);
    --hd-line: var(--line);
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 60;
    color: var(--hd-ink);
    transition: background-color 400ms var(--ease), color 400ms var(--ease);
  }

  .site-header[data-theme='dark'] {
    --hd-ink: var(--snow);
    --hd-mute: var(--mute-night);
    --hd-line: var(--line-night);
  }

  .site-header[data-scrolled] {
    background: rgb(255 255 255 / 0.72);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  .site-header[data-scrolled][data-theme='dark'] {
    background: rgb(7 7 10 / 0.6);
  }

  .header-bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    min-height: 2.75rem;
    margin-right: auto;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .brand span {
    font-weight: 400;
    color: var(--hd-mute);
  }

  .header-nav {
    display: none;
  }

  .header-nav ul {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    margin: 0;
  }

  .header-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--hd-mute);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.005em;
    transition: color 400ms var(--ease);
  }

  .header-nav a:hover,
  .header-nav a[aria-current='page'] {
    color: var(--hd-ink);
  }

  .header-nav a::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0.5rem;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 400ms var(--ease-out);
  }

  .header-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .pill {
    display: none;
    align-items: center;
    gap: 10px;
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--hd-line);
    border-radius: var(--radius-pill);
    color: var(--hd-ink);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    transition:
      background-color 500ms var(--ease),
      color 500ms var(--ease),
      border-color 500ms var(--ease);
  }

  .pill:hover {
    background: var(--hd-ink);
    color: var(--paper);
    border-color: var(--hd-ink);
  }

  .site-header[data-theme='dark'] .pill:hover {
    color: var(--night);
  }

  .menu-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--hd-line);
    border-radius: 50%;
    background: transparent;
    color: var(--hd-ink);
  }

  .menu-toggle :global(svg) {
    grid-area: 1 / 1;
  }

  .menu-toggle :global(.icon-close) {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] :global(.icon-open) {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }

  /* While the menu is open the header sits on the night panel. */
  .site-header[data-open] {
    --hd-ink: var(--snow);
    --hd-mute: var(--mute-night);
    --hd-line: var(--line-night);
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  @media (min-width: 560px) {
    .pill {
      display: inline-flex;
    }
  }

  @media (min-width: 1080px) {
    .header-nav {
      display: block;
    }
    .menu-toggle,
    .mobile-menu {
      display: none !important;
    }
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 55;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--night);
    color: var(--snow);
    padding-block: calc(var(--header-h) + 1rem) 2.5rem;
  }

  .mobile-links {
    margin: 0;
    border-top: 1px solid var(--line-night);
  }

  .mobile-links a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    min-height: 4rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--line-night);
    color: var(--snow);
    font-size: clamp(1.9rem, 1.5rem + 2vw, 2.6rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .mobile-links .mono {
    color: var(--mute-night);
  }

  .mobile-links a[aria-current='page'] {
    color: var(--accent);
  }

  .mobile-actions {
    display: grid;
    gap: 1.25rem;
    margin-top: 2rem;
  }

  .mobile-contact {
    display: grid;
    gap: 0.5rem;
    justify-items: center;
    color: var(--mute-night);
    font-size: 0.9375rem;
  }

  .mobile-contact a {
    padding: 0.5rem;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  if (header && toggle && menu) {
    const setOpen = (open: boolean, restoreFocus = true) => {
      toggle.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = open ? 'Close menu' : 'Open menu';
      menu.hidden = !open;
      header.toggleAttribute('data-open', open);
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) menu.querySelector<HTMLElement>('a')?.focus();
      else if (restoreFocus) toggle.focus();
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hidden) setOpen(false);
    });

    window.matchMedia('(min-width: 1080px)').addEventListener('change', (event) => {
      if (event.matches && !menu.hidden) setOpen(false, false);
    });

    // The header turns light or dark to match whatever stage is under it.
    const stages = Array.from(document.querySelectorAll<HTMLElement>('[data-stage]'));
    const probe = header.offsetHeight / 2;
    const onScroll = () => {
      header.toggleAttribute('data-scrolled', window.scrollY > 8);
      const dark = stages.some((stage) => {
        const r = stage.getBoundingClientRect();
        return r.top <= probe && r.bottom >= probe;
      });
      header.dataset.theme = dark ? 'dark' : 'light';
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  }
</script>
