---
// Site-wide cinematic layer: intro loader, Lenis smooth scroll, custom cursor.
// Inspired by lusion.co, tuned to stay fast and degrade gracefully.
---

<!-- Intro loader (shown once per session, only when JS is active) -->
<div id="ax-loader" role="presentation" aria-hidden="true">
  <div class="ax-loader-inner">
    <img
      src="/axiomtransparentlogo.webp"
      alt=""
      width="240"
      height="63"
      class="ax-loader-mark"
      fetchpriority="high"
      decoding="async"
    />
    <div class="ax-loader-bar"><span></span></div>
    <div class="ax-loader-meta">
      <span>Loading</span>
      <span><span class="ax-loader-count">0</span>%</span>
    </div>
  </div>
</div>

<!-- Custom cursor -->
<div id="ax-cursor" aria-hidden="true"><span class="ax-cursor-label"></span></div>

<script>
  // ── Single bundled module, runs once. Re-hooks Astro view-transition events. ──
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = window.matchMedia('(pointer: fine)').matches;

  /* ───────────────────────── Intro loader ───────────────────────── */
  (function intro() {
    const loader = document.getElementById('ax-loader');
    if (!loader) return;

    const seen = sessionStorage.getItem('axiomIntroSeen') === '1';
    const finish = (instant: boolean) => {
      sessionStorage.setItem('axiomIntroSeen', '1');
      document.documentElement.dataset.introSeen = 'true';
      document.dispatchEvent(new CustomEvent('axiom:intro-done'));
      if (instant) {
        loader.style.display = 'none';
        return;
      }
      loader.setAttribute('data-done', 'true');
      window.setTimeout(() => { loader.style.display = 'none'; }, 1000);
    };

    if (seen || reduced) {
      finish(true);
      return;
    }

    // Lock scroll during the intro.
    document.documentElement.classList.add('lenis-stopped');

    const countEl = loader.querySelector('.ax-loader-count') as HTMLElement | null;
    const barEl = loader.querySelector('.ax-loader-bar span') as HTMLElement | null;
    const start = performance.now();
    const duration = 1500;

    const tick = (now: number) => {
      const t = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - t, 3);
      const pct = Math.round(eased * 100);
      if (countEl) countEl.textContent = String(pct);
      if (barEl) barEl.style.setProperty('--ax-progress', String(eased));
      if (t < 1) {
        window.requestAnimationFrame(tick);
      } else {
        document.documentElement.classList.remove('lenis-stopped');
        window.__lenis?.start?.();
        window.setTimeout(() => finish(false), 120);
      }
    };
    window.requestAnimationFrame(tick);
  })();

  // On internal navigation the loader markup re-renders — hide it instantly.
  document.addEventListener('astro:after-swap', () => {
    const loader = document.getElementById('ax-loader');
    if (loader) loader.style.display = 'none';
    document.documentElement.dataset.introSeen = 'true';
  });

  /* ───────────────────────── Lenis smooth scroll ───────────────── */
  let lenis: import('lenis').default | null = null;

  async function initLenis() {
    // Desktop only. Lenis smooth-scroll breaks IntersectionObserver reveals on
    // iOS Safari (content stays hidden) — native touch scrolling is better there.
    const coarse = window.matchMedia('(pointer: coarse)').matches;
    if (reduced || coarse || lenis) return;
    const { default: Lenis } = await import('lenis');
    lenis = new Lenis({
      duration: 1.1,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true,
      touchMultiplier: 1.6,
    });
    window.__lenis = lenis;

    // If the intro is still running, hold scrolling until it finishes.
    if (document.documentElement.classList.contains('lenis-stopped')) lenis.stop();

    let rafId = 0;
    const raf = (time: number) => {
      lenis?.raf(time);
      rafId = window.requestAnimationFrame(raf);
    };
    rafId = window.requestAnimationFrame(raf);
    (lenis as any).__rafId = rafId;
  }

  function destroyLenis() {
    if (!lenis) return;
    window.cancelAnimationFrame((lenis as any).__rafId);
    lenis.destroy();
    lenis = null;
    window.__lenis = null;
  }

  // Smooth-scroll in-page anchor links through Lenis.
  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement)?.closest?.('a[href^="#"]') as HTMLAnchorElement | null;
    if (!link || !lenis) return;
    const id = link.getAttribute('href');
    if (!id || id === '#') return;
    const target = document.querySelector(id);
    if (!target) return;
    e.preventDefault();
    lenis.scrollTo(target as HTMLElement, { offset: -90 });
  });

  initLenis();
  document.addEventListener('astro:before-swap', destroyLenis);
  document.addEventListener('astro:page-load', () => { if (!lenis) initLenis(); });

  /* ─────────────────────── Reveal failsafe ─────────────────────────
     Reveals animate via a native-scroll IntersectionObserver. If that observer
     is wedged on some browser (nothing ever gets marked visible), force content
     visible so it can never stay hidden. When the observer works — the normal
     case — we do nothing and animations play untouched. */
  const revealFailsafe = () => {
    window.setTimeout(() => {
      const anyVisible = document.querySelector(
        '[data-reveal][data-reveal-state="visible"], .section-block[data-motion-visible="true"]'
      );
      if (!anyVisible) document.documentElement.classList.add('ax-reveal-safe');
    }, 3500);
  };
  revealFailsafe();
  document.addEventListener('astro:page-load', revealFailsafe);

  /* ───────────────────────── Custom cursor ─────────────────────── */
  (function cursor() {
    if (reduced || !finePointer) return;
    const el = document.getElementById('ax-cursor');
    const labelEl = el?.querySelector('.ax-cursor-label') as HTMLElement | null;
    if (!el || !labelEl) return;

    document.documentElement.classList.add('ax-cursor-on', 'ax-cursor-active');

    let tx = window.innerWidth / 2;
    let ty = window.innerHeight / 2;
    let cx = tx;
    let cy = ty;
    let visible = false;

    window.addEventListener('mousemove', (e) => {
      tx = e.clientX;
      ty = e.clientY;
      if (!visible) { visible = true; el.classList.remove('is-hidden'); }
    }, { passive: true });

    window.addEventListener('mouseout', (e) => {
      if (!e.relatedTarget) { el.classList.add('is-hidden'); visible = false; }
    });
    window.addEventListener('mousedown', () => el.classList.add('is-down'));
    window.addEventListener('mouseup', () => el.classList.remove('is-down'));

    const INTERACTIVE = 'a, button, input, textarea, select, summary, [role="button"], [data-cursor]';
    document.addEventListener('mouseover', (e) => {
      const hit = (e.target as HTMLElement)?.closest?.(INTERACTIVE) as HTMLElement | null;
      if (!hit) return;
      el.classList.add('is-hover');
      const label = hit.getAttribute('data-cursor-label');
      if (label) { labelEl.textContent = label; el.classList.add('has-label'); }
    });
    document.addEventListener('mouseout', (e) => {
      const hit = (e.target as HTMLElement)?.closest?.(INTERACTIVE) as HTMLElement | null;
      if (!hit) return;
      const to = (e.relatedTarget as HTMLElement)?.closest?.(INTERACTIVE);
      if (to) return; // moved to another interactive element
      el.classList.remove('is-hover', 'has-label');
    });

    const lerp = (a: number, b: number, n: number) => a + (b - a) * n;
    const loop = () => {
      cx = lerp(cx, tx, 0.18);
      cy = lerp(cy, ty, 0.18);
      el.style.transform = `translate3d(${cx.toFixed(2)}px, ${cy.toFixed(2)}px, 0)`;
      window.requestAnimationFrame(loop);
    };
    window.requestAnimationFrame(loop);
  })();
</script>
