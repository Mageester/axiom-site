---
import { founders } from '../../content/company';

type Props = { withAnchors?: boolean };
const { withAnchors = false } = Astro.props;
---

<div class="founders">
  {founders.map((founder) => (
    <article class="founder" id={withAnchors ? founder.id : undefined}>
      <p class="founder-role mono">{founder.role}</p>
      <h3>{founder.name}</h3>
      <p class="founder-bio">{founder.bio}</p>
    </article>
  ))}
</div>

<style>
  .founders {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 720px) {
    .founders {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(2rem, 5vw, 5rem);
    }
  }

  .founder {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding-block: clamp(1.75rem, 1.2rem + 2vw, 3rem);
    border-bottom: 1px solid var(--line);
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .founder h3 {
    font-size: clamp(1.7rem, 1.3rem + 1.4vw, 2.6rem);
    letter-spacing: -0.04em;
  }

  .founder-role {
    color: var(--mute);
  }

  .founder-bio {
    max-width: 34rem;
    color: var(--text);
  }
</style>
