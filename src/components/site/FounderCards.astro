---
import { founders } from '../../content/company';

type Props = { withAnchors?: boolean };
const { withAnchors = false } = Astro.props;
---

<div class="founders">
  {founders.map((founder) => (
    <article class="card founder" id={withAnchors ? founder.id : undefined}>
      <div class="founder-head">
        <span class="avatar" aria-hidden="true">{founder.initials}</span>
        <div>
          <h3>{founder.name}</h3>
          <p class="founder-role">{founder.role}</p>
        </div>
      </div>
      <p class="founder-bio">{founder.bio}</p>
    </article>
  ))}
</div>

<style>
  .founders {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 720px) {
    .founders {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .founder {
    gap: 1.25rem;
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .founder-head {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .founder-head h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 540;
    font-stretch: var(--wdth-heading);
    letter-spacing: -0.02em;
  }

  /* A typographic monogram rather than a stock avatar. */
  .avatar {
    display: inline-grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    flex: none;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 560;
    font-stretch: var(--wdth-display);
    letter-spacing: 0.02em;
  }

  .founder-role {
    margin-top: 0.2rem;
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .founder-bio {
    color: var(--text);
  }
</style>
