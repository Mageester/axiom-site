---
import { keyFacts } from '../../content/company';
import Icon from './Icon.astro';
---

<ul role="list" class="facts" aria-label="Why businesses work with Axiom Web">
  {keyFacts.map((fact) => (
    <li>
      <span class="facts-icon"><Icon name={fact.icon} size={20} /></span>
      <span>
        <strong>{fact.title}</strong>
        <span class="facts-text">{fact.text}</span>
      </span>
    </li>
  ))}
</ul>

<style>
  .facts {
    display: grid;
    gap: 1rem 1.5rem;
    margin: 0;
  }

  @media (min-width: 560px) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .facts li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-size: var(--fs-sm);
    line-height: 1.35;
  }

  .facts strong {
    display: block;
    color: var(--ink);
  }

  .facts-text {
    color: var(--text-muted);
  }

  .facts-icon {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    border-radius: 10px;
    background: #fff;
    border: 1px solid var(--line);
    color: var(--brand);
    box-shadow: var(--shadow-xs);
  }
</style>
