---
import { CTA_PATHS } from '../../lib/cta';
import { SITE_PHONE_DISPLAY, SITE_TELEPHONE } from '../../lib/seo';
import Icon from './Icon.astro';

type Props = {
  title?: string;
  text?: string;
  primaryLabel?: string;
  primaryHref?: string;
};

const {
  title = 'Ready to talk about your website?',
  text = 'Tell us about your business and what the site needs to do. We reply within one business day with a recommended package, a clear price and the next step.',
  primaryLabel = 'Start a project',
  primaryHref = CTA_PATHS.startProject,
} = Astro.props;
---

<section class="cta-band section-sm" aria-labelledby="cta-band-title">
  <div class="container">
    <div class="cta-panel">
      <img class="cta-mark" src="/brand/axiom-mark.webp" width="278" height="347" alt="" loading="lazy" decoding="async" />
      <div class="cta-copy">
        <h2 id="cta-band-title">{title}</h2>
        <p>{text}</p>
      </div>
      <div class="cta-actions">
        <a href={primaryHref} class="btn btn-light btn-lg">{primaryLabel} <Icon name="arrow-right" /></a>
        <a href={`tel:${SITE_TELEPHONE}`} class="btn btn-outline-light btn-lg"><Icon name="phone" /> {SITE_PHONE_DISPLAY}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-panel {
    position: relative;
    display: grid;
    gap: 2rem;
    overflow: hidden;
    padding: clamp(2rem, 1.25rem + 3.5vw, 4rem);
    border: 1px solid transparent;
    border-radius: var(--radius-xl);
    background:
      radial-gradient(44rem 24rem at 100% 0%, rgb(58 108 240 / 0.42), transparent 70%) padding-box,
      radial-gradient(30rem 18rem at 0% 120%, rgb(157 181 255 / 0.14), transparent 70%) padding-box,
      linear-gradient(180deg, #0c1222, #070a13) padding-box,
      linear-gradient(180deg, rgb(160 185 255 / 0.45), rgb(255 255 255 / 0.05) 60%) border-box;
    box-shadow: var(--shadow-lg), 0 0 120px -50px var(--glow);
    color: var(--night-text);
    isolation: isolate;
  }

  /* The chrome mark as a quiet watermark. */
  .cta-mark {
    position: absolute;
    right: 2%;
    bottom: -22%;
    z-index: -1;
    width: clamp(12rem, 8rem + 14vw, 20rem);
    opacity: 0.12;
    mask-image: linear-gradient(200deg, #000 30%, transparent 90%);
    pointer-events: none;
    user-select: none;
  }

  .cta-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(90deg, transparent, #000 60%);
  }

  .cta-copy {
    display: grid;
    gap: 1rem;
    max-width: 40rem;
  }

  .cta-copy h2 {
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.5rem);
  }

  .cta-copy p {
    font-size: var(--fs-lead);
    color: var(--night-text);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .cta-actions .btn:focus-visible {
    box-shadow: 0 0 0 3px var(--night), 0 0 0 5px var(--night-accent);
  }

  @media (max-width: 479px) {
    .cta-actions .btn {
      flex: 1 1 100%;
    }
  }

  @media (min-width: 1024px) {
    .cta-panel {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 3rem;
    }
    .cta-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
