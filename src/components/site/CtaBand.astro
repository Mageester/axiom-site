---
// The closing stage: the dark counterpart to the hero, ending every page with
// one huge line, the round "Start a project" orb and the studio's contact
// details as selectable text.
import { CTA_PATHS } from '../../lib/cta';
import { SITE_ADDRESS, SITE_EMAIL, SITE_PHONE_DISPLAY, SITE_TELEPHONE } from '../../lib/seo';

type Props = {
  title?: string;
  text?: string;
  primaryLabel?: string;
  primaryHref?: string;
};

const {
  title = 'Let’s make yours.',
  text,
  primaryLabel = 'Start a project',
  primaryHref = CTA_PATHS.startProject,
} = Astro.props;

// The last word of the headline is the one set in the serif italic.
const words = title.trim().split(/\s+/);
const last = words.pop() ?? '';
const lead = words.join(' ');
const orbLabel = primaryLabel.split(' ');
const orbTop = orbLabel.slice(0, Math.ceil(orbLabel.length / 2)).join(' ');
const orbBottom = orbLabel.slice(Math.ceil(orbLabel.length / 2)).join(' ');
---

<section class="stage close-stage" data-stage aria-labelledby="cta-band-title">
  <div class="container">
    <div class="close-in">
      <div class="close-copy">
        <h2 id="cta-band-title">{lead}{lead && ' '}<em>{last}</em></h2>
        {text && <p class="close-text">{text}</p>}
      </div>
      <a class="orb" href={primaryHref} data-magnetic="0.22" data-lens-anchor="close">
        <span class="btn-text">{orbTop}{orbBottom && <br />}{orbBottom}</span>
      </a>
    </div>
    <div class="close-contact">
      <div class="email">
        <span id="close-email" class="mono email-text">{SITE_EMAIL}</span>
        <button class="copy mono" type="button" data-copy="close-email">Copy</button>
        <a class="sr-only" href={`mailto:${SITE_EMAIL}`}>Email {SITE_EMAIL}</a>
      </div>
      <div class="close-meta mono">
        <a href={`tel:${SITE_TELEPHONE}`}>{SITE_PHONE_DISPLAY}</a>
        <span>{SITE_ADDRESS}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .close-stage {
    position: relative;
    overflow: hidden;
  }

  .close-stage::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(50% 60% at 70% 55%, var(--night-2) 0%, rgb(7 7 10 / 0) 70%);
    pointer-events: none;
  }

  .close-stage .container {
    position: relative;
    z-index: 2;
  }

  .close-in {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
    padding-block: clamp(6.5rem, 13vw, 12.5rem) clamp(4rem, 8vw, 7.5rem);
  }

  .close-copy {
    display: grid;
    gap: 1.5rem;
  }

  .close-stage h2 {
    font-size: clamp(3.25rem, 1.5rem + 8.6vw, 10.5rem);
    line-height: 0.9;
    letter-spacing: -0.055em;
    color: var(--snow);
    max-width: 10ch;
  }

  .close-text {
    max-width: 34rem;
    color: var(--mute-night);
    font-size: var(--fs-lead);
  }

  .orb {
    position: relative;
    width: clamp(150px, 15vw, 210px);
    aspect-ratio: 1 / 1;
    max-width: 100%;
    border-radius: 50%;
    display: grid;
    place-items: center;
    text-align: center;
    font-weight: 500;
    font-size: 15px;
    line-height: 1.3;
    background: var(--snow);
    color: var(--night);
    overflow: hidden;
    isolation: isolate;
  }

  .orb::before {
    content: '';
    position: absolute;
    left: var(--fx, 50%);
    top: var(--fy, 50%);
    width: 260%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: var(--accent);
    transform: translate(-50%, -50%) scale(0);
    transition: transform 800ms var(--ease);
    z-index: -1;
  }

  .orb:hover::before,
  .orb:focus-visible::before {
    transform: translate(-50%, -50%) scale(1);
  }

  .orb .btn-text {
    display: inline-block;
    transition: transform 600ms var(--ease);
  }

  /* Once the travelling lens docks here, the lens is the orb. */
  .orb.is-lens {
    background: transparent;
    color: var(--snow);
    transition: background-color 600ms var(--ease), color 600ms var(--ease);
  }

  .orb.is-lens::before {
    display: none;
  }

  .close-contact {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    padding-block: 1.5rem 2.25rem;
    border-top: 1px solid var(--line-night);
    color: var(--mute-night);
  }

  .email {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .email-text {
    color: var(--snow);
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    text-transform: none;
    user-select: all;
  }

  .copy {
    background: transparent;
    color: var(--mute-night);
    border: 1px solid var(--line-night);
    border-radius: var(--radius-pill);
    padding: 0.5rem 0.8rem;
    transition: color 300ms, border-color 300ms;
  }

  .copy:hover {
    color: var(--snow);
    border-color: var(--snow);
  }

  .close-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    text-transform: none;
    letter-spacing: 0.02em;
    font-size: 0.8125rem;
  }

  .close-meta a {
    color: var(--snow);
  }

  .close-meta a:hover {
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .close-in {
      grid-template-columns: minmax(0, 1fr);
      justify-items: start;
    }
  }
</style>
