---
import { CTA_PATHS } from '../../lib/cta';
import { SITE_PHONE_DISPLAY, SITE_TELEPHONE } from '../../lib/seo';
import Icon from './Icon.astro';

type Props = {
  title?: string;
  text?: string;
  primaryLabel?: string;
  primaryHref?: string;
};

const {
  title = 'Ready to talk about your website?',
  text = 'Tell us about your business and what the site needs to do. We reply within one business day with a recommended package, a clear price and the next step.',
  primaryLabel = 'Start a project',
  primaryHref = CTA_PATHS.startProject,
} = Astro.props;
---

<section class="cta-band section-sm" aria-labelledby="cta-band-title">
  <div class="container">
    <div class="cta-panel">
      <img class="cta-mark" src="/brand/axiom-mark.webp" width="278" height="347" alt="" loading="lazy" decoding="async" />
      <div class="cta-copy">
        <p class="label">Next step</p>
        <h2 id="cta-band-title">{title}</h2>
        <p>{text}</p>
      </div>
      <div class="cta-actions">
        <a href={primaryHref} class="btn btn-light btn-lg">{primaryLabel} <Icon name="arrow-right" /></a>
        <a href={`tel:${SITE_TELEPHONE}`} class="btn btn-outline-light btn-lg"><Icon name="phone" /> {SITE_PHONE_DISPLAY}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band {
    border-top: 1px solid var(--line);
  }

  .cta-panel {
    position: relative;
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    isolation: isolate;
  }

  /* The chrome mark as a quiet watermark. */
  .cta-mark {
    position: absolute;
    top: 50%;
    right: 0;
    z-index: -1;
    width: clamp(9rem, 6rem + 10vw, 15rem);
    opacity: 0.1;
    transform: translateY(-50%);
    pointer-events: none;
    user-select: none;
  }

  .cta-copy {
    display: grid;
    gap: 1.25rem;
    max-width: 56rem;
  }

  .cta-copy h2 {
    font-size: clamp(2.2rem, 1.2rem + 4vw, 4.75rem);
    font-stretch: var(--wdth-display);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .cta-copy p:not(.label) {
    max-width: 38rem;
    font-size: var(--fs-lead);
    color: var(--text);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (max-width: 719px) {
    .cta-mark {
      display: none;
    }
  }

  @media (max-width: 479px) {
    .cta-actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
