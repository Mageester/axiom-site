---
import { cities } from '../../content/cities';
import { industries } from '../../content/industries';
import { services } from '../../content/services';
import { CTA_PATHS } from '../../lib/cta';
import { SITE_ADDRESS, SITE_EMAIL, SITE_PHONE_DISPLAY, SITE_TELEPHONE } from '../../lib/seo';
import EmailText from './EmailText.astro';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Services',
    links: [
      ...services.map((service) => ({ label: service.name, href: `/services/${service.slug}/` })),
      { label: 'All services', href: '/services/' },
      { label: 'Pricing', href: '/pricing/' },
    ],
  },
  {
    title: 'Studio',
    links: [
      { label: 'About', href: '/about/' },
      { label: 'Our process', href: '/approach/' },
      { label: 'Work', href: '/work/' },
      { label: 'For agencies', href: '/agencies/' },
      { label: 'Contact', href: '/contact/' },
      { label: 'Start a project', href: CTA_PATHS.startProject },
    ],
  },
  {
    title: 'Industries',
    links: [
      ...industries.map((industry) => ({ label: industry.name, href: `/industries/${industry.slug}/` })),
      { label: 'All industries', href: '/industries/' },
    ],
  },
  {
    title: 'Service areas',
    links: [
      ...cities.map((city) => ({ label: `Web design ${city.name}`, href: `/web-design/${city.slug}/` })),
      { label: 'All service areas', href: '/web-design/' },
    ],
  },
];
---

<footer class="site-footer" data-stage>
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-wordmark" aria-label="Axiom Web home">axiom<span>web</span></a>
        <p class="footer-about">
          A two-person web studio in Kitchener-Waterloo. Websites for local businesses across Ontario, and quiet overflow work for agencies.
        </p>
        <ul role="list" class="footer-contact mono">
          <li><a href={`mailto:${SITE_EMAIL}`}><EmailText /></a></li>
          <li><a href={`tel:${SITE_TELEPHONE}`}>{SITE_PHONE_DISPLAY}</a></li>
          <li><span>{SITE_ADDRESS}</span></li>
        </ul>
      </div>

      <nav class="footer-columns" aria-label="Footer">
        {columns.map((column) => (
          <div>
            <h2 class="footer-heading mono">{column.title}</h2>
            <ul role="list">
              {column.links.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <div class="footer-bottom">
      <p>
        © {year} Axiom Web. Co-founded by Aidan Magee and Riley Hinsperger. Axiom Web is the web-focused subsidiary of Axiom International.
      </p>
      <ul role="list" class="footer-legal">
        <li><a href="/privacy/">Privacy Policy</a></li>
        <li><a href="/terms/">Terms of Service</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem) 2rem;
    border-top: 1px solid var(--line-night);
    font-size: var(--fs-sm);
  }

  .footer-top {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 1080px) {
    .footer-top {
      grid-template-columns: minmax(16rem, 0.9fr) 2.6fr;
      gap: 4rem;
    }
  }

  .footer-wordmark {
    display: inline-flex;
    gap: 0.3em;
    min-height: 2.75rem;
    align-items: center;
    color: var(--snow);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .footer-wordmark span {
    font-weight: 400;
    color: var(--mute-night);
  }

  .footer-about {
    max-width: 22rem;
    margin-top: 1rem;
    color: var(--mute-night);
    line-height: 1.6;
  }

  .footer-contact {
    display: grid;
    gap: 0.25rem;
    margin: 1.75rem 0 0;
    text-transform: none;
    letter-spacing: 0.02em;
    font-size: 0.8125rem;
  }

  .footer-contact a,
  .footer-contact span {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    color: var(--snow);
  }

  .footer-contact span {
    color: var(--mute-night);
  }

  .footer-contact a:hover {
    color: var(--accent);
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 1.5rem;
  }

  @media (min-width: 760px) {
    .footer-columns {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .footer-heading {
    margin-bottom: 0.9rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line-night);
    color: var(--mute-night);
  }

  .footer-columns ul {
    display: grid;
    gap: 0.1rem;
    margin: 0;
  }

  .footer-columns a {
    display: inline-flex;
    align-items: center;
    min-height: 2.1rem;
    color: var(--mute-night);
    line-height: 1.35;
    transition: color 300ms var(--ease);
  }

  .footer-columns a:hover {
    color: var(--snow);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--line-night);
    color: var(--mute-night);
    font-size: var(--fs-xs);
  }

  .footer-bottom p {
    max-width: 52rem;
  }

  .footer-legal {
    display: flex;
    gap: 1.25rem;
    margin: 0;
  }

  .footer-legal a {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    color: var(--mute-night);
  }

  .footer-legal a:hover {
    color: var(--snow);
  }
</style>
