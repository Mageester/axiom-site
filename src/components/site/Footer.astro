---
import { cities } from '../../content/cities';
import { industries } from '../../content/industries';
import { services } from '../../content/services';
import { CTA_PATHS } from '../../lib/cta';
import { SITE_EMAIL, SITE_LOCATION, SITE_PHONE_DISPLAY, SITE_TELEPHONE } from '../../lib/seo';
import EmailText from './EmailText.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Services',
    links: [
      ...services.map((service) => ({ label: service.name, href: `/services/${service.slug}/` })),
      { label: 'All services', href: '/services/' },
      { label: 'Pricing', href: '/pricing/' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About', href: '/about/' },
      { label: 'Our process', href: '/approach/' },
      { label: 'Work', href: '/work/' },
      { label: 'For agencies', href: '/agencies/' },
      { label: 'Contact', href: '/contact/' },
      { label: 'Start a project', href: CTA_PATHS.startProject },
    ],
  },
  {
    title: 'Industries',
    links: [
      ...industries.map((industry) => ({ label: industry.name, href: `/industries/${industry.slug}/` })),
      { label: 'All industries', href: '/industries/' },
    ],
  },
  {
    title: 'Service areas',
    links: [
      ...cities.map((city) => ({ label: `Web design ${city.name}`, href: `/web-design/${city.slug}/` })),
      { label: 'All service areas', href: '/web-design/' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="Axiom Web home"><Logo height={36} /></a>
        <p class="footer-about">
          A founder-led web design studio in Kitchener-Waterloo, building clear, fast websites for local businesses across Ontario.
        </p>
        <ul role="list" class="footer-contact">
          <li>
            <a href={`tel:${SITE_TELEPHONE}`}><Icon name="phone" size={18} />{SITE_PHONE_DISPLAY}</a>
          </li>
          <li>
            <a href={`mailto:${SITE_EMAIL}`}><Icon name="mail" size={18} /><EmailText /></a>
          </li>
          <li><span><Icon name="map-pin" size={18} />{SITE_LOCATION}</span></li>
        </ul>
      </div>

      <nav class="footer-columns" aria-label="Footer">
        {columns.map((column) => (
          <div>
            <h2 class="footer-heading">{column.title}</h2>
            <ul role="list">
              {column.links.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <img class="footer-mark" src="/brand/axiom-logo.webp" width="493" height="132" alt="" loading="lazy" decoding="async" />

    <div class="footer-bottom">
      <p>
        © {year} Axiom Web. Co-founded by Aidan Magee and Riley Hinsperger. Axiom Web is the web-focused subsidiary of Axiom International.
      </p>
      <ul role="list" class="footer-legal">
        <li><a href="/privacy/">Privacy Policy</a></li>
        <li><a href="/terms/">Terms of Service</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    background: var(--night);
    border-top: 1px solid var(--line);
    color: var(--night-text);
    padding-block: clamp(4rem, 2.5rem + 5vw, 6.5rem) 2rem;
    font-size: var(--fs-sm);
  }

  .footer-top {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 1080px) {
    .footer-top {
      grid-template-columns: minmax(16rem, 0.85fr) 2.6fr;
      gap: 4rem;
    }
  }

  .footer-logo {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
  }

  .footer-about {
    max-width: 22rem;
    margin-top: 1rem;
    color: var(--night-text);
    line-height: 1.65;
  }

  .footer-contact {
    display: grid;
    gap: 0.35rem;
    margin: 1.5rem 0 0;
  }

  .footer-contact a,
  .footer-contact span {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 2.25rem;
    color: var(--ink);
    font-weight: 500;
  }

  .footer-contact a:hover {
    color: var(--accent);
  }

  .footer-contact :global(svg) {
    flex: none;
    color: var(--text-muted);
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 1.5rem;
  }

  @media (min-width: 760px) {
    .footer-columns {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .footer-heading {
    margin-bottom: 0.9rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: var(--fs-label);
    font-weight: 600;
    font-stretch: var(--wdth-heading);
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .footer-columns ul {
    display: grid;
    gap: 0.1rem;
    margin: 0;
  }

  .footer-columns a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    color: var(--night-text);
    line-height: 1.35;
    transition: color 160ms var(--ease);
  }

  .footer-columns a:hover {
    color: var(--ink);
  }

  /* The full lockup, oversized and fading into the floor. */
  .footer-mark {
    width: 100%;
    max-width: 68rem;
    margin: clamp(3.5rem, 2rem + 5vw, 6rem) auto 0;
    opacity: 0.08;
    mask-image: linear-gradient(180deg, #000 10%, transparent 95%);
    pointer-events: none;
    user-select: none;
  }

  .footer-bottom {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: clamp(-3rem, -1rem - 3vw, -1rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
    color: var(--night-muted);
    font-size: var(--fs-xs);
  }

  .footer-bottom p {
    max-width: 52rem;
  }

  .footer-legal {
    display: flex;
    gap: 1.25rem;
    margin: 0;
  }

  .footer-legal a {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    color: var(--night-text);
  }

  .footer-legal a:hover {
    color: var(--ink);
  }
</style>
