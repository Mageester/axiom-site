---
import { SITE_EMAIL, type Crumb } from '../../lib/seo';
import EmailText from './EmailText.astro';
import PageHero from './PageHero.astro';

type LegalSection = {
  id: string;
  number: string;
  title: string;
  paragraphs: string[];
  bullets?: string[];
};

type Props = {
  title: string;
  updated: string;
  sections: LegalSection[];
  crumbs: Crumb[];
};

const { title, updated, sections, crumbs } = Astro.props as Props;
---

<main id="main-content" tabindex="-1">
  <PageHero eyebrow="Legal" title={title} lead={`Last updated ${updated}.`} crumbs={crumbs} />

  <section class="section">
    <div class="container legal-layout">
      <nav class="legal-toc" aria-label="On this page">
        <p class="legal-toc-title">On this page</p>
        <ol role="list">
          {sections.map((section) => (
            <li>
              <a href={`#${section.id}`}><span>{section.number}</span>{section.title}</a>
            </li>
          ))}
        </ol>
      </nav>

      <article class="prose legal-body">
        {sections.map((section) => (
          <section id={section.id} class="legal-section">
            <h2><span class="legal-num">{section.number}.</span> {section.title}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && (
              <ul>
                {section.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            )}
          </section>
        ))}
        <section class="legal-section">
          <h2>Questions</h2>
          <p>
            Contact us at <a href={`mailto:${SITE_EMAIL}`}><EmailText /></a> with any questions about this page.
          </p>
        </section>
      </article>
    </div>
  </section>
</main>

<style>
  .legal-layout {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 1024px) {
    .legal-layout {
      grid-template-columns: 15rem minmax(0, 46rem);
      gap: 4rem;
      justify-content: center;
    }
    .legal-toc {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      align-self: start;
    }
  }

  .legal-toc {
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .legal-toc-title {
    margin-bottom: 0.5rem;
    color: var(--ink);
    font-size: var(--fs-xs);
    font-weight: 600;
  }

  .legal-toc ol {
    display: grid;
    gap: 0.1rem;
    margin: 0;
  }

  .legal-toc a {
    display: flex;
    gap: 0.6rem;
    padding: 0.4rem 0;
    color: var(--text);
    font-size: var(--fs-sm);
    line-height: 1.45;
  }

  .legal-toc a:hover {
    color: #fff;
  }

  .legal-toc a span {
    min-width: 1.1rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .legal-body .legal-section {
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .legal-body .legal-section:first-child h2 {
    margin-top: 0;
  }

  .legal-num {
    color: var(--brand-ink);
    -webkit-text-fill-color: var(--brand-ink);
  }
</style>
