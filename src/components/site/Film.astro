---
import Icon from './Icon.astro';

// Poster loads lazily; the 14 MB video is only requested once the visitor presses play.
---

<figure class="film" data-film>
  <div class="film-frame">
    <picture class="film-poster" data-film-poster>
      <source
        type="image/avif"
        srcset="/film/axiom-film-poster-800.avif 800w, /film/axiom-film-poster-1600.avif 1600w"
        sizes="(min-width: 1180px) 1100px, 92vw"
      />
      <img
        src="/film/axiom-film-poster.webp"
        srcset="/film/axiom-film-poster-800.webp 800w, /film/axiom-film-poster.webp 1600w"
        sizes="(min-width: 1180px) 1100px, 92vw"
        width="1600"
        height="900"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </picture>
    <video class="film-video" preload="none" playsinline width="1920" height="1080" data-film-video>
      <source src="/film/axiom-built-to-the-pixel-1080.mp4" type="video/mp4" />
      <track kind="captions" src="/film/axiom-built-to-the-pixel.en.vtt" srclang="en" label="English" />
    </video>
    <button type="button" class="film-play" data-film-play>
      <span class="film-play-icon" aria-hidden="true"><Icon name="play" size={26} strokeWidth={0} /></span>
      <span class="film-play-label">Play film <span class="film-duration">0:32</span></span>
    </button>
  </div>
  <figcaption>Built to the pixel. A 32-second film about how we approach every website.</figcaption>
</figure>

<style>
  .film {
    margin: 0;
  }

  .film-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: #000;
  }

  .film-poster,
  .film-poster img,
  .film-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .film-video {
    background: #000;
    visibility: hidden;
  }

  [data-playing] .film-video {
    visibility: visible;
  }

  /* The whole frame is the button; the visible control sits in the corner. */
  .film-play {
    position: absolute;
    inset: 0;
    display: grid;
    grid-auto-flow: column;
    align-content: end;
    justify-content: start;
    align-items: center;
    gap: 1rem;
    padding: clamp(1rem, 0.5rem + 2vw, 2rem);
    border: 0;
    background: linear-gradient(180deg, transparent 55%, rgb(0 0 0 / 0.55));
    color: var(--ink);
  }

  .film-play-icon {
    display: inline-grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--bg);
    transition: background-color 200ms var(--ease);
  }

  .film-play-icon :global(svg) {
    margin-left: 0.15rem;
    fill: currentColor;
  }

  .film-play:hover .film-play-icon {
    background: #fff;
  }

  .film-play:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -6px;
  }

  .film-play-label {
    display: inline-flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .film-duration {
    color: var(--ink-2);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  [data-playing] .film-poster,
  [data-playing] .film-play {
    display: none;
  }

  figcaption {
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-film]').forEach((film) => {
    const video = film.querySelector<HTMLVideoElement>('[data-film-video]');
    const play = film.querySelector<HTMLButtonElement>('[data-film-play]');
    if (!video || !play) return;
    play.addEventListener('click', () => {
      film.setAttribute('data-playing', '');
      video.controls = true;
      video.play().catch(() => undefined);
      video.focus();
    });
  });
</script>
