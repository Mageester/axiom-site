---
type Props = { url: string; class?: string };
const { url, class: className } = Astro.props;
---

<figure class:list={['browser', className]}>
  <div class="browser-bar" aria-hidden="true">
    <span class="browser-dots"><i></i><i></i><i></i></span>
    <span class="browser-url">{url}</span>
  </div>
  <div class="browser-view"><slot /></div>
  {Astro.slots.has('caption') && <figcaption class="sr-only"><slot name="caption" /></figcaption>}
</figure>

<style>
  .browser {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .browser-bar {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    height: 2.25rem;
    padding-inline: 0.9rem;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  .browser-dots {
    display: inline-flex;
    gap: 0.35rem;
  }

  .browser-dots i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.14);
  }

  .browser-url {
    flex: 1;
    max-width: 22rem;
    margin-inline: auto;
    overflow: hidden;
    color: var(--text-muted);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .browser-view {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--bg-tint);
  }
</style>
