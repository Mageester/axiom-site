---
import type { Crumb } from '../../lib/seo';
import Breadcrumbs from './Breadcrumbs.astro';

type Props = {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: Crumb[];
  center?: boolean;
};

const { eyebrow, title, lead, crumbs, center = false } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class:list={['page-hero', { 'has-aside': hasAside, center }]}>
  <div class="grid-lines" aria-hidden="true"></div>
  <div class="container">
    {crumbs && crumbs.length > 1 && <Breadcrumbs items={crumbs} />}
    <div class="page-hero-grid">
      <div class="page-hero-copy">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{title}</h1>
        {lead && <p class="lead">{lead}</p>}
        <slot />
        {Astro.slots.has('actions') && (
          <div class="btn-row page-hero-actions">
            <slot name="actions" />
          </div>
        )}
      </div>
      {hasAside && (
        <div class="page-hero-aside">
          <slot name="aside" />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(1.5rem, 1rem + 1.5vw, 2.25rem) clamp(4rem, 2.5rem + 5vw, 7rem);
    border-bottom: 1px solid var(--line);
    isolation: isolate;
  }

  .page-hero > .container {
    position: relative;
    z-index: 1;
  }

  .page-hero h1 {
    font-size: var(--fs-h1);
  }

  @media (prefers-reduced-motion: no-preference) {
    .page-hero-copy > * {
      animation: hero-in 900ms var(--ease-out) both;
    }
    .page-hero-copy > :nth-child(2) {
      animation-delay: 70ms;
    }
    .page-hero-copy > :nth-child(3) {
      animation-delay: 140ms;
    }
    .page-hero-copy > :nth-child(n + 4) {
      animation-delay: 210ms;
    }
    .page-hero-aside {
      animation: hero-in 1100ms var(--ease-out) 200ms both;
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  .page-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    margin-top: clamp(1.75rem, 1.25rem + 2vw, 3rem);
  }

  .page-hero:not(:has(.breadcrumbs)) .page-hero-grid {
    margin-top: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .page-hero-copy {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    max-width: 52rem;
  }

  .page-hero-copy .lead {
    max-width: 40rem;
  }

  .page-hero-actions {
    margin-top: 0.75rem;
  }

  .center .page-hero-copy {
    margin-inline: auto;
    justify-items: center;
    text-align: center;
  }

  .center .page-hero-actions {
    justify-content: center;
  }

  @media (min-width: 1024px) {
    .has-aside .page-hero-grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(20rem, 0.85fr);
      align-items: end;
      gap: 4rem;
    }
  }
</style>
