---
import { industries } from '../../content/industries';
import { CTA_PATHS } from '../../lib/cta';
import Icon from './Icon.astro';
import LinkCard from './LinkCard.astro';

type Props = { detailed?: boolean };
const { detailed = false } = Astro.props;
---

<div class="grid grid-3">
  {industries.map((industry) => (
    <LinkCard
      href={`/industries/${industry.slug}/`}
      icon={industry.icon}
      title={industry.name}
      meta={detailed ? industry.examples : undefined}
      text={detailed ? industry.intro : industry.examples}
      linkLabel={detailed ? 'Read the guide' : 'See what matters'}
    />
  ))}
  <article class="card industry-other">
    <h3>Something else?</h3>
    <p>The same principles apply to most local businesses: a clear offer, honest proof and an easy next step. Tell us what you do.</p>
    <a href={CTA_PATHS.startProject} class="btn btn-secondary">Tell us about your business <Icon name="arrow-right" /></a>
  </article>
</div>

<style>
  .industry-other {
    gap: 0.75rem;
    justify-content: center;
    border: 1px dashed var(--line-strong);
    background: transparent;
    box-shadow: none;
  }

  .industry-other p {
    color: var(--text);
    font-size: var(--fs-sm);
  }

  .industry-other .btn {
    align-self: start;
    margin-top: 0.5rem;
  }
</style>
