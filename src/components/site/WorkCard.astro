---
import type { Project } from '../../content/work';
import Icon from './Icon.astro';
import ResponsivePicture from './ResponsivePicture.astro';

type Props = {
  project: Project;
  sizes?: string;
  detailed?: boolean;
  /** Wide, side-by-side layout for the lead project in a showcase. */
  featured?: boolean;
};

const {
  project,
  sizes = '(min-width: 1024px) 380px, (min-width: 720px) 45vw, 92vw',
  detailed = false,
  featured = false,
} = Astro.props;
const isClient = project.kind === 'client';
---

<article class:list={['card', 'card-link', 'work-card', { 'work-featured': featured }]}>
  <div class="work-media">
    <ResponsivePicture source={project.image} alt={project.alt} sizes={sizes} position={project.position} />
    <span class:list={['badge', 'work-badge', isClient ? 'badge-success badge-dot' : '']}>
      {isClient ? 'Client site · Live' : 'Concept build'}
    </span>
  </div>
  <div class="work-body">
    <p class="label work-meta">
      {project.industryLabel}{project.location && <> · {project.location}</>}
    </p>
    <h3>
      <a href={project.href} class="stretched" target="_blank" rel="noopener">
        {project.title}
        <span class="sr-only"> ({isClient ? 'live client website' : 'concept build'}, opens in a new tab)</span>
      </a>
    </h3>
    <p class="work-summary">{project.summary}</p>
    {detailed && (
      <dl class="work-details">
        <div>
          <dt>The brief</dt>
          <dd>{project.brief}</dd>
        </div>
        <div>
          <dt>What we built</dt>
          <dd>{project.built}</dd>
        </div>
      </dl>
    )}
    <span class="arrow-link work-link" aria-hidden="true">
      {isClient ? 'Visit website' : 'View concept'} <Icon name="arrow-up-right" />
    </span>
  </div>
</article>

<style>
  .work-card {
    padding: 0;
    overflow: hidden;
  }

  .work-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--bg-tint);
    border-bottom: 1px solid var(--line);
  }

  .work-media :global(img) {
    transition: transform 900ms var(--ease-out);
  }

  @media (hover: hover) {
    .work-card:hover .work-media :global(img) {
      transform: scale(1.03);
    }
  }

  .work-badge {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    z-index: 1;
  }

  .work-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.4rem 1.5rem 1.25rem;
  }

  .work-body h3 {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.05rem + 0.5vw, 1.45rem);
    font-weight: 540;
    font-stretch: var(--wdth-heading);
    letter-spacing: -0.02em;
  }

  .work-body h3 a {
    color: var(--ink);
  }

  .work-summary {
    color: var(--text);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  .work-details {
    display: grid;
    gap: 0.85rem;
    margin: 0.4rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-sm);
  }

  .work-details dt {
    color: var(--ink);
    font-weight: 600;
  }

  .work-details dd {
    margin: 0.15rem 0 0;
    color: var(--text);
    line-height: 1.6;
  }

  .work-link {
    margin-top: auto;
    padding-top: 0.35rem;
  }

  @media (hover: hover) {
    .work-card:hover .work-link {
      color: var(--accent);
    }
    .work-card:hover .work-link :global(svg) {
      transform: translate(2px, -2px);
    }
  }

  @media (min-width: 900px) {
    .work-featured {
      display: grid;
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    }

    .work-featured .work-media {
      aspect-ratio: auto;
      min-height: 26rem;
      border-right: 1px solid var(--line);
      border-bottom: 0;
    }

    .work-featured .work-media :global(picture),
    .work-featured .work-media :global(img) {
      position: absolute;
      inset: 0;
      height: 100%;
    }

    .work-featured .work-body {
      justify-content: center;
      gap: 0.85rem;
      padding: clamp(2rem, 1rem + 2.5vw, 3rem);
    }

    .work-featured h3 {
      font-size: clamp(1.6rem, 1.1rem + 1.4vw, 2.4rem);
      font-stretch: var(--wdth-display);
      letter-spacing: -0.03em;
    }

    .work-featured .work-summary {
      font-size: var(--fs-body);
    }

    .work-featured .work-link {
      margin-top: 0.75rem;
    }
  }
</style>
