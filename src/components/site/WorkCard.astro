---
import type { Project } from '../../content/work';
import Icon from './Icon.astro';
import ResponsivePicture from './ResponsivePicture.astro';

type Props = {
  project: Project;
  sizes?: string;
  detailed?: boolean;
  /** Wide, side-by-side layout for the lead project in a showcase. */
  featured?: boolean;
};

const {
  project,
  sizes = '(min-width: 1024px) 380px, (min-width: 720px) 45vw, 92vw',
  detailed = false,
  featured = false,
} = Astro.props;
const isClient = project.kind === 'client';
---

<article class:list={['work-card', { 'work-featured': featured }]}>
  <div class="work-media">
    <ResponsivePicture source={project.image} alt={project.alt} sizes={sizes} position={project.position} />
  </div>
  <div class="work-body">
    <p class="work-meta mono">
      <span>{project.industryLabel}{project.location && <> · {project.location}</>}</span>
      <span class:list={['tag', { live: isClient }]}>{isClient ? 'Client · Live' : 'Concept'}</span>
    </p>
    <h3>
      <a href={project.href} class="stretched" target="_blank" rel="noopener">
        {project.title}
        <span class="sr-only"> ({isClient ? 'live client website' : 'concept build'}, opens in a new tab)</span>
      </a>
    </h3>
    <p class="work-summary">{project.summary}</p>
    {detailed && (
      <dl class="work-details">
        <div>
          <dt>The brief</dt>
          <dd>{project.brief}</dd>
        </div>
        <div>
          <dt>What we built</dt>
          <dd>{project.built}</dd>
        </div>
      </dl>
    )}
    <span class="arrow-link work-link" aria-hidden="true">
      {isClient ? 'Visit website' : 'View concept'} <Icon name="arrow-up-right" />
    </span>
  </div>
</article>

<style>
  .work-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .work-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--snow);
  }

  .work-media :global(img) {
    transition: transform 1200ms var(--ease-out);
  }

  @media (hover: hover) {
    .work-card:hover .work-media :global(img) {
      transform: scale(1.04);
    }
  }

  .work-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.6rem;
  }

  .work-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    color: var(--mute);
  }

  .tag {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    color: var(--ink);
  }

  .tag.live {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .work-body h3 {
    font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem);
    letter-spacing: -0.035em;
  }

  .work-body h3 a {
    color: var(--ink);
  }

  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }

  .stretched:focus-visible {
    outline: none;
  }

  .work-card:has(.stretched:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
    border-radius: var(--radius-lg);
  }

  .work-summary {
    color: var(--text);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  .work-details {
    display: grid;
    gap: 0.85rem;
    margin: 0.4rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-sm);
  }

  .work-details dt {
    color: var(--ink);
    font-weight: 500;
  }

  .work-details dd {
    margin: 0.15rem 0 0;
    color: var(--text);
    line-height: 1.6;
  }

  .work-link {
    margin-top: auto;
    padding-top: 0.35rem;
  }

  @media (hover: hover) {
    .work-card:hover .work-link :global(svg) {
      transform: translate(2px, -2px);
    }
  }

  @media (min-width: 900px) {
    .work-featured {
      display: grid;
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: center;
    }

    .work-featured .work-media {
      aspect-ratio: 16 / 11;
    }

    .work-featured h3 {
      font-size: clamp(1.8rem, 1.2rem + 1.8vw, 3rem);
      letter-spacing: -0.04em;
    }

    .work-featured .work-summary {
      font-size: var(--fs-body);
    }
  }
</style>
