---
import Icon from './Icon.astro';

type Props = {
  href: string;
  title: string;
  text: string;
  meta?: string;
  linkLabel?: string;
};

const { href, title, text, meta, linkLabel = 'Learn more' } = Astro.props;
---

<article class="card card-link link-card">
  {meta && <p class="label">{meta}</p>}
  <h3><a href={href} class="stretched">{title}</a></h3>
  <p class="link-card-text">{text}</p>
  <span class="arrow-link" aria-hidden="true">{linkLabel} <Icon name="arrow-right" /></span>
</article>

<style>
  .link-card {
    gap: 0.75rem;
  }

  .link-card h3 {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.05rem + 0.5vw, 1.45rem);
    font-weight: 540;
    font-stretch: var(--wdth-heading);
    letter-spacing: -0.02em;
  }

  .link-card h3 a {
    color: var(--ink);
  }

  .link-card-text {
    color: var(--text);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  .link-card .arrow-link {
    margin-top: auto;
    padding-top: 0.5rem;
  }

  @media (hover: hover) {
    .link-card:hover .arrow-link {
      color: var(--accent);
    }
    .link-card:hover .arrow-link :global(svg) {
      transform: translateX(3px);
    }
  }
</style>
