---
import { CTA_PATHS } from '../../lib/cta';

interface Props {
  hidePrimaryCta?: boolean;
}

const { hidePrimaryCta = false } = Astro.props;
const pathname = Astro.url.pathname;

const LINKS = [
  { label: 'Services', href: '/services' },
  { label: 'Work', href: '/work' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
] as const;

const MOBILE_LINKS = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
  { label: 'Work', href: '/work' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
] as const;

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(`${href}/`);

const navLinkClass =
  'motion-link-accent min-h-11 py-2 text-[14px] font-medium transition-colors duration-200 hover:text-[var(--text-primary)]';
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50" transition:persist>
  <div
    id="nav-shell"
    class="border-b border-[color:var(--hairline)] backdrop-blur-[16px] transition-[background-color,border-color] duration-200"
    style="background-color: var(--nav-shell-bg);"
  >
    <div class="axiom-container flex h-16 items-center justify-between gap-6">
      <a href="/" class="site-logo flex min-h-11 items-center" aria-label="Axiom Web home">
        <img
          src="/axiomtransparentlogo.webp"
          alt=""
          width="240"
          height="63"
          class="block h-8 w-auto select-none object-contain"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </a>

      <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
        {LINKS.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class={`${navLinkClass} ${isActive(link.href) ? 'text-[var(--text-primary)]' : 'text-[var(--text-secondary)]'}`}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-4">
        <a
          href="tel:+12267531833"
          class="hidden min-h-11 items-center gap-2 font-mono text-[12px] uppercase tracking-[0.12em] text-[var(--text-secondary)] transition-colors duration-200 hover:text-[var(--text-primary)] lg:inline-flex"
          aria-label="Call Axiom Web at 226-753-1833"
        >
          (226) 753-1833
        </a>
        {!hidePrimaryCta && (
          <a href={CTA_PATHS.startProject} class="btn btn-primary btn-sm hidden md:inline-flex">
            Start a project
          </a>
        )}

        <button
          id="nav-toggle"
          type="button"
          aria-label="Open navigation"
          aria-expanded="false"
          aria-controls="mobile-nav-panel"
          class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-[color:var(--hairline)] text-[var(--text-primary)] transition-[border-color] duration-200 hover:border-[color:var(--hairline-strong)] md:hidden"
        >
          <span class="relative block h-4 w-5" aria-hidden="true">
            <span class="bar bar-top absolute left-0 top-0 h-px w-5 bg-current"></span>
            <span class="bar bar-mid absolute left-0 top-[7px] h-px w-5 bg-current"></span>
            <span class="bar bar-bot absolute left-0 top-[14px] h-px w-5 bg-current"></span>
          </span>
        </button>
      </div>
    </div>
  </div>
</header>

<div
  id="mobile-nav-panel"
  role="dialog"
  aria-modal="true"
  aria-label="Site navigation"
  aria-hidden="true"
  inert
  class="fixed inset-0 z-[60] px-6 py-8 backdrop-blur-[24px] md:hidden"
  style="background-color: var(--nav-panel-bg);"
>
  <div class="mx-auto flex h-full max-w-5xl flex-col justify-between pt-20">
    <div class="flex items-center justify-between">
      <a href="/" class="flex min-h-11 items-center" aria-label="Axiom Web home">
        <img
          src="/axiomtransparentlogo.webp"
          alt=""
          width="240"
          height="63"
          class="block h-8 w-auto select-none object-contain"
          loading="eager"
          decoding="async"
        />
      </a>
      <button
        id="nav-close"
        type="button"
        aria-label="Close navigation"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-[color:var(--hairline)] text-[var(--text-primary)]"
      >
        <span aria-hidden="true" class="text-xl leading-none">&times;</span>
      </button>
    </div>

    <nav class="flex flex-col gap-3" aria-label="Mobile navigation">
      {MOBILE_LINKS.map((link, index) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          data-nav-close
          class={`mobile-nav-link block min-h-11 font-display text-[clamp(2.25rem,9vw,3.75rem)] font-medium leading-[1.05] tracking-[-0.02em] text-[var(--text-primary)]${index === 0 ? ' mt-2' : ''}`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="space-y-4 border-t border-[color:var(--hairline)] pt-6">
      <a
        href="tel:+12267531833"
        data-nav-close
        class="flex min-h-11 items-center gap-3 font-mono text-[13px] uppercase tracking-[0.12em] text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
        aria-label="Call Axiom Web at 226-753-1833"
      >
        (226) 753-1833
      </a>
      {!hidePrimaryCta && (
        <a href={CTA_PATHS.startProject} data-nav-close class="btn btn-primary w-full">
          Start a project
        </a>
      )}
    </div>
  </div>
</div>

<style>
  #nav-toggle,
  #nav-close {
    touch-action: manipulation;
  }

  #nav-shell[data-scrolled] {
    background-color: var(--nav-shell-bg-scrolled) !important;
    border-color: var(--hairline-strong);
  }

  #mobile-nav-panel {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--duration-medium) var(--ease-premium),
      visibility var(--duration-medium) var(--ease-premium);
  }

  #mobile-nav-panel.nav-open {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }

  .bar {
    transition: transform 240ms var(--ease-premium), opacity 200ms var(--ease-premium);
  }

  #nav-toggle[aria-expanded='true'] .bar-top {
    transform: translateY(7px) rotate(45deg);
  }

  #nav-toggle[aria-expanded='true'] .bar-mid {
    opacity: 0;
  }

  #nav-toggle[aria-expanded='true'] .bar-bot {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    #mobile-nav-panel {
      transition: none !important;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const toggle = document.getElementById('nav-toggle') as HTMLButtonElement | null;
    const panel = document.getElementById('mobile-nav-panel');
    const closeButton = document.getElementById('nav-close') as HTMLButtonElement | null;
    let lastFocused: HTMLElement | null = null;

    if (!toggle || !panel) return;
    if (toggle.dataset.navBound === 'true') return;
    toggle.dataset.navBound = 'true';

    function openMenu() {
      if (!panel || !toggle) return;
      lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      panel.removeAttribute('inert');
      panel.classList.add('nav-open');
      panel.setAttribute('aria-hidden', 'false');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close navigation');
      document.body.style.overflow = 'hidden';
      window.requestAnimationFrame(() => closeButton?.focus());
    }

    function closeMenu() {
      if (!panel || !toggle) return;
      panel.classList.remove('nav-open');
      panel.setAttribute('aria-hidden', 'true');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open navigation');
      document.body.style.overflow = '';
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        panel.setAttribute('inert', '');
      } else {
        panel.addEventListener('transitionend', () => panel.setAttribute('inert', ''), { once: true });
      }
      window.requestAnimationFrame(() => lastFocused?.focus());
    }

    toggle.addEventListener('click', () => {
      toggle.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu();
    });
    closeButton?.addEventListener('click', closeMenu);
    panel.querySelectorAll('[data-nav-close]').forEach((el) => el.addEventListener('click', closeMenu));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
      if (e.key !== 'Tab' || toggle.getAttribute('aria-expanded') !== 'true') return;
      const focusable = Array.from(
        panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')
      );
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      const active = document.activeElement as HTMLElement | null;
      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    });
  });

  // Nav scrolled state (bound once).
  if (typeof window !== 'undefined' && !(window as any).__axiomScrollBound) {
    (window as any).__axiomScrollBound = true;
    const onScroll = () => {
      const shell = document.getElementById('nav-shell');
      if (shell) shell.toggleAttribute('data-scrolled', window.scrollY > 24);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:page-load', onScroll);
  }
</script>
