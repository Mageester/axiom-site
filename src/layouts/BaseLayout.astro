---
import '../styles/site.css';
import interLatinWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Footer from '../components/site/Footer.astro';
import Header from '../components/site/Header.astro';
import {
  ORGANIZATION_SCHEMA,
  SITE_NAME,
  SITE_URL,
  WEBSITE_SCHEMA,
  breadcrumbSchema,
  formatSeoTitle,
  toCanonicalUrl,
  webPageSchema,
  type Crumb,
} from '../lib/seo';

type Schema = Record<string, unknown>;

type Props = {
  title: string;
  description: string;
  canonicalPath?: string;
  noIndex?: boolean;
  /** Schema.org WebPage subtype, e.g. AboutPage, ContactPage, CollectionPage. */
  pageType?: string;
  /** Breadcrumb trail ending at this page; drives BreadcrumbList JSON-LD. */
  crumbs?: Crumb[];
  schema?: Schema | Schema[];
  ogImageAlt?: string;
  /** Responsive LCP image to preload, e.g. the home hero screenshot. */
  preload?: { type: string; srcset: string; sizes: string; href: string };
  showCta?: boolean;
};

const {
  title,
  description,
  canonicalPath,
  noIndex = false,
  pageType,
  crumbs,
  schema,
  ogImageAlt,
  preload,
  showCta = true,
} = Astro.props as Props;

const resolvedTitle = formatSeoTitle(title);
const canonical = toCanonicalUrl(canonicalPath || Astro.url.pathname);
const socialSlug = new URL(canonical).pathname.replace(/^\/+|\/+$/g, '').replaceAll('/', '-') || 'home';
const image = `${SITE_URL}/social/${noIndex ? 'home' : socialSlug}.png`;
const imageAlt = ogImageAlt || `${resolvedTitle.split(' | ')[0]} — ${SITE_NAME}, web design in Kitchener-Waterloo`;

const extraSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const schemas = noIndex
  ? []
  : [
      ORGANIZATION_SCHEMA,
      WEBSITE_SCHEMA,
      webPageSchema({
        type: pageType,
        url: canonical,
        name: resolvedTitle,
        description,
        image,
        hasBreadcrumb: Boolean(crumbs?.length),
      }),
      ...(crumbs?.length ? [breadcrumbSchema(crumbs)] : []),
      ...extraSchemas,
    ];
const jsonLd = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{resolvedTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noIndex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'}
    />
    <link rel="canonical" href={canonical} />

    <link rel="preload" as="font" type="font/woff2" href={interLatinWoff2} crossorigin />
    {preload && (
      <link
        rel="preload"
        as="image"
        type={preload.type}
        href={preload.href}
        imagesrcset={preload.srcset}
        imagesizes={preload.sizes}
        fetchpriority="high"
      />
    )}

    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="author" content={SITE_NAME} />
    <meta name="application-name" content={SITE_NAME} />
    <meta name="geo.region" content="CA-ON" />
    <meta name="geo.placename" content="Kitchener-Waterloo" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:secure_url" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {schemas.map((s) => <script type="application/ld+json" set:html={jsonLd(s)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header showCta={showCta} />
    <slot />
    <Footer />
  </body>
</html>
