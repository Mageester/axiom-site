---
import '../styles/site.css';
import displayWoff2 from '@fontsource/instrument-sans/files/instrument-sans-latin-500-normal.woff2?url';
import Footer from '../components/site/Footer.astro';
import Header from '../components/site/Header.astro';
import {
  ORGANIZATION_SCHEMA,
  SITE_NAME,
  SITE_URL,
  WEBSITE_SCHEMA,
  breadcrumbSchema,
  formatSeoTitle,
  toCanonicalUrl,
  webPageSchema,
  type Crumb,
} from '../lib/seo';

type Schema = Record<string, unknown>;

type Props = {
  title: string;
  description: string;
  canonicalPath?: string;
  noIndex?: boolean;
  /** Schema.org WebPage subtype, e.g. AboutPage, ContactPage, CollectionPage. */
  pageType?: string;
  /** Breadcrumb trail ending at this page; drives BreadcrumbList JSON-LD. */
  crumbs?: Crumb[];
  schema?: Schema | Schema[];
  ogImageAlt?: string;
  /** Responsive LCP image to preload, e.g. the home hero poster. */
  preload?: { type: string; srcset: string; sizes: string; href: string };
  showCta?: boolean;
  /** The header starts on a dark stage (the home hero) or a white page. */
  heroTheme?: 'dark' | 'light';
};

const {
  title,
  description,
  canonicalPath,
  noIndex = false,
  pageType,
  crumbs,
  schema,
  ogImageAlt,
  preload,
  showCta = true,
  heroTheme = 'light',
} = Astro.props as Props;

const resolvedTitle = formatSeoTitle(title);
const canonical = toCanonicalUrl(canonicalPath || Astro.url.pathname);
const socialSlug = new URL(canonical).pathname.replace(/^\/+|\/+$/g, '').replaceAll('/', '-') || 'home';
const image = `${SITE_URL}/social/${noIndex ? 'home' : socialSlug}.png`;
const imageAlt = ogImageAlt || `${resolvedTitle.split(' | ')[0]} — ${SITE_NAME}, web design in Kitchener-Waterloo`;

const extraSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const schemas = noIndex
  ? []
  : [
      ORGANIZATION_SCHEMA,
      WEBSITE_SCHEMA,
      webPageSchema({
        type: pageType,
        url: canonical,
        name: resolvedTitle,
        description,
        image,
        hasBreadcrumb: Boolean(crumbs?.length),
      }),
      ...(crumbs?.length ? [breadcrumbSchema(crumbs)] : []),
      ...extraSchemas,
    ];
const jsonLd = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{resolvedTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noIndex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'}
    />
    <link rel="canonical" href={canonical} />

    <link rel="preload" as="font" type="font/woff2" href={displayWoff2} crossorigin />
    <script is:inline>
      // Entrance reveals play once, on a timer, as each element first comes into view.
      // The class that hides elements is only added when this can run, so content is
      // always visible without JavaScript or with reduced motion.
      (() => {
        const root = document.documentElement;
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        root.classList.add('reveal-ready');
        const reveal = (observer, stagger) => (entries) => {
          entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top || a.boundingClientRect.left - b.boundingClientRect.left)
            .forEach((entry, index) => {
              if (stagger) entry.target.style.setProperty('--reveal-delay', `${Math.min(index, 6) * 90}ms`);
              entry.target.classList.add('is-revealed');
              observer().unobserve(entry.target);
            });
        };
        const start = () => {
          try {
            let items, moments;
            items = new IntersectionObserver(reveal(() => items, true), { rootMargin: '0px 0px -6% 0px' });
            moments = new IntersectionObserver(reveal(() => moments, false), { rootMargin: '0px 0px -25% 0px' });
            document.querySelectorAll('.reveal, .reveal-stagger > *').forEach((el) => items.observe(el));
            document.querySelectorAll('[data-reveal]').forEach((el) => moments.observe(el));
          } catch (error) {
            root.classList.remove('reveal-ready');
          }
        };
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, { once: true });
        else start();
      })();
    </script>
    {preload && (
      <link
        rel="preload"
        as="image"
        type={preload.type}
        href={preload.href}
        imagesrcset={preload.srcset}
        imagesizes={preload.sizes}
        fetchpriority="high"
      />
    )}

    <meta name="theme-color" content={heroTheme === 'dark' ? '#07070a' : '#ffffff'} />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="author" content={SITE_NAME} />
    <meta name="application-name" content={SITE_NAME} />
    <meta name="geo.region" content="CA-ON" />
    <meta name="geo.placename" content="Kitchener-Waterloo" />

    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:secure_url" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {schemas.map((s) => <script type="application/ld+json" set:html={jsonLd(s)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header showCta={showCta} theme={heroTheme} />
    <slot />
    <Footer />
    <div class="cursor" data-cursor-dot aria-hidden="true"><span class="cursor-label"></span></div>
    <div class="preview" data-preview-box aria-hidden="true"></div>
    <script>
      import { initInteractions } from '../lib/interactions';
      initInteractions();
    </script>
  </body>
</html>
