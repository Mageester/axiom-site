---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/site/Breadcrumbs.astro';

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  ogImageAlt?: string;
  noIndex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  hidePrimaryCta?: boolean;
  showFooter?: boolean;
};

const {
  title,
  description,
  canonicalPath,
  image,
  ogImageAlt,
  noIndex = false,
  schema,
  hidePrimaryCta = false,
  showFooter = true,
} = Astro.props as Props;
const schemaList = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const breadcrumb = schemaList.find(item => item['@type'] === 'BreadcrumbList');
const items = breadcrumb
  ? (breadcrumb.itemListElement as Array<{ name: string; item: string }>).map(item => ({ name: item.name, url: new URL(item.item).pathname }))
  : [{ name: 'Home', url: '/' }, { name: (title || 'Axiom Web').split(' | ')[0], url: Astro.url.pathname }];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  image={image}
  ogImageAlt={ogImageAlt}
  noIndex={noIndex}
  schema={schema}
  hidePrimaryCta={hidePrimaryCta}
  showFooter={showFooter}
>
  {!noIndex && Astro.url.pathname !== '/' && <Breadcrumbs items={items} />}
  <slot />
</BaseLayout>
